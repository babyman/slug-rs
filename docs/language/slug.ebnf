(*
   Slug Language Grammar (EBNF)
   Derived from lexer/parser in internal/lexer and internal/parser.
*)

program = { statement_sep } , { statement , { statement_sep } } , EOF ;

(* NEWLINE acts as a separator when ASI rules say it terminates the statement. *)
statement_sep = ";" | NEWLINE ;

(* Tags can prefix var/val/foreign declarations, including exported declarations.
   Tags also appear in parameter lists. *)
statement = tag_prefixed_decl
          | documented_decl
          | export_decl
          | foreign_decl
          | return_stmt
          | throw_stmt
          | defer_stmt
          | not_implemented_stmt
          | expression_stmt
          ;

tag_prefixed_decl = tag_prefix , ( export_decl | var_expr | val_expr | foreign_decl ) ;
tag_prefix = tag , { { statement_sep } , tag } , { statement_sep } ;
documented_decl = DOC_COMMENT , { statement_sep } ,
                   ( tag_prefixed_decl | export_decl | var_expr | val_expr | foreign_decl ) ;

(* export declarations are valid only at module top level. *)
export_decl = "export" , ( var_expr | val_expr | foreign_decl ) ;

return_stmt = "return" , expression ;
throw_stmt = "throw" , expression ;
not_implemented_stmt = "???" ;

(* Defer may wrap a block, match, or expression. onerror(...) optionally binds an error name. *)
defer_stmt = "defer" , [ "onsuccess" | ( "onerror" , "(" , identifier , ")" ) ] ,
             ( block | match_expr | expression_stmt ) ;

foreign_decl = "foreign" , identifier , "=" , "fn" , [ type_parameters ] ,
               "(" , [ parameters ] , ")" , [ ":" , type_annotation ] , [ ";" ] ;

expression_stmt = expression ;

expression = assignment ;
assignment = identifier , "=" , assignment | logical_or ;

logical_or = logical_and , { "||" , logical_and } ;
logical_and = equality , { "&&" , equality } ;
equality = comparison , { ( "==" | "!=" ) , comparison } ;
comparison = bitwise_or , { ( "<" | "<=" | ">" | ">=" ) , bitwise_or } ;
bitwise_or = bitwise_xor , { "|" , bitwise_xor } ;
bitwise_xor = bitwise_and , { "^" , bitwise_and } ;
bitwise_and = shift , { "&" , shift } ;
shift = sum , { ( "<<" | ">>" ) , sum } ;
sum = product , { ( "+" | "-" ) , product } ;
product = list_concat , { ( "*" | "/" | "%" ) , list_concat } ;
(* `+:` is right-associative; `:+` remains left-associative. *)
list_concat = list_prepend , { ":+" , list_prepend } ;
list_prepend = prefix , [ "+:" , list_prepend ] ;

prefix = ( "!" | "-" | "~" ) , prefix
       | call_chain
       ;

call_chain = postfix , { "/>" , postfix } ;

postfix = primary , { postfix_op } ;
postfix_op = call_suffix | type_application_call | index_suffix | dot_suffix | struct_init | struct_copy ;
call_suffix = "(" , [ call_args ] , ")" ;
(* Type application is accepted only on an identifier. *)
type_application_call = "<" , type_annotation , { "," , type_annotation } , ">" , call_suffix ;
index_suffix = "[" , index_args , "]" ;
dot_suffix = "." , identifier ;

(* Struct construction and persistent copy are postfix forms. *)
struct_init = "{" , [ struct_init_fields ] , "}" ;
struct_copy = "copy" , "{" , [ struct_init_fields ] , "}" ;

primary = literal
        | identifier
        | grouped
        | if_expr
        | match_expr
        | select_expr
        | function_literal
        | list_literal
        | map_literal
        | struct_schema
        | block
        | recur_expr
        | nursery_expr
        | spawn_expr
        | var_expr
        | val_expr
        ;

var_expr = "var" , var_pattern , [ ":" , type_annotation ] , "=" , expression ;
val_expr = "val" , val_pattern , [ ":" , type_annotation ] , "=" , expression ;
(* A declaration type annotation is permitted only when its pattern is an identifier. *)
var_pattern = match_pattern ;
val_pattern = match_pattern ;

recur_expr = "recur" , "(" , [ call_args ] , ")" ;

nursery_expr = "nursery" , [ "limit" , expression ] , ( function_literal | block ) ;

spawn_expr = "spawn" , ( block | prefix ) ;

select_expr = "select" , "{" , [ select_case , { case_sep , select_case } ] , "}" ;
select_case = select_header , [ "/>" , expression ] ;
select_header = "recv" , expression
              | "send" , expression , "," , expression
              | "after" , expression
              | "await" , expression
              | "_"
              ;

grouped = "(" , expression , ")" ;

if_expr = "if" , "(" , expression , ")" , block ,
          [ "else" , ( block | if_expr ) ] ;

function_literal = "fn" , [ type_parameters ] , "(" , [ parameters ] , ")" ,
                   [ ":" , type_annotation ] , ( block | match_body ) ;
match_body = "match" , "{" , [ match_case , { case_sep , match_case } ] , "}" ;

(* Variadic parameters use "..." and must be last. *)
type_parameters = "<" , identifier , { "," , identifier } , ">" ;
parameters = parameter , { "," , parameter } ;
parameter = { tag } , [ "..." ] , parameter_name , [ ":" , type_annotation ] ,
            [ "=" , expression ] ;
parameter_name = identifier | "_" ;
tag = "@" , identifier , [ "(" , [ expression_list ] , ")" ] ;

call_args = call_arg , { "," , call_arg } , [ "," ] ;
call_arg = spread_expr | named_arg | expression ;
spread_expr = "..." , expression ;
named_arg = identifier , "=" , expression ;

list_literal = "[" , [ expression_list ] , "]" ;
expression_list = expression_item , { "," , expression_item } , [ "," ] ;
expression_item = [ "..." ] , expression ;

index_args = expression
           | [ expression ] , ":" , [ expression ] , [ ":" , [ expression ] ]
           ;
(* In a slice, an omitted start defaults to zero. *)

map_literal = "{" , [ map_entries ] , "}" ;
map_entries = map_entry , { "," , map_entry } , [ "," ] ;
map_entry = map_key , ":" , expression ;
(* Bare identifiers and quoted strings denote string keys unless bracketed. *)
map_key = identifier | string | "[" , expression , "]" ;

struct_schema = "struct" , "{" , [ struct_schema_fields ] , "}" ;
struct_schema_fields = struct_schema_field , { "," , struct_schema_field } , [ "," ] ;
(* Struct-field tags are not supported. *)
struct_schema_field = identifier , [ ":" , type_annotation ] , [ "=" , expression ] ;

struct_init_fields = struct_init_field , { "," , struct_init_field } , [ "," ] ;
struct_init_field = identifier , ":" , expression ;

match_expr = "match" , [ expression ] , "{" , [ match_case , { case_sep , match_case } ] , "}" ;
(* A map-literal subject must be grouped: `match ({name: value}) { ... }`. *)
case_sep = statement_sep , { statement_sep } ;

match_case = case_pattern_list , [ "if" , expression ] , "=>" , ( block | statement ) ;

(* Multi-pattern alternatives must be non-binding (see parser restrictions). *)
case_pattern_list = case_pattern
                  | case_pattern , "," , case_pattern , { "," , case_pattern }
                   ;

(* A type constraint applies to the complete case pattern, not to declarations
   or nested patterns. *)
case_pattern = match_pattern , [ ":" , type_annotation ] ;

match_pattern = "_"
              | binding_pattern
              | spread_pattern
              | pinned_identifier
              | list_pattern
              | map_pattern
              | literal
              | identifier
              ;

(* The identifier binds the whole value before bindings from the nested pattern. *)
binding_pattern = identifier , "@" , match_pattern ;
(* An omitted spread identifier discards the remainder. *)
spread_pattern = "..." , [ identifier ] ;
pinned_identifier = "^" , identifier ;

(* Spread patterns must be final in list patterns. *)
list_pattern = "[" , [ match_pattern , { "," , match_pattern } ] , "]" ;

map_pattern = "{" , [ map_pattern_body ] , "}"
            | "{|" , [ map_pattern_body ] , "|}"
            ;

(* `{}` matches only an empty map. `{*}` is a top-level declaration-only
   selector; exact non-empty map patterns ("{| ... |}") disallow both it and
   spread entries. *)
map_pattern_body = "*" | map_pattern_entry , { "," , map_pattern_entry } , [ "," ] ;
map_pattern_entry = spread_pattern
                  | ( identifier | string ) , ":" , match_pattern
                  | identifier
                  | "[" , expression , "]" , ":" , match_pattern
                  ;
(* Bare identifiers and static string keys denote strings; quoted and computed
   keys require a value pattern. *)

block = "{" , { statement_sep } , { statement , { statement_sep } } , "}" ;
(* In expression position, braces are classified structurally: map-entry shapes
   are map literals; all other shapes are blocks. *)

literal = number | string | bytes | boolean | nil ;
boolean = "true" | "false" ;
nil = "nil" ;

(* Type annotations are parsed as type text. These are the supported structural forms. *)
type_annotation = type_term , { "|" , type_term } ;
type_term = type_constructor , [ "<" , type_annotation , { "," , type_annotation } , ">" ] ;
type_constructor = identifier | "fn" | "[" , [ type_annotation , { "," , type_annotation } ] , "]" ;

(* Lexical forms (simplified): *)
(* Reserved keywords, including export, cannot be identifiers or tag names. *)
identifier = ident_start , { ident_start | digit } ;
ident_start = "_" | UNICODE_LETTER | UNICODE_MARK ;
digit = UNICODE_DIGIT ;

number = decimal | hex ;
decimal = DIGIT , { DIGIT | "_" } ,
          [ "." , DIGIT , { DIGIT | "_" } ] ,
          [ ( "e" | "E" ) , [ "+" | "-" ] , DIGIT , { DIGIT } ] ;
hex = "0" , "x" , [ "_" ] , HEXDIGIT , { HEXDIGIT | "_" } ;

bytes = "0x" , '"' , [ HEXDIGIT , { HEXDIGIT } ] , '"' ;

string = double_string | raw_string | triple_string | triple_raw_string | interpolated_string ;

(* Interpolation uses $identifier in non-raw strings. *)
interpolated_string = string_segment , { "$" , identifier , string_segment } ;
string_segment = double_string | triple_string ;

double_string = '"' , { string_char } , '"' ;
raw_string = "'" , { raw_char } , "'" ;
triple_string = '"""' , { string_char } , '"""' ;
triple_raw_string = "'''" , { raw_char } , "'''" ;

(* Escapes: \n \r \t \\ \" \$ and octal (0-7 up to 3 digits). Raw strings have no escapes. *)
string_char = ANY_CHAR_EXCEPT_QUOTE_OR_BACKSLASH | escape_seq ;
raw_char = ANY_CHAR_EXCEPT_SINGLE_QUOTE ;

escape_seq = "\\" , ( "n" | "r" | "t" | "\\" | '"' | "{" | octal ) ;
octal = oct_digit , [ oct_digit ] , [ oct_digit ] ;
oct_digit = "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7" ;

(* NEWLINE tokens are emitted outside ()/[]; comments can be:
   # line comment, // line comment, /* block comment */, or /** doc comment */.
*)
