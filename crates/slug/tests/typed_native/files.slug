export resource File

export foreign openRead = fn(path:str):File|nil
export foreign openWrite = fn(path:str):File|nil
export foreign readLine = fn(file:File):list
export foreign write = fn(file:File, text:str):num
export foreign close = fn(file:File):nil
export foreign add = fn(left:num, right:num):num
export foreign negate = fn(value:num):num
export foreign describe = fn(value:num):str
export foreign label = fn(value:num):str
export foreign labelOrNil = fn(value:num):str|nil
