val flip = fn(values, count) {
    val take = fn(remaining, needed, prefix) {
        if (needed == 0) { [prefix, remaining] } else {
            match remaining {
                [head, ...tail] => recur(tail, needed - 1, prefix :+ head)
            }
        }
    }
    val reverse = fn(remaining, result) match {
        [] => result
        [head, ...tail] => recur(tail, head +: result)
    }
    val parts = take(values, count, [])
    reverse(parts[0], []) + parts[1]
}

val flipCount = fn(values, total) {
    if (values[0] == 1) { total } else { recur(flip(values, values[0]), total + 1) }
}

val generate = fn(choices, prefix, checksum, maximum, sign) {
    if (len(choices) == 0) {
        val flips = flipCount(prefix, 0)
        [checksum + sign * flips, if (flips > maximum) { flips } else { maximum }, -sign]
    } else {
        val visit = fn(remaining, rotations, state) {
            if (rotations == 0) { state } else {
                match remaining {
                    [head, ...tail] => {
                        val next = generate(tail, prefix :+ head, state[0], state[1], state[2])
                        recur(tail :+ head, rotations - 1, next)
                    }
                }
            }
        }
        visit(choices, len(choices), [checksum, maximum, sign])
    }
}

val main = fn() {
    val result = generate([1, 2, 3, 4, 5], [], 0, 0, 1)
    println(result[0], result[1])
}
