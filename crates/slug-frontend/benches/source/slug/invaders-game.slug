val FRAMES = 7300

// FNV-1a over the video RAM, 32-bit.
val checksum = fn(screen:bytes):num {
    val go = fn(i:num, hash:num):num {
        if (i == len(screen)) { hash } else { recur(i + 1, ((hash ^ screen[i]) * 16777619) & 0xFFFFFFFF) }
    }
    go(0, 2166136261)
}

val main = fn() {
    game.powerOn()
    val run = fn(frame:num, next:num, keys:num, sounds:num, screen:bytes) {
        if (frame == FRAMES) { return [sounds, screen] }
        val due = next < len(EVENTS) && (EVENTS[next] << 8 | EVENTS[next + 1]) <= frame
        val held = if (due) { EVENTS[next + 2] } else { keys }
        val shown = game.tick((held & 1) != 0, (held & 2) != 0, (held & 4) != 0, (held & 8) != 0)
        val ports = game.ports()
        recur(frame + 1, if (due) { next + 3 } else { next }, held, sounds + ports[0] + ports[1], shown)
    }
    val [sounds, screen] = run(0, 0, 0, 0, 0x"")
    val {score, ships, rack} = game.state()
    val sum = checksum(screen)
    println("$score $ships $rack $sounds $sum")
}
