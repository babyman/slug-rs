val gpio = import("slug.gpio")
val time = import("slug.time")

// PinPulse shield LEDs follow the physical pin order around the board.
val pins = [
    4, 5, 6, 7, 15, 16, 17, 18, 8, 3, 46, 9, 10, 11, 12, 13, 14,
    1, 2, 42, 41, 40, 39, 38, 0, 45, 48, 47, 21,
]
val pin_count = 29

// phase 0 initializes all outputs low, 1 chases one LED, 2 lights the lap,
// and 3 clears the lap. `recur` keeps this forever-running program in one VM
// frame while the host retains each claimed GPIO output.
val chase = fn(index, phase) {
    if (phase == 0) {
        if (index == pin_count) {
            time.sleepMs(1000)
            recur(0, 1)
        } else {
            gpio.write(pins[index], false)
            recur(index + 1, 0)
        }
    } else {
        if (phase == 1) {
            if (index == pin_count) {
                recur(0, 2)
            } else {
                gpio.write(pins[index], true)
                time.sleepMs(80)
                gpio.write(pins[index], false)
                recur(index + 1, 1)
            }
        } else {
            if (phase == 2) {
                if (index == pin_count) {
                    time.sleepMs(600)
                    recur(0, 3)
                } else {
                    gpio.write(pins[index], true)
                    recur(index + 1, 2)
                }
            } else {
                if (index == pin_count) {
                    time.sleepMs(300)
                    recur(0, 1)
                } else {
                    gpio.write(pins[index], false)
                    recur(index + 1, 3)
                }
            }
        }
    }
}

val main = fn() {
    chase(0, 0)
}
