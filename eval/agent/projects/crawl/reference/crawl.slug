/**
 * Crawl: runs the game in game.slug on slug.arcade.
 *
 * Options: `--seed N` (default 1) starts a new game with that seed, or
 * `--load file` continues the game in a snapshot; `--dump file` writes the
 * game's snapshot when the run ends. `--screen file`, not in the spec, also
 * writes the final screen's text, for tools/compare_references.py.
 */
val arcade = import("slug.arcade")
val json = import("slug.fmt.json")
val fs = import("slug.io.fs")
val game = import("game")
val screen = import("screen")

// Command keys in priority order: the first one pressed in a frame is that
// frame's command.
val KEYS = [
    "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t",
    "u", "v", "w", "x", "y", "z", "left", "down", "up", "right", "space", "enter",
]

val pressedKey = fn(i:num):str|nil {
    if (i == len(KEYS)) {
        nil
    } else if (arcade.pressed(KEYS[i])) {
        KEYS[i]
    } else {
        recur(i + 1)
    }
}

val main = fn() {
    val load = cfg("load", "")
    if (load == "") {
        game.newGame(cfg("seed", 1))
    } else {
        val file = fs.openRead(load)
        val read = fn(acc:str):str {
            match fs.readLine(file) {
                line: str => recur(acc + line + "\n")
                _ => acc
            }
        }
        val text = read("")
        fs.close(file)
        game.load(json.parse(text))
    }
    arcade.open("Crawl", screen.WIDTH, screen.HEIGHT, {scale: 2})
    arcade.overlay(0, 0, screen.WIDTH, 10, 0xffff60)
    arcade.overlay(0, 230, screen.WIDTH, 10, 0x60ff60)
    val loop = fn(frame:bytes) {
        val key = pressedKey(0)
        val next = if (key == nil) {
            frame
        } else {
            game.command(key, arcade.down("shift"))
            screen.render(game.text())
        }
        arcade.present(next)
        if (arcade.frame()) { recur(next) }
    }
    loop(screen.render(game.text()))
    arcade.close()
    val save = fn(path:str, value) {
        if (path != "") {
            val file = fs.openWrite(path)
            fs.write(file, json.stringify(value) + "\n")
            fs.close(file)
        }
    }
    save(cfg("dump", ""), game.snapshot())
    save(cfg("screen", ""), game.text())
}
