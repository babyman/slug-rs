/**
 * Crawl: runs the game in game.slug on slug.arcade.
 *
 * Options: `--seed N` (default 1) starts a new game with that seed, and
 * `--dump file` writes the game's state as JSON when the run ends.
 */
val arcade = import("slug.arcade")
val json = import("slug.fmt.json")
val fs = import("slug.io.fs")
val rng = import("rng")
val game = import("game")
val screen = import("screen")

// Command keys in priority order: the first one pressed in a frame is that
// frame's command. Arrow keys are the same as h, j, k, and l.
val KEYS = [
    ["h", "h"], ["j", "j"], ["k", "k"], ["l", "l"], ["y", "y"], ["u", "u"], ["b", "b"], ["n", "n"],
    ["left", "h"], ["down", "j"], ["up", "k"], ["right", "l"], ["space", "space"], ["enter", "enter"],
]

val pressedKey = fn(i:num):str|nil {
    if (i == len(KEYS)) {
        nil
    } else if (arcade.pressed(KEYS[i][0])) {
        KEYS[i][1]
    } else {
        recur(i + 1)
    }
}

val main = fn() {
    game.newGame(cfg("seed", 1))
    arcade.open("Crawl", screen.WIDTH, screen.HEIGHT, {scale: 2})
    arcade.overlay(0, 0, screen.WIDTH, 10, 0xffff60)
    arcade.overlay(0, 230, screen.WIDTH, 10, 0x60ff60)
    val loop = fn(frame:bytes) {
        val key = pressedKey(0)
        val next = if (key == nil) {
            frame
        } else {
            game.command(key, arcade.down("shift"))
            screen.render(game.text())
        }
        arcade.present(next)
        if (arcade.frame()) { recur(next) }
    }
    loop(screen.render(game.text()))
    arcade.close()
    val dump = cfg("dump", "")
    if (dump != "") {
        val file = fs.openWrite(dump)
        fs.write(file, json.stringify(game.current() + {rng: rng.getState(), text: game.text()}) + "\n")
        fs.close(file)
    }
}
