/**
 * Crawl. For now: starts a game from `--seed`, takes the stairs down to
 * `--depth`, and shows the whole level, for checking level generation.
 * `--dump file` writes the level as JSON.
 */
val arcade = import("slug.arcade")
val json = import("slug.fmt.json")
val fs = import("slug.io.fs")
val data = import("data")
val rng = import("rng")
val level = import("level")
val screen = import("screen")

val GLYPHS = {gold: "*", potion: "!", scroll: "?", food: ":", weapon: ")", armour: "]", orb: ","}

val put = fn(rows:list, x:num, y:num, c:str):list {
    val row = rows[y]
    rows[:y] + [row[:x] + c + row[x + 1:]] + rows[y + 1:]
}

// The whole level, as if every square were seen.
val reveal = fn(lv:map):list {
    val items = fn(i:num, rows:list):list {
        if (i == len(lv.items)) {
            rows
        } else {
            val it = lv.items[i]
            recur(i + 1, put(rows, it.x, it.y, GLYPHS[it.item.kind]))
        }
    }
    val monsters = fn(i:num, rows:list):list {
        if (i == len(lv.monsters)) {
            rows
        } else {
            val m = lv.monsters[i]
            recur(i + 1, put(rows, m.x, m.y, data.monsters[m.kind].letter))
        }
    }
    put(monsters(0, items(0, lv.map)), lv.player.x, lv.player.y, "@")
}

val main = fn() {
    val seed = cfg("seed", 1)
    val depth = cfg("depth", 1)
    rng.seed(seed)
    val colours = rng.shuffle(data.colours)
    val titles = rng.shuffle(data.titles)
    val descend = fn(d:num):map {
        val lv = level.generate(d)
        if (d == depth) { lv } else { recur(d + 1) }
    }
    val lv = descend(1)
    val dump = cfg("dump", "")
    if (dump != "") {
        val file = fs.openWrite(dump)
        fs.write(file, json.stringify(lv + {colours: colours, titles: titles, rng: rng.getState()}) + "\n")
        fs.close(file)
    }
    val text = ["seed $seed  depth $depth"] + reveal(lv) + ["potions: " + colours[:6] + "  scrolls: " + titles[:5]]
    arcade.open("Crawl", screen.WIDTH, screen.HEIGHT, {scale: 2})
    arcade.overlay(0, 0, screen.WIDTH, 10, 0xffff60)
    arcade.overlay(0, 230, screen.WIDTH, 10, 0x60ff60)
    val frame = screen.render(text)
    val loop = fn() {
        arcade.present(frame)
        if (arcade.frame()) { recur() }
    }
    loop()
    arcade.close()
}
