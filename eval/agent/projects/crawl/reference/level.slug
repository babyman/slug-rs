/**
 * Level generation: nine rooms in a 3x3 grid of cells, some of them gone,
 * joined by corridors, then items, stairs, and the player's position. Every
 * random draw happens in the order the spec lists.
 */
val data = import("data")
val rng = import("rng")
val math = import("slug.math")

export val WIDTH = 80
export val HEIGHT = 22
export val DEEPEST = 8
val CELL_W = 26
val CELL_H = 7
val CELLS = 9

// Terrain characters.
export val BLANK = " "
export val FLOOR = "."
export val CORRIDOR = "#"
export val DOOR = "+"
export val HWALL = "-"
export val VWALL = "|"
export val STAIRS = "%"

val contains = fn(xs:list, v):bool {
    val go = fn(i:num):bool {
        if (i == len(xs)) { false } else if (xs[i] == v) { true } else { recur(i + 1) }
    }
    go(0)
}

// Writes `text` into row y of `rows` starting at column x.
val write = fn(rows:list, x:num, y:num, text:str):list {
    val row = rows[y]
    rows[:y] + [row[:x] + text + row[x + len(text):]] + rows[y + 1:]
}

val adjacent = fn(a:num, b:num):bool {
    val sameRow = math.div(a, 3) == math.div(b, 3)
    val sameCol = a % 3 == b % 3
    (sameRow && (a - b == 1 || b - a == 1)) || (sameCol && (a - b == 3 || b - a == 3))
}

/**
 * A new item of a random kind: the kind by weight, then its type by weight,
 * then for weapons and armour one draw for the bonus.
 */
export val newItem = fn():map {
    val kind = data.itemKinds[rng.pick(data.itemKinds)].kind
    val bonus = fn():num {
        val b = rng.below(100)
        if (b < 10) { -1 } else if (b < 25) { 1 } else { 0 }
    }
    match kind {
        "potion" => {kind: "potion", type: rng.pick(data.potions)}
        "scroll" => {kind: "scroll", type: rng.pick(data.scrolls)}
        "food" => {kind: "food"}
        "weapon" => {
            val type = rng.pick(data.weapons)
            {kind: "weapon", type: type, bonus: bonus()}
        }
        _ => {
            val type = rng.pick(data.armours)
            {kind: "armour", type: type, bonus: bonus()}
        }
    }
}

/**
 * Generates the level at `depth` (1 to DEEPEST). The result has `map` (HEIGHT
 * strings of WIDTH terrain characters), `rooms` (one per cell, in cell
 * order), `items` and `monsters` (in creation order), and `player`.
 */
export val generate = fn(depth:num):map {
    var rows = []
    val blank = fn(i:num) {
        if (i < HEIGHT) {
            rows = rows :+ (BLANK * WIDTH)
            recur(i + 1)
        }
    }
    blank(0)
    var items = []
    var monsters = []
    var rooms = []

    val at = fn(x:num, y:num):str { rows[y][x] }
    val occupied = fn(list:list, x:num, y:num):bool {
        val go = fn(i:num):bool {
            if (i == len(list)) {
                false
            } else if (list[i].x == x && list[i].y == y) {
                true
            } else {
                recur(i + 1)
            }
        }
        go(0)
    }
    val free = fn(x:num, y:num):bool {
        at(x, y) == FLOOR && !occupied(items, x, y) && !occupied(monsters, x, y)
    }
    // A free floor spot inside `room`: draw x then y until the spot is free.
    val spotIn = fn(room:map):map {
        val x = room.x + 1 + rng.below(room.w - 2)
        val y = room.y + 1 + rng.below(room.h - 2)
        if (free(x, y)) { {x: x, y: y} } else { recur(room) }
    }
    // A free floor spot in any room: draw a cell until it is not gone, then
    // a spot in it; if the spot is not free, start again from the cell.
    val anySpot = fn():map {
        val room = rooms[rng.below(CELLS)]
        if (room.gone) {
            recur()
        } else {
            val x = room.x + 1 + rng.below(room.w - 2)
            val y = room.y + 1 + rng.below(room.h - 2)
            if (free(x, y)) { {x: x, y: y} } else { recur() }
        }
    }

    // 1. Gone cells: below(4) of them, each drawn until not already gone.
    val chooseGone = fn(n:num, gone:list):list {
        if (n == 0) {
            gone
        } else {
            val c = rng.below(CELLS)
            if (contains(gone, c)) { recur(n, gone) } else { recur(n - 1, gone :+ c) }
        }
    }
    val gone = chooseGone(rng.below(4), [])

    // 2. Rooms, cell by cell, each with its gold and monster.
    val candidates = fn(i:num, acc:list):list {
        if (i == len(data.monsters)) {
            acc
        } else {
            val m = data.monsters[i]
            recur(i + 1, if (m.depths[0] <= depth && depth <= m.depths[1]) { acc :+ i } else { acc })
        }
    }
    val kinds = candidates(0, [])
    val makeRoom = fn(cell:num) {
        val left = (cell % 3) * CELL_W
        val top = math.div(cell, 3) * CELL_H
        if (contains(gone, cell)) {
            val x = left + 1 + rng.below(CELL_W - 3)
            val y = top + 1 + rng.below(CELL_H - 3)
            rooms = rooms :+ {x: x, y: y, w: 1, h: 1, gone: true, dark: false}
        } else {
            val dark = rng.below(10) < depth - 1
            val w = 4 + rng.below(CELL_W - 4)
            val h = 4 + rng.below(CELL_H - 4)
            val x = left + rng.below(CELL_W - w)
            val y = top + rng.below(CELL_H - h)
            val room = {x: x, y: y, w: w, h: h, gone: false, dark: dark}
            rooms = rooms :+ room
            rows = write(rows, x, y, HWALL * w)
            rows = write(rows, x, y + h - 1, HWALL * w)
            val sides = fn(r:num) {
                if (r < y + h - 1) {
                    rows = write(rows, x, r, VWALL + FLOOR * (w - 2) + VWALL)
                    recur(r + 1)
                }
            }
            sides(y + 1)
            val gold = rng.below(2) == 0
            if (gold) {
                val amount = rng.below(50 + 10 * depth) + 2
                val spot = spotIn(room)
                items = items :+ {x: spot.x, y: spot.y, item: {kind: "gold", amount: amount}}
            }
            if (rng.below(100) < (if (gold) { 80 } else { 25 })) {
                val spot = spotIn(room)
                val kind = kinds[rng.below(len(kinds))]
                val hp = rng.roll(data.monsters[kind].level, 8)
                monsters = monsters :+ {x: spot.x, y: spot.y, kind: kind, hp: hp, maxHp: hp, state: "asleep"}
            }
        }
    }
    val eachCell = fn(cell:num) {
        if (cell < CELLS) {
            makeRoom(cell)
            recur(cell + 1)
        }
    }
    eachCell(0)

    // 3. Corridors.
    val dig = fn(x:num, y:num) {
        if (at(x, y) == BLANK) { rows = write(rows, x, y, CORRIDOR) }
    }
    // A door on a room's wall, or a gone cell's point, which becomes corridor.
    val door = fn(room:map, x:num, y:num):map {
        rows = write(rows, x, y, if (room.gone) { CORRIDOR } else { DOOR })
        {x: x, y: y}
    }
    // Joins cell a to cell b = a + 1 (side by side) or a + 3 (one above the
    // other). Draws: a's door, b's door, then the turn.
    val connect = fn(a:num, b:num) {
        val from = rooms[a]
        val to = rooms[b]
        if (b == a + 1) {
            val s = if (from.gone) { from } else { {x: from.x + from.w - 1, y: from.y + 1 + rng.below(from.h - 2)} }
            val e = if (to.gone) { to } else { {x: to.x, y: to.y + 1 + rng.below(to.h - 2)} }
            door(from, s.x, s.y)
            door(to, e.x, e.y)
            val turn = s.x + 1 + rng.below(e.x - s.x - 1)
            val first = fn(x:num) { if (x <= turn) { dig(x, s.y); recur(x + 1) } }
            first(s.x + 1)
            val step = if (e.y > s.y) { 1 } else { -1 }
            val across = fn(y:num) { if (y != e.y) { dig(turn, y + step); recur(y + step) } }
            across(s.y)
            val last = fn(x:num) { if (x < e.x) { dig(x, e.y); recur(x + 1) } }
            last(turn + 1)
        } else {
            val s = if (from.gone) { from } else { {x: from.x + 1 + rng.below(from.w - 2), y: from.y + from.h - 1} }
            val e = if (to.gone) { to } else { {x: to.x + 1 + rng.below(to.w - 2), y: to.y} }
            door(from, s.x, s.y)
            door(to, e.x, e.y)
            val turn = s.y + 1 + rng.below(e.y - s.y - 1)
            val first = fn(y:num) { if (y <= turn) { dig(s.x, y); recur(y + 1) } }
            first(s.y + 1)
            val step = if (e.x > s.x) { 1 } else { -1 }
            val across = fn(x:num) { if (x != e.x) { dig(x + step, turn); recur(x + step) } }
            across(s.x)
            val last = fn(y:num) { if (y < e.y) { dig(e.x, y); recur(y + 1) } }
            last(turn + 1)
        }
    }
    var joined = []
    val join = fn(a:num, b:num) {
        if (a < b) { connect(a, b) } else { connect(b, a) }
        joined = joined :+ [a, b] :+ [b, a]
    }
    // Reservoir choice among the cells adjacent to r that pass `ok`, in cell
    // order: the j-th such cell replaces the choice when below(j) is 0.
    // Returns [count, choice].
    val choose = fn(r:num, ok:fn):list {
        val go = fn(i:num, j:num, choice:num):list {
            if (i == CELLS) {
                [j, choice]
            } else if (adjacent(r, i) && ok(i)) {
                val k = j + 1
                recur(i + 1, k, if (rng.below(k) == 0) { i } else { choice })
            } else {
                recur(i + 1, j, choice)
            }
        }
        go(0, 0, -1)
    }
    // A spanning tree: from r, join a random adjacent cell not yet in the
    // graph; when r has none, draw cells until one in the graph.
    val span = fn(r:num, graph:list) {
        if (len(graph) < CELLS) {
            match choose(r, fn(i:num):bool { !contains(graph, i) }) {
                [0, _] => {
                    val pick = fn():num {
                        val c = rng.below(CELLS)
                        if (contains(graph, c)) { c } else { recur() }
                    }
                    recur(pick(), graph)
                }
                [_, other] => {
                    join(r, other)
                    recur(r, graph :+ other)
                }
            }
        }
    }
    val start = rng.below(CELLS)
    span(start, [start])
    // Extra corridors: below(5) times, from a random cell to a random
    // adjacent cell it is not yet joined to, if any.
    val extra = fn(n:num) {
        if (n > 0) {
            val r = rng.below(CELLS)
            match choose(r, fn(i:num):bool { !contains(joined, [r, i]) }) {
                [0, _] => nil
                [_, other] => join(r, other)
            }
            recur(n - 1)
        }
    }
    extra(rng.below(5))

    // 4. Items: nine tries, each making an item with chance 36 in 100.
    val things = fn(n:num) {
        if (n < 9) {
            if (rng.below(100) < 36) {
                val item = newItem()
                val spot = anySpot()
                items = items :+ {x: spot.x, y: spot.y, item: item}
            }
            recur(n + 1)
        }
    }
    things(0)
    if (depth == DEEPEST) {
        val spot = anySpot()
        items = items :+ {x: spot.x, y: spot.y, item: {kind: "orb"}}
    }

    // 5. Stairs, then the player.
    val stairs = anySpot()
    rows = write(rows, stairs.x, stairs.y, STAIRS)
    val player = anySpot()

    {map: rows, rooms: rooms, items: items, monsters: monsters, player: player}
}
