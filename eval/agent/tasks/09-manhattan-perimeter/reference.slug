val Point = struct { x, y }
val coordinates = cfg("points", [[0, 0], [4, 0], [4, 3], [0, 3]])
val points = fn(i, out) {
  if (i == len(coordinates)) { out } else { recur(i + 1, out :+ Point { x: coordinates[i][0], y: coordinates[i][1] }) }
}
val abs = fn(n) { if (n < 0) { -n } else { n } }
val distance = fn(a, b) { abs(a.x - b.x) + abs(a.y - b.y) }
val perimeter = fn(ps, i, total) {
  if (i == len(ps)) { total } else { recur(ps, i + 1, total + distance(ps[i], ps[(i + 1) % len(ps)])) }
}
println(perimeter(points(0, []), 0, 0))
