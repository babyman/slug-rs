/**
 * slug.builtin — the implicit host-provided foundation module.
 *
 * Registered host bindings are implicit even when this file is absent. When
 * present, this module documents those bindings and exports Slug-defined
 * foundation values. Programs may also import it explicitly.
 *
 * The runtime also provides cfg(key, default) to read immutable configuration.
 * `cfg` and `stacktrace(error)` are VM builtins rather than registered host
 * functions. `stacktrace` is valid only from an active error handler.
 */

/**
 * Standard error payload shape for idiomatic error handling.
 */
export val Error = struct {
	type:str = "Error",
	msg:str,
	code = nil,
	data = nil,
	cause = nil,
}

/**
 * Writes and flushes values to standard output, separated by spaces, without a
 * trailing newline.
 */
export foreign print = fn(...values):nil

/**
 * Writes and flushes values to standard output, separated by spaces and
 * terminated by a newline.
 */
export foreign println = fn(...values):nil

/**
 * Returns the number of Unicode scalar values in a string, bytes in a byte
 * string, or elements in a list or map.
 */
export foreign len = fn(value:str|bytes|list|map):num

/**
 * Creates a channel with an optional non-negative buffer capacity.
 *
 * A zero-capacity channel rendezvouses senders and receivers; a positive
 * capacity queues that many values before a sender blocks. `chan<T>()`
 * constructs a channel whose values conform to `T`.
 */
export foreign chan = fn<T>(capacity:num = 0):chan<T>

/**
 * Closes a channel. Closing is idempotent; receivers return `nil` after any
 * buffered values drain, and later sends fail.
 */
export foreign close = fn<T>(channel:chan<T>):nil
