val bytes = import("slug.bytes")
val {assertEqual, assertThrows} = import("slug.test")
val {toBytes} = import("slug.string")

// The thrown error's type and message.
val failure = fn(work:fn):list {
    val error = assertThrows(work)
    [error.type, error.msg]
}

@test
val fromOutsideTheBytesIsARangeError = fn() {
    val message = "requires from between 0 and the length of the bytes"
    assertEqual(failure(fn() { bytes.find(0x"6162", 0x"61", -1) }), ["bytes.range", "find " + message])
    assertEqual(failure(fn() { bytes.find(0x"6162", 0x"61", 3) }), ["bytes.range", "find " + message])
    assertEqual(failure(fn() { bytes.findAny(0x"6162", 0x"61", 3) }), ["bytes.range", "findAny " + message])
}

@test
val findWalksEveryOccurrence = fn() {
    val data = toBytes("a, b, c")
    val needle = toBytes(", ")
    val all = fn(from:num, found:list):list {
        match bytes.find(data, needle, from) {
            at: num => recur(at + 2, found :+ at)
            _ => found
        }
    }
    assertEqual(all(0, []), [1, 4])
}

@test
val findAnyFindsEveryByteOfTheSet = fn() {
    // Each byte of the set is found, the lowest and highest values included.
    assertEqual(bytes.findAny(0x"410042", 0x"00"), 1)
    assertEqual(bytes.findAny(0x"4142ff", 0x"ff00"), 2)
    assertEqual(bytes.findAny(toBytes("é!"), 0x"21"), 2)
}

@test
val hexRoundTripsEveryByte = fn() {
    val every = bytes.fromHex("")
    assertEqual(len(every), 256)
    assertEqual(every[0], 0)
    assertEqual(every[171], 171)
    assertEqual(every[255], 255)
    assertEqual(bytes.fromHex(bytes.toHex(every)), every)
    assertEqual(bytes.fromHex("DEADbeef"), 0x"deadbeef")
}

@test
val hexOfLargeDataGrowsTheBuffer = fn() {
    val double = fn(data:bytes, n:num):bytes { if (n == 0) { data } else { recur(data + data, n - 1) } }
    val data = double(0x"0f1e2d3c4b5a6978", 14)
    val text = bytes.toHex(data)
    assertEqual(len(text), len(data) * 2)
    assertEqual(text[0:16], "0f1e2d3c4b5a6978")
    assertEqual(bytes.fromHex(text), data)
    // A small call after a large one reuses the buffer.
    assertEqual(bytes.toHex(0x"ab"), "ab")
}

@test
val badHexIsAHexError = fn() {
    val notDigit = "fromHex found a character that is not a hexadecimal digit at byte "
    assertEqual(failure(fn() { bytes.fromHex("abc") }), ["bytes.hex", "fromHex needs two digits a byte, not an odd number"])
    assertEqual(failure(fn() { bytes.fromHex("0x00") }), ["bytes.hex", notDigit + "1"])
    assertEqual(failure(fn() { bytes.fromHex("00 11") }), ["bytes.hex", notDigit + "2"])
    assertEqual(failure(fn() { bytes.fromHex("00g") }), ["bytes.hex", notDigit + "2"])
    // A bad digit is named even when the count is also odd.
    assertEqual(failure(fn() { bytes.fromHex("abcdefz") }), ["bytes.hex", notDigit + "6"])
}
