    // number-subnormal-rounding
    ["2.4703282292062328e-324"], 5e-324,
    // number-huge-integer
    ["123456789012345678901234567890"], 1.2345678901234568e+29,
    // number-small-many-digits
    ["0.000001234567890123456789"], 1.2345678901234567e-06,
    // number-tie-to-even
    ["1.00000000000000011102230246251565404236316680908203125"], 1.0,
    // number-just-above-tie
    ["1.00000000000000011102230246251565404236316680908203126"], 1.0000000000000002,
    // number-exact-large-integer
    ["9007199254740993"], 9007199254740993,
    // number-exponent-integer
    ["7.2057594037927933e16"], 72057594037927933,
    // number-smallest-integer
    ["-9223372036854775808"], -9223372036854775807 - 1,
    // number-beyond-integer
    ["9223372036854775808"], 9.223372036854776e+18,
    // number-underflow
    ["1e-400"], 0
)
val parses = fn(text:str) { json.parse(text) }

// Where parsing `text` fails.
val failsAt = fn(text:str):num {
    assertThrows(fn() { json.parse(text) }, "json.parse").data.offset
}

@testWith(
    // error-empty
    [""], 0,
    // error-only-space
    ["   "], 3,
    // error-trailing-comma-array
    ["[1,]"], 3,
    // error-missing-comma
    ["[1 2]"], 3,
    // error-missing-colon
    ["{\"a\" 1}"], 5,
    // error-trailing-comma-object
    ["{\"a\": 1,}"], 8,
    // error-unquoted-key
    ["{a: 1}"], 1,
    // error-truncated-true
    ["tru"], 3,
    // error-truncated-null
    ["nul"], 3,
    // error-leading-zero
    ["01"], 1,
    // error-trailing-dot
    ["1."], 2,
    // error-leading-dot
    [".5"], 0,
    // error-plus-sign
    ["+1"], 0,
    // error-empty-exponent
    ["1e"], 2,
    // error-unterminated-string
    ["\"abc"], 4,
    // error-invalid-escape
    ["\"a\\x\""], 3,
    // error-invalid-hex
    ["\"\\u12g4\""], 5,
    // error-raw-control
    ["\"a\nb\""], 2,
    // error-lone-high-surrogate
    ["\"\\ud83d\""], 1,
    // error-lone-low-surrogate
    ["\"\\ude00\""], 1,
    // error-trailing-content
    ["[1] x"], 4,
    // error-unclosed-array
    ["["], 1,
    // error-unclosed-object
    ["{\"a\":"], 5,
    // error-nan
    ["NaN"], 0,
    // error-bare-minus
    ["-"], 1,
    // error-missing-array-comma
    ["[\"a\" \"b\"]"], 5
)
val reportsTheOffset = failsAt

// Numbers too large for binary64 fail; the spec does not fix the offset.
val failsWith = fn(text:str):str {
    assertThrows(fn() { json.parse(text) }, "json.parse").type
}

@testWith(
    // error-number-out-of-range
    ["1e400"], "json.parse",
    // error-number-just-too-large
    ["17976931348623159e292"], "json.parse"
)
val rejects = failsWith

@testWith(
    // roundtrip-canonical
    [" { \"b\" : [ 1 , 2 ] , \"a\" : \"x\" } "], "{\"a\":\"x\",\"b\":[1,2]}",
    // roundtrip-escapes
    ["\"\\u00e9\\n\""], "\"é\\n\"",
    // roundtrip-numbers
    ["[1.50, 2E1, -0.5e1]"], "[1.5,20,-5]",
    // roundtrip-nested
    ["{\"k\": {\"j\": [{\"i\": null}]}}"], "{\"k\":{\"j\":[{\"i\":null}]}}",
    // roundtrip-control
    ["\"\\u001F\""], "\"\\u001f\"",
    // roundtrip-slash
    ["\"\\/\""], "\"/\""
)
val roundTrips = fn(text:str):str { json.stringify(json.parse(text)) }

@testWith(
    // stringify-null
    [nil], "null",
    // stringify-true
    [true], "true",
    // stringify-integer
    [42], "42",
    // stringify-fraction
    [-0.5], "-0.5",
    // stringify-integral-float
    [1.0], "1",
    // stringify-small
    [0.0025], "0.0025",
    // stringify-million
    [1000000], "1000000",
    // stringify-string
    ["hi"], "\"hi\"",
    // stringify-quote-escapes
    ["q\"b\\s/"], "\"q\\\"b\\\\s/\"",
    // stringify-control-escapes
    ["\n\r\t\10\14"], "\"\\n\\r\\t\\b\\f\"",
    // stringify-unicode-escapes
    ["\1\37"], "\"\\u0001\\u001f\"",
    // stringify-raw-utf8
    ["é😀"], "\"é😀\"",
    // stringify-empty-array
    [[]], "[]",
    // stringify-array
    [[1, "a", nil, [true]]], "[1,\"a\",null,[true]]",
    // stringify-empty-object
    [{}], "{}",
    // stringify-sorted-keys
    [{"b": 1, "a": 2, "c": {"z": [], "y": nil}}], "{\"a\":2,\"b\":1,\"c\":{\"y\":null,\"z\":[]}}",
    // stringify-byte-ordered-keys
    [{"B": 1, "a": 2, "_": 3}], "{\"B\":1,\"_\":3,\"a\":2}",
    // stringify-non-ascii-keys
    [{"é": 1, "z": 2}], "{\"z\":2,\"é\":1}"
)
val writes = fn(value):str { json.stringify(value) }

// What writing `value` throws.
val refuses = fn(value):str {
    assertThrows(fn() { json.stringify(value) }, "json.type").type
}

@testWith(
    // type-function
    [fn() { 1 }], "json.type",
    // type-non-string-key
    [{[1]: "x"}], "json.type",
    // type-nested-function
    [[1, fn() { 2 }]], "json.type",
    // type-bytes
    [0x"00"], "json.type",
    // type-struct
    [S { x: 1 }], "json.type"
)
val rejectsValuesWithoutAJsonForm = refuses

// size-large-document: records like the suite's, written and read back. The
// suite times 4000; 1000 keep this check quick, since it is not timed here.
@test
val roundTripsALargeDocument = fn() {
    val record = fn(index:num) {
        val tag = index % 13
        {
            id: index,
            name: "record $index café",
            note: if (index % 7 == 0) { "line\nbreak\t\"quoted\"" } else { nil },
            tags: ["a", "b", "$tag"],
            active: index % 2 == 0,
            nested: {depth: [index, [index + 1, {leaf: index % 5}]]},
        }
    }
    val records = fn(i:num, out:list):list { if (i == 1000) { out } else { recur(i + 1, out :+ record(i)) } }
    val written = json.stringify(records(0, []))
    assertEqual(json.parse(written), records(0, []))
    assertEqual(json.stringify(json.parse(written)), written)
}

// size-deep-nesting: arrays nested 1000 deep.
@test
val roundTripsDeepNesting = fn() {
    val text = "[" * 1000 + "]" * 1000
    assertEqual(json.stringify(json.parse(text)), text)
}
