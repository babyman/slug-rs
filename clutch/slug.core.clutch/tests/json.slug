// Checks beyond the JSON project's suite, from choosing slug.fmt.json among
// the agents' libraries: hard numbers, with expected values from a correctly
// rounding reader, and error offsets for malformed documents.

val json = import("slug.fmt.json")
val {assertEqual, assertThrows} = import("slug.test")

// An integer fits exactly however it is written, so `7.2057594037927933e16`
// is 72057594037927933; anything else is the nearest binary64 value, and a
// value below the smallest one is 0.
@testWith(
    ["0.1"], 0.1,
    ["5e-324"], 5e-324,
    ["4.9e-324"], 5e-324,
    ["2.4703282292062328e-324"], 5e-324,
    ["2.4703282292062327e-324"], 0,
    ["1e-400"], 0,
    ["2.2250738585072014e-308"], 2.2250738585072014e-308,
    ["2.2250738585072011e-308"], 2.225073858507201e-308,
    ["1.7976931348623157e308"], 1.7976931348623157e+308,
    ["1.7976931348623158e308"], 1.7976931348623157e+308,
    ["9007199254740993"], 9007199254740993,
    ["-9223372036854775808"], -9223372036854775807 - 1,
    ["9223372036854775807"], 9223372036854775807,
    ["9223372036854775808"], 9.223372036854776e+18,
    ["123456789012345678901234567890"], 1.2345678901234568e+29,
    ["0.30000000000000004"], 0.30000000000000004,
    ["1.00000000000000011102230246251565404236316680908203125"], 1.0,
    ["1.00000000000000011102230246251565404236316680908203126"], 1.0000000000000002,
    ["7.2057594037927933e16"], 72057594037927933,
    ["3.141592653589793238462643383279"], 3.141592653589793,
    ["2.5E-3"], 0.0025,
    ["-0.0"], 0,
    ["1E2"], 100,
    ["1e22"], 1e+22,
    ["1e23"], 1e+23,
    ["8.98846567431158e307"], 8.98846567431158e+307,
    ["0.000001"], 1e-06,
    ["1e-7"], 1e-07,
    ["123.456e-2"], 1.23456,
    ["100000000000000000000000000000e-30"], 0.1
)
val readsHardNumbers = fn(text:str) { json.parse(text) }

@test
val rejectsNumbersTooLargeForBinary64 = fn() {
    assertThrows(fn() { json.parse("1e309") }, "json.parse")
    assertThrows(fn() { json.parse("-1.8e308") }, "json.parse")
}

@testWith(
    ["-"], 1,
    ["--1"], 1,
    ["[1 2]"], 3,
    ["\"\t\""], 1,
    ["\"\\u12G4\""], 5,
    ["\"\\ud800\""], 1,
    ["\"\\ud800\\u0041\""], 1,
    ["\"\\udc00\""], 1,
    ["{\"a\":1,}"], 7,
    ["1."], 2,
    ["1e"], 2,
    ["1e+"], 3,
    [".5"], 0,
    ["+1"], 0,
    ["[1,2"], 4,
    ["{\"a\":1 \"b\":2}"], 7,
    ["\"abc"], 4,
    [" "], 1,
    ["[] x"], 3,
    ["\"\\x\""], 2,
    ["[1,,2]"], 3,
    ["{1:2}"], 1,
    ["{\"a\"}"], 4,
    ["-01"], 2,
    ["0x1"], 1,
    ["[-]"], 2,
    ["tRue"], 1,
    ["\"a\\u00\""], 6
)
val reportsTheOffset = fn(text:str):num {
    assertThrows(fn() { json.parse(text) }, "json.parse").data.offset
}

@test
val roundTripsSurrogatePairsAndEscapes = fn() {
    val text = "\"ab\\\"\\n\\u00e9\\ud83d\\ude00\""
    assertEqual(json.parse(text), "ab\"\né😀")
    assertEqual(json.stringify(json.parse(text)), "\"ab\\\"\\né😀\"")
}

@test
val readsDeepNesting = fn() {
    val text = "[" * 5000 + "]" * 5000
    assertEqual(json.stringify(json.parse(text)), text)
}
