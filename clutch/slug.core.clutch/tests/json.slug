// Checks beyond the JSON project's suite, from choosing slug.fmt.json among
// the agents' libraries: hard numbers, with expected values from a correctly
// rounding reader, and error offsets for malformed documents.

val json = import("slug.fmt.json")
val {assertEqual, assertThrows} = import("slug.test")

// An integer fits exactly however it is written, so `7.2057594037927933e16`
// is 72057594037927933; anything else is the nearest binary64 value, and a
// value below the smallest one is 0.
@testWith(
    ["0.1"], 0.1,
    ["5e-324"], 5e-324,
    ["4.9e-324"], 5e-324,
    ["2.4703282292062328e-324"], 5e-324,
    ["2.4703282292062327e-324"], 0,
    ["1e-400"], 0,
    ["2.2250738585072014e-308"], 2.2250738585072014e-308,
    ["2.2250738585072011e-308"], 2.225073858507201e-308,
    ["1.7976931348623157e308"], 1.7976931348623157e+308,
    ["1.7976931348623158e308"], 1.7976931348623157e+308,
    ["9007199254740993"], 9007199254740993,
    ["-9223372036854775808"], -9223372036854775807 - 1,
    ["9223372036854775807"], 9223372036854775807,
    ["9223372036854775808"], 9.223372036854776e+18,
    ["123456789012345678901234567890"], 1.2345678901234568e+29,
    ["0.30000000000000004"], 0.30000000000000004,
    ["1.00000000000000011102230246251565404236316680908203125"], 1.0,
    ["1.00000000000000011102230246251565404236316680908203126"], 1.0000000000000002,
    ["7.2057594037927933e16"], 72057594037927933,
    ["3.141592653589793238462643383279"], 3.141592653589793,
    ["2.5E-3"], 0.0025,
    ["-0.0"], 0,
    ["1E2"], 100,
    ["1e22"], 1e+22,
    ["1e23"], 1e+23,
    ["8.98846567431158e307"], 8.98846567431158e+307,
    ["0.000001"], 1e-06,
    ["1e-7"], 1e-07,
    ["123.456e-2"], 1.23456,
    ["100000000000000000000000000000e-30"], 0.1
)
val readsHardNumbers = fn(text:str) { json.parse(text) }

@test
val rejectsNumbersTooLargeForBinary64 = fn() {
    assertThrows(fn() { json.parse("1e309") }, "json.parse")
    assertThrows(fn() { json.parse("-1.8e308") }, "json.parse")
}

@testWith(
    ["-"], 1,
    ["--1"], 1,
    ["[1 2]"], 3,
    ["\"\t\""], 1,
    ["\"\\u12G4\""], 5,
    ["\"\\ud800\""], 1,
    ["\"\\ud800\\u0041\""], 1,
    ["\"\\udc00\""], 1,
    ["{\"a\":1,}"], 7,
    ["1."], 2,
    ["1e"], 2,
    ["1e+"], 3,
    [".5"], 0,
    ["+1"], 0,
    ["[1,2"], 4,
    ["{\"a\":1 \"b\":2}"], 7,
    ["\"abc"], 4,
    [" "], 1,
    ["[] x"], 3,
    ["\"\\x\""], 2,
    ["[1,,2]"], 3,
    ["{1:2}"], 1,
    ["{\"a\"}"], 4,
    ["-01"], 2,
    ["0x1"], 1,
    ["[-]"], 2,
    ["tRue"], 1,
    ["\"a\\u00\""], 6
)
val reportsTheOffset = fn(text:str):num {
    assertThrows(fn() { json.parse(text) }, "json.parse").data.offset
}

@test
val roundTripsSurrogatePairsAndEscapes = fn() {
    val text = "\"ab\\\"\\n\\u00e9\\ud83d\\ude00\""
    assertEqual(json.parse(text), "ab\"\né😀")
    assertEqual(json.stringify(json.parse(text)), "\"ab\\\"\\né😀\"")
}

@test
val readsDeepNesting = fn() {
    // Deeper than the default limit, so it asks for the depth it needs.
    val text = "[" * 5000 + "]" * 5000
    assertEqual(json.stringify(json.parse(text, {maxDepth: 5000})), text)
}

// parseStrict rejects a repeated key wherever it appears, comparing keys
// after decoding escapes; the offset is the repeated key's opening quote.
@testWith(
    ["{\"body\":\"first\",\"body\":\"second\"}"], [16, "body"],
    ["{\"body\":\"first\",\"\\u0062ody\":\"second\"}"], [16, "body"],
    ["{\"outer\":{\"x\":null,\"x\":1}}"], [19, "x"],
    ["{\"a\":1,\"a\":1}"], [7, "a"],
    ["{\"a\":1,\"b\":2,\"a\":3}"], [13, "a"],
    ["[{}, {\"k\":[{\"z\":0,\"z\":0}]}]"], [18, "z"],
    ["{\"\\ud83d\\ude00\":1,\"😀\":2}"], [18, "😀"]
)
val parseStrictRejectsRepeatedKeys = fn(text:str):list {
    val e = assertThrows(fn() { json.parseStrict(text) }, "json.parse")
    [e.data.offset, e.data.key]
}

@test
val parseStrictKeepsParseBehavior = fn() {
    val text = "{\"a\":{\"x\":1},\"b\":{\"x\":2},\"c\":[{\"x\":3},{\"x\":4}],\"d\":null}"
    assertEqual(json.parseStrict(text), json.parse(text))
    assertEqual(json.parse("{\"x\":null,\"x\":1}"), {x: 1})
    assertEqual(json.parse("{\"body\":1,\"\\u0062ody\":2}"), {body: 2})
    assertEqual(assertThrows(fn() { json.parseStrict("{\"a\":1,}") }, "json.parse").data.offset, 7)
}

// A document may have `maxDepth` arrays and objects open at once, 1000 by
// default; one more throws `json.limit` at the bracket that opens it.
@test
val limitsDepth = fn() {
    val nested = fn(depth:num):str { "[" * depth + "]" * depth }
    assertEqual(len(json.parse(nested(json.DEFAULT_MAX_DEPTH))), 1)
    val e = assertThrows(fn() { json.parse(nested(json.DEFAULT_MAX_DEPTH + 1)) }, "json.limit")
    assertEqual(e.data, {limit: "depth", max: 1000, offset: 1000})
    assertEqual(json.parse("[[1]]", {maxDepth: 2}), [[1]])
    assertEqual(assertThrows(fn() { json.parse("[[[1]]]", {maxDepth: 2}) }, "json.limit").data.offset, 2)
    assertEqual(assertThrows(fn() { json.parse("{\"a\": {\"b\": [1]}}", {maxDepth: 2}) }, "json.limit").data.offset, 12)
    assertEqual(assertThrows(fn() { json.parseStrict("{\"a\": [[]]}", {maxDepth: 2}) }, "json.limit").data.offset, 7)
    assertEqual(json.parse("7", {maxDepth: 1}), 7)
    // A document far past the limit is refused at its first level too many,
    // before reading on: a few hundred kilobytes of brackets cost little.
    assertEqual(assertThrows(fn() { json.parse("[" * 300000) }, "json.limit").data.offset, 1000)
}

@test
val checksOptions = fn() {
    assertThrows(fn() { json.parse("1", {depth: 3}) }, "json.options")
    assertThrows(fn() { json.parse("1", {maxDepth: 0}) }, "json.options")
    assertThrows(fn() { json.parse("1", {maxDepth: 2.5}) }, "json.options")
    assertThrows(fn() { json.parseStrict("1", {maxDepth: "3"}) }, "json.options")
}
