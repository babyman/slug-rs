/**
 * Basic numeric operations implemented by the native core Clutch.
 *
 * Invalid operations throw `Error` values whose `type` is `math.range` or
 * `math.domain`.
 */

// Typed native bindings, declared in this clutch's manifest.
foreign addRaw = fn(left:num, right:num):list
foreign sqrtRaw = fn(value:num):num

/**
 * Returns the integer sum of `left` and `right`.
 *
 * Throws a `math.range` error when the result cannot fit in a Slug integer.
 */
@testWith([20, 22], 42, [-5, 2], -3)
export val add = fn(left:num, right:num):num {
    match addRaw(left, right) {
        [true, sum] => sum
        _ => throw Error {type: "math.range", msg: "integer addition overflowed"}
    }
}

/**
 * Returns the quotient of `left` and `right` rounded toward zero, exact for
 * integers of any size: `div(7, 2)` is 3 and `div(-7, 2)` is -3. With `%`,
 * which also rounds toward zero, `div(a, b) * b + a % b` is `a`. `int(a / b)`
 * is not exact, because `/` gives a float when the division is not exact.
 *
 * Throws a `math.domain` error when `right` is 0, and a `math.range` error
 * for the one quotient that does not fit, the most negative integer divided
 * by -1.
 */
@testWith(
    [7, 2], 3,
    [-7, 2], -3,
    [7, -2], -3,
    [-7, -2], 3,
    [6, 3], 2,
    [9223372036854775807, 3], 3074457345618258602
)
export val div = fn(left:num, right:num):num {
    if (right == 0) {
        throw Error {type: "math.domain", msg: "div requires a non-zero divisor"}
    }
    if (right == -1 && left == -9223372036854775807 - 1) {
        throw Error {type: "math.range", msg: "integer division overflowed"}
    }
    // Removing the remainder, which has the sign of `left` and is smaller
    // than `right`, moves `left` toward zero to an exact multiple of `right`,
    // which `/` divides exactly.
    int((left - left % right) / right)
}

/**
 * Returns the non-negative square root of `value`.
 *
 * Throws a `math.domain` error when `value` is negative.
 */
@testWith([9.0], 3, [16], 4, [0], 0)
export val sqrt = fn(value:num):num {
    if (value < 0) {
        throw Error {type: "math.domain", msg: "sqrt requires a non-negative number"}
    } else {
        sqrtRaw(value)
    }
}
