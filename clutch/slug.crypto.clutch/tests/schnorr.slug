    Vector {index: 3, publicKey: 0x"25d1dff95105f5253c4022f628a996ad3a0d95fbf21d468a1b33f8c160d8f517", message: 0x"ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
