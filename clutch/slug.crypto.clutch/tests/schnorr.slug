val {verify} = import("slug.crypto.schnorr")
val {sha256Of} = import("slug.crypto.hash")
val {toBytes} = import("slug.string")
val {each, range} = import("slug.std")
val {assertEqual, assertTrue, assertFalse, assertThrows} = import("slug.test")

// BIP-340's verification test vectors, from bip-0340/test-vectors.csv:
// https://github.com/bitcoin/bips/blob/master/bip-0340/test-vectors.csv
val Vector = struct {
    index: num,
    publicKey: bytes,
    message: bytes,
    signature: bytes,
    valid: bool,
    comment: str,
}

val VECTORS = [
