    Vector {index: 15, publicKey: 0x"778caa53b4393ac467774d09497a87224bf9fab6f6e68b23086497324d6fd117", message: 0x"",
     signature: 0x"71535db165ecd9fbbc046e5ffaea61186bb6ad436732fccc25291a55895464cf6069ce26bf03466228f19a3a62db8a649f2d560fac652827d1af0574e427ab63",
