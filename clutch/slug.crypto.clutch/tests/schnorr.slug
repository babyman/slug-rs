    Vector {index: 13, publicKey: 0x"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659", message: 0x"243f6a8885a308d313198a2e03707344a4093822299f31d0082efa98ec4e6c89",
