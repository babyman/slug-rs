     valid: false, comment: "has_even_y(R) is false"},
    Vector {index: 7, publicKey: 0x"dff1d77f2a671c5f36183726db2341be58feae1da2deced843240f7b502ba659", message: 0x"243f6a8885a308d313198a2e03707344a4093822299f31d0082efa98ec4e6c89",
     signature: 0x"1fa62e331edbc21c394792d2ab1100a7b432b013df3f6ff4f99fcb33e0e1515f28890b3edb6e7189b630448b515ce4f8622a954cfe545735aaea5134fccdb2bd",
