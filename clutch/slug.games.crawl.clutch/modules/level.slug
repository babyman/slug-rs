/**
 * Level generation. The world is endless chunks, each one map at (cx, cy) on
 * a depth: nine rooms in a 3x3 grid of cells, some of them gone, joined by
 * corridors, then items, stairs, and a starting spot. A chunk draws from its
 * own generator, seeded from the world's seed and its coordinates, so it is
 * the same whenever it is generated.
 *
 * Each edge between two chunks on a depth has one opening, a corridor square
 * on the border whose position is seeded from that edge alone, so both
 * chunks agree on it; walking off a map through an opening enters the next
 * chunk. Every chunk has stairs down, and below depth 1 stairs up, which
 * lead to the chunk at the same (cx, cy) one depth down or up.
 */
val data = import("slug.games.crawl.data")
val rng = import("slug.games.crawl.rng")
val math = import("slug.math")

export val WIDTH = 80
export val HEIGHT = 22
// Monsters come from the table for this depth at most.
val TABLE_DEPTH = 8
val CELL_W = 26
val CELL_H = 7
val CELLS = 9

// Terrain characters.
export val BLANK = " "
export val FLOOR = "."
export val CORRIDOR = "#"
export val DOOR = "+"
export val HWALL = "-"
export val VWALL = "|"
export val STAIRS = "%"
export val UP = "<"

val contains = fn(xs:list, v):bool {
    val go = fn(i:num):bool {
        if (i == len(xs)) { false } else if (xs[i] == v) { true } else { recur(i + 1) }
    }
    go(0)
}

// Writes `text` into row y of `rows` starting at column x.
val write = fn(rows:list, x:num, y:num, text:str):list {
    val row = rows[y]
    rows[:y] + [row[:x] + text + row[x + len(text):]] + rows[y + 1:]
}

val adjacent = fn(a:num, b:num):bool {
    val sameRow = math.div(a, 3) == math.div(b, 3)
    val sameCol = a % 3 == b % 3
    (sameRow && (a - b == 1 || b - a == 1)) || (sameCol && (a - b == 3 || b - a == 3))
}

/**
 * A new item of a random kind: the kind by weight, then its type by weight,
 * then for weapons and armour one draw for the bonus.
 */
export val newItem = fn():map {
    val kind = data.itemKinds[rng.pick(data.itemKinds)].kind
    val bonus = fn():num {
        val b = rng.below(100)
        if (b < 10) { -1 } else if (b < 25) { 1 } else { 0 }
    }
    match kind {
        "potion" => {kind: "potion", type: rng.pick(data.potions)}
        "scroll" => {kind: "scroll", type: rng.pick(data.scrolls)}
        "food" => {kind: "food"}
        "weapon" => {
            val type = rng.pick(data.weapons)
            {kind: "weapon", type: type, bonus: bonus()}
        }
        _ => {
            val type = rng.pick(data.armours)
            {kind: "armour", type: type, bonus: bonus()}
        }
    }
}

/**
 * A free square anywhere on level `lv` (with `map`, `rooms`, `items`, and
 * `monsters`): draw a cell until it is not gone, then x and y in its room;
 * if that square is not floor without an item or monster, start again.
 */
export val freeSpot = fn(lv:map):map {
    val occupied = fn(list:list, x:num, y:num):bool {
        val go = fn(i:num):bool {
            if (i == len(list)) {
                false
            } else if (list[i].x == x && list[i].y == y) {
                true
            } else {
                recur(i + 1)
            }
        }
        go(0)
    }
    val room = lv.rooms[rng.below(CELLS)]
    if (room.gone) {
        recur(lv)
    } else {
        val x = room.x + 1 + rng.below(room.w - 2)
        val y = room.y + 1 + rng.below(room.h - 2)
        if (lv.map[y][x] == FLOOR && !occupied(lv.items, x, y) && !occupied(lv.monsters, x, y)) {
            {x: x, y: y}
        } else {
            recur(lv)
        }
    }
}

/**
 * Where the opening on an edge lies, seeded from the edge alone: for `kind`
 * "ew", the edge between chunks (cx, cy) and (cx + 1, cy), its row, from 1 to
 * HEIGHT - 3; for "ns", the edge between (cx, cy) and (cx, cy + 1), its
 * column, from 1 to WIDTH - 3.
 */
export val opening = fn(world:num, kind:str, cx:num, cy:num, depth:num):num {
    val seed = rng.mix([world, if (kind == "ew") { 1 } else { 2 }, cx, cy, depth])
    rng.within(seed, fn() {
        if (kind == "ew") { 1 + rng.below(HEIGHT - 3) } else { 1 + rng.below(WIDTH - 3) }
    })
}

/**
 * Generates the chunk at (cx, cy) on `depth` (1 or more) of the world with
 * seed `world`. The result has `map` (HEIGHT strings of WIDTH terrain
 * characters), `rooms` (one per cell, in cell order), `items` and `monsters`
 * (in creation order), `down` and `up` (where its stairs are; `up` is nil on
 * depth 1), and `start`, a free spot.
 */
export val generate = fn(world:num, cx:num, cy:num, depth:num):map {
    rng.within(rng.mix([world, cx, cy, depth]), fn() { build(world, cx, cy, depth) })
}

val build = fn(world:num, cx:num, cy:num, depth:num):map {
    var rows = []
    val blank = fn(i:num) {
        if (i < HEIGHT) {
            rows = rows :+ (BLANK * WIDTH)
            recur(i + 1)
        }
    }
    blank(0)
    var items = []
    var monsters = []
    var rooms = []

    val at = fn(x:num, y:num):str { rows[y][x] }
    val occupied = fn(list:list, x:num, y:num):bool {
        val go = fn(i:num):bool {
            if (i == len(list)) {
                false
            } else if (list[i].x == x && list[i].y == y) {
                true
            } else {
                recur(i + 1)
            }
        }
        go(0)
    }
    val free = fn(x:num, y:num):bool {
        at(x, y) == FLOOR && !occupied(items, x, y) && !occupied(monsters, x, y)
    }
    // A free floor spot inside `room`: draw x then y until the spot is free.
    val spotIn = fn(room:map):map {
        val x = room.x + 1 + rng.below(room.w - 2)
        val y = room.y + 1 + rng.below(room.h - 2)
        if (free(x, y)) { {x: x, y: y} } else { recur(room) }
    }
    // A free floor spot in any room: draw a cell until it is not gone, then
    // a spot in it; if the spot is not free, start again from the cell.
    val anySpot = fn():map {
        val room = rooms[rng.below(CELLS)]
        if (room.gone) {
            recur()
        } else {
            val x = room.x + 1 + rng.below(room.w - 2)
            val y = room.y + 1 + rng.below(room.h - 2)
            if (free(x, y)) { {x: x, y: y} } else { recur() }
        }
    }

    // 1. Gone cells: below(4) of them, each drawn until not already gone.
    val chooseGone = fn(n:num, gone:list):list {
        if (n == 0) {
            gone
        } else {
            val c = rng.below(CELLS)
            if (contains(gone, c)) { recur(n, gone) } else { recur(n - 1, gone :+ c) }
        }
    }
    val gone = chooseGone(rng.below(4), [])

    // 2. Rooms, cell by cell, each with its gold and monster.
    val candidates = fn(i:num, acc:list):list {
        if (i == len(data.monsters)) {
            acc
        } else {
            val m = data.monsters[i]
            val d = math.min(depth, TABLE_DEPTH)
            recur(i + 1, if (m.depths[0] <= d && d <= m.depths[1]) { acc :+ i } else { acc })
        }
    }
    val kinds = candidates(0, [])
    // Cells on the left and top keep two squares clear of the border, so a
    // corridor always fits between them and an opening.
    val makeRoom = fn(cell:num) {
        val left = (cell % 3) * CELL_W
        val top = math.div(cell, 3) * CELL_H
        val mx = if (cell % 3 == 0) { 2 } else { 0 }
        val my = if (cell < 3) { 2 } else { 0 }
        if (contains(gone, cell)) {
            val x = left + math.max(1, mx) + rng.below(CELL_W - 2 - math.max(1, mx))
            val y = top + math.max(1, my) + rng.below(CELL_H - 2 - math.max(1, my))
            rooms = rooms :+ {x: x, y: y, w: 1, h: 1, gone: true, dark: false}
        } else {
            val dark = rng.below(10) < depth - 1
            val w = 4 + rng.below(CELL_W - 4 - mx)
            val h = 4 + rng.below(CELL_H - 4 - my)
            val x = left + mx + rng.below(CELL_W - w - mx)
            val y = top + my + rng.below(CELL_H - h - my)
            val room = {x: x, y: y, w: w, h: h, gone: false, dark: dark}
            rooms = rooms :+ room
            rows = write(rows, x, y, HWALL * w)
            rows = write(rows, x, y + h - 1, HWALL * w)
            val sides = fn(r:num) {
                if (r < y + h - 1) {
                    rows = write(rows, x, r, VWALL + FLOOR * (w - 2) + VWALL)
                    recur(r + 1)
                }
            }
            sides(y + 1)
            val gold = rng.below(2) == 0
            if (gold) {
                val amount = rng.below(50 + 10 * depth) + 2
                val spot = spotIn(room)
                items = items :+ {x: spot.x, y: spot.y, item: {kind: "gold", amount: amount}}
            }
            if (rng.below(100) < (if (gold) { 80 } else { 25 })) {
                val spot = spotIn(room)
                val kind = kinds[rng.below(len(kinds))]
                val hp = rng.roll(data.monsters[kind].level, 8)
                monsters = monsters :+ {x: spot.x, y: spot.y, kind: kind, hp: hp, maxHp: hp, state: "asleep"}
            }
        }
    }
    val eachCell = fn(cell:num) {
        if (cell < CELLS) {
            makeRoom(cell)
            recur(cell + 1)
        }
    }
    eachCell(0)

    // 3. Corridors.
    val dig = fn(x:num, y:num) {
        if (at(x, y) == BLANK) { rows = write(rows, x, y, CORRIDOR) }
    }
    // A door on a room's wall, or a gone cell's point, which becomes corridor.
    val door = fn(room:map, x:num, y:num):map {
        rows = write(rows, x, y, if (room.gone) { CORRIDOR } else { DOOR })
        {x: x, y: y}
    }
    // Digs a corridor from s to e, not including either: across from s to a
    // turn, then along to e's line, then across to e when `horizontal`, or
    // the same down the map when not. Draws the turn.
    val route = fn(s:map, e:map, horizontal:bool) {
        if (horizontal) {
            val turn = s.x + 1 + rng.below(e.x - s.x - 1)
            val first = fn(x:num) { if (x <= turn) { dig(x, s.y); recur(x + 1) } }
            first(s.x + 1)
            val step = if (e.y > s.y) { 1 } else { -1 }
            val across = fn(y:num) { if (y != e.y) { dig(turn, y + step); recur(y + step) } }
            across(s.y)
            val last = fn(x:num) { if (x < e.x) { dig(x, e.y); recur(x + 1) } }
            last(turn + 1)
        } else {
            val turn = s.y + 1 + rng.below(e.y - s.y - 1)
            val first = fn(y:num) { if (y <= turn) { dig(s.x, y); recur(y + 1) } }
            first(s.y + 1)
            val step = if (e.x > s.x) { 1 } else { -1 }
            val across = fn(x:num) { if (x != e.x) { dig(x + step, turn); recur(x + step) } }
            across(s.x)
            val last = fn(y:num) { if (y < e.y) { dig(e.x, y); recur(y + 1) } }
            last(turn + 1)
        }
    }
    // Where a corridor leaves `room` on its `side`: a door on that wall, or
    // the point of a gone cell. Draws the door's place along the wall.
    val exit = fn(room:map, side:str):map {
        if (room.gone) { return door(room, room.x, room.y) }
        match side {
            "east" => door(room, room.x + room.w - 1, room.y + 1 + rng.below(room.h - 2))
            "west" => door(room, room.x, room.y + 1 + rng.below(room.h - 2))
            "north" => door(room, room.x + 1 + rng.below(room.w - 2), room.y)
            _ => door(room, room.x + 1 + rng.below(room.w - 2), room.y + room.h - 1)
        }
    }
    // Joins cell a to cell b = a + 1 (side by side) or a + 3 (one above the
    // other). Draws: a's door, b's door, then the turn.
    val connect = fn(a:num, b:num) {
        if (b == a + 1) {
            val s = exit(rooms[a], "east")
            route(s, exit(rooms[b], "west"), true)
        } else {
            val s = exit(rooms[a], "south")
            route(s, exit(rooms[b], "north"), false)
        }
    }
    var joined = []
    val join = fn(a:num, b:num) {
        if (a < b) { connect(a, b) } else { connect(b, a) }
        joined = joined :+ [a, b] :+ [b, a]
    }
    // Reservoir choice among the cells adjacent to r that pass `ok`, in cell
    // order: the j-th such cell replaces the choice when below(j) is 0.
    // Returns [count, choice].
    val choose = fn(r:num, ok:fn):list {
        val go = fn(i:num, j:num, choice:num):list {
            if (i == CELLS) {
                [j, choice]
            } else if (adjacent(r, i) && ok(i)) {
                val k = j + 1
                recur(i + 1, k, if (rng.below(k) == 0) { i } else { choice })
            } else {
                recur(i + 1, j, choice)
            }
        }
        go(0, 0, -1)
    }
    // A spanning tree: from r, join a random adjacent cell not yet in the
    // graph; when r has none, draw cells until one in the graph.
    val span = fn(r:num, graph:list) {
        if (len(graph) < CELLS) {
            match choose(r, fn(i:num):bool { !contains(graph, i) }) {
                [0, _] => {
                    val pick = fn():num {
                        val c = rng.below(CELLS)
                        if (contains(graph, c)) { c } else { recur() }
                    }
                    recur(pick(), graph)
                }
                [_, other] => {
                    join(r, other)
                    recur(r, graph :+ other)
                }
            }
        }
    }
    val start = rng.below(CELLS)
    span(start, [start])
    // Extra corridors: below(5) times, from a random cell to a random
    // adjacent cell it is not yet joined to, if any.
    val extra = fn(n:num) {
        if (n > 0) {
            val r = rng.below(CELLS)
            match choose(r, fn(i:num):bool { !contains(joined, [r, i]) }) {
                [0, _] => nil
                [_, other] => join(r, other)
            }
            recur(n - 1)
        }
    }
    extra(rng.below(5))

    // 4. Items: nine tries, each making an item with chance 36 in 100.
    val things = fn(n:num) {
        if (n < 9) {
            if (rng.below(100) < 36) {
                val item = newItem()
                val spot = anySpot()
                items = items :+ {x: spot.x, y: spot.y, item: item}
            }
            recur(n + 1)
        }
    }
    things(0)

    // 5. Openings: east, west, north, then south, each joined to the cell
    // beside it on that side, from the row or column band it lies in.
    val band = fn(at:num, size:num):num { math.min(2, math.div(at, size)) }
    val opened = fn(x:num, y:num):map {
        rows = write(rows, x, y, CORRIDOR)
        {x: x, y: y}
    }
    val east = opening(world, "ew", cx, cy, depth)
    route(exit(rooms[band(east, CELL_H) * 3 + 2], "east"), opened(WIDTH - 1, east), true)
    val west = opening(world, "ew", cx - 1, cy, depth)
    val w = opened(0, west)
    route(w, exit(rooms[band(west, CELL_H) * 3], "west"), true)
    val north = opening(world, "ns", cx, cy - 1, depth)
    val n = opened(north, 0)
    route(n, exit(rooms[band(north, CELL_W)], "north"), false)
    val south = opening(world, "ns", cx, cy, depth)
    route(exit(rooms[6 + band(south, CELL_W)], "south"), opened(south, HEIGHT - 1), false)

    // 6. Stairs down, stairs up below depth 1, then a starting spot.
    val down = anySpot()
    rows = write(rows, down.x, down.y, STAIRS)
    val up = if (depth > 1) {
        val spot = anySpot()
        rows = write(rows, spot.x, spot.y, UP)
        spot
    } else {
        nil
    }
    val start = anySpot()

    {map: rows, rooms: rooms, items: items, monsters: monsters, down: down, up: up, start: start}
}
