/**
 * The game: its state, the player's commands, and the text the screen shows.
 *
 * The state is a world and a player. The world is what every player would
 * share: its seed, the turn, item appearances, and the chunks generated so
 * far, each with its map, rooms, items, monsters, and stairs. The player is
 * everything that is one person's own: the chunk they are in and their
 * place in it, stats, pack, what they have identified, what they remember
 * of each chunk, and their messages, prompt, and whether they are dead.
 *
 * A player starts, and after dying starts again as a new character, at a
 * random spot on depth 1 near the world's origin; the world carries on.
 */
val data = import("slug.games.crawl.data")
val rng = import("slug.games.crawl.rng")
val level = import("slug.games.crawl.level")
val string = import("slug.string")
val math = import("slug.math")
val {map, filter} = import("slug.std")

export val DIRECTIONS = {
    h: [-1, 0], j: [0, 1], k: [0, -1], l: [1, 0],
    y: [-1, -1], u: [1, -1], b: [-1, 1], n: [1, 1],
    left: [-1, 0], down: [0, 1], up: [0, -1], right: [1, 0],
}

// The eight directions in the order the rules try them.
val ORDER = [[-1, 0], [0, 1], [0, -1], [1, 0], [-1, -1], [1, -1], [-1, 1], [1, 1]]

val GLYPHS = {gold: "*", potion: "!", scroll: "?", food: ":", weapon: ")", armour: "]"}

val PASSABLE = [level.FLOOR, level.CORRIDOR, level.DOOR, level.STAIRS, level.UP]

// Players start in a chunk from -SPAWN to SPAWN on each axis of depth 1.
val SPAWN = 2

val LETTERS = "abcdefghijklmnopqrstuvwxyz"
val PACK_SIZE = 22

// Hunger: the food counter's start, its cap, and when the player starves.
val FOOD_START = 1300
val FOOD_MAX = 2000
val STARVED = -850

// Item commands: their prompt verb, the item kind they need (nil for any),
// and what they say when there is nothing to use or the item is wrong.
val ItemCommand = struct { verb:str, kind:str|nil, nothing:str, wrong:str }

val ITEM_COMMANDS = {
    e: ItemCommand {verb: "Eat", kind: "food", nothing: "You have nothing to eat.", wrong: "You can't eat that."},
    q: ItemCommand {verb: "Quaff", kind: "potion", nothing: "You have nothing to quaff.", wrong: "You can't quaff that."},
    r: ItemCommand {verb: "Read", kind: "scroll", nothing: "You have nothing to read.", wrong: "You can't read that."},
    w: ItemCommand {verb: "Wield", kind: "weapon", nothing: "You have nothing to wield.", wrong: "You can't wield that."},
    a: ItemCommand {verb: "Wear or take off", kind: "armour", nothing: "You have nothing to wear.", wrong: "You can't wear that."},
    d: ItemCommand {verb: "Drop", kind: nil, nothing: "You have nothing to drop.", wrong: ""},
}

var world = {}
var levels = {}
var players = {}

// The player acting now, loaded from `players` by `actAs`, and their id.
var player = {}
var acting:str|nil = nil

// Whether a `tick` is running, and whether the action it is carrying out
// spent the player's turn.
var ticking = false
var spent = false

/**
 * The whole game: `world`, `levels` (the chunks generated so far, by
 * `chunkKey`), and `players` by id.
 */
export val current = fn():map {
    val all = if (acting == nil) { players } else { players + {[acting]: player} }
    {world: world, levels: levels, players: all}
}

// Runs `body` as the player with `id`: the engine's rules all act on
// `player`, which holds them meanwhile and is saved back after. Nests, as
// when a monster attacks another player during someone's turn.
val actAs = fn(id:str, body:fn) {
    val outer = acting
    if (outer != nil) { players = players + {[outer]: player} }
    acting = id
    player = players[id]
    val result = body()
    players = players + {[id]: player}
    acting = outer
    if (outer != nil) { player = players[outer] }
    result
}

/**
 * The key of the chunk at (cx, cy) on `depth`, such as "0,-1,2".
 */
export val chunkKey = fn(cx:num, cy:num, depth:num):str { "" + cx + "," + cy + "," + depth }

val playerKey = fn():str { chunkKey(player.cx, player.cy, player.depth) }

// The chunk the acting player is in.
val site = fn():map { levels[playerKey()] }

val setHere = fn(lv:map) {
    levels = levels + {[playerKey()]: lv}
}

// A chunk no one remembers anything of.
val BLANK_ROWS = (fn(i:num, rows:list):list {
    if (i == level.HEIGHT) { rows } else { recur(i + 1, rows :+ (level.BLANK * level.WIDTH)) }
})(0, [])

// What the player remembers of the chunk they are in, as its rows.
val memory = fn():list { player.memory[playerKey()] ?? BLANK_ROWS }

val setMemory = fn(rows:list) {
    player = player copy {memory: player.memory + {[playerKey()]: rows}}
}

// The living players in the chunk with `key`, the acting player among them,
// as [id, player] pairs in id order.
val companyIn = fn(key:str):list {
    val ids = string.sort(keys(players))
    val go = fn(i:num, acc:list):list {
        if (i == len(ids)) { return acc }
        val id = ids[i]
        val p = if (id == acting) { player } else { players[id] }
        recur(i + 1, if (!p.dead && chunkKey(p.cx, p.cy, p.depth) == key) { acc :+ [id, p] } else { acc })
    }
    go(0, [])
}

// Whether a living player stands at (x, y) in the chunk with `key`.
val playerIn = fn(key:str, x:num, y:num):bool {
    val company = companyIn(key)
    val go = fn(i:num):bool {
        if (i == len(company)) { false } else if (company[i][1].x == x && company[i][1].y == y) { true } else { recur(i + 1) }
    }
    go(0)
}

val playerAt = fn(x:num, y:num):bool { playerIn(playerKey(), x, y) }

val contains = fn(xs:list, v):bool {
    val go = fn(i:num):bool {
        if (i == len(xs)) { false } else if (xs[i] == v) { true } else { recur(i + 1) }
    }
    go(0)
}

val write = fn(rows:list, x:num, y:num, text:str):list {
    val row = rows[y]
    rows[:y] + [row[:x] + text + row[x + len(text):]] + rows[y + 1:]
}

val inBounds = fn(x:num, y:num):bool {
    x >= 0 && x < level.WIDTH && y >= 0 && y < level.HEIGHT
}

val terrain = fn(x:num, y:num):str {
    if (inBounds(x, y)) { site().map[y][x] } else { level.BLANK }
}

val passable = fn(x:num, y:num):bool { contains(PASSABLE, terrain(x, y)) }

// The index of the first entry of `list` at (x, y), or -1.
val indexAt = fn(list:list, x:num, y:num):num {
    val go = fn(i:num):num {
        if (i == len(list)) {
            -1
        } else if (list[i].x == x && list[i].y == y) {
            i
        } else {
            recur(i + 1)
        }
    }
    go(0)
}

val say = fn(text:str) {
    player = player copy {messages: player.messages :+ text}
}

val setPlayer = fn(p:map) {
    player = p
}

// ---------------------------------------------------------------------------
// Items and the pack.

val sign = fn(n:num):str { if (n >= 0) { "+" + n } else { "" + n } }

val an = fn(word:str):str {
    if (contains(["a", "e", "i", "o", "u"], word[0])) { "an " + word } else { "a " + word }
}

val identified = fn(item:map):bool {
    match item.kind {
        "potion" => contains(player.known.potions, item.type)
        "scroll" => contains(player.known.scrolls, item.type)
        _ => true
    }
}

// The name of `count` of `item`, as messages and the inventory show it.
val nameOf = fn(item:map, count:num):str {
    val many = count > 1
    val n = "" + count + " "
    match item.kind {
        "food" => if (many) { n + "food rations" } else { "a food ration" }
        "weapon" => "a " + sign(item.bonus) + " " + data.weapons[item.type].name
        "armour" => sign(item.bonus) + " " + data.armours[item.type].name
        "potion" => {
            if (identified(item)) {
                val name = data.potions[item.type].name
                if (many) { n + "potions of " + name } else { "a potion of " + name }
            } else {
                val colour = world.colours[item.type]
                if (many) { n + colour + " potions" } else { an(colour + " potion") }
            }
        }
        "scroll" => {
            if (identified(item)) {
                val name = data.scrolls[item.type].name
                if (many) { n + "scrolls of " + name } else { "a scroll of " + name }
            } else {
                val title = "\"" + world.titles[item.type] + "\""
                if (many) { n + "scrolls titled " + title } else { "a scroll titled " + title }
            }
        }
        _ => item.kind
    }
}

// The index of the pack entry with `letter`, or -1.
val packIndex = fn(letter:str|nil):num {
    val go = fn(i:num):num {
        if (i == len(player.pack)) {
            -1
        } else if (player.pack[i].letter == letter) {
            i
        } else {
            recur(i + 1)
        }
    }
    go(0)
}

// A pack entry's inventory line.
val packLine = fn(e:map):str {
    val p = player
    val suffix = if (e.letter == p.weapon) {
        " (weapon in hand)"
    } else if (e.letter == p.armour) {
        " (being worn)"
    } else {
        ""
    }
    e.letter + ") " + nameOf(e.item, e.count) + suffix
}

val stacks = fn(a:map, b:map):bool {
    a.kind == b.kind && (a.kind == "food" || ((a.kind == "potion" || a.kind == "scroll") && a.type == b.type))
}

// Adds `item` to the pack: onto a stack it belongs to, or under the lowest
// free letter if the pack has room. Returns the letter, or nil when full.
val addToPack = fn(item:map):str|nil {
    val stack = fn(i:num):num {
        if (i == len(player.pack)) {
            -1
        } else if (stacks(player.pack[i].item, item)) {
            i
        } else {
            recur(i + 1)
        }
    }
    val s = stack(0)
    if (s >= 0) {
        val e = player.pack[s]
        player = player copy {pack: player.pack[:s] + [e copy {count: e.count + 1}] + player.pack[s + 1:]}
        e.letter
    } else if (len(player.pack) >= PACK_SIZE) {
        nil
    } else {
        val free = fn(i:num):str {
            if (packIndex(LETTERS[i]) < 0) { LETTERS[i] } else { recur(i + 1) }
        }
        val letter = free(0)
        // Keep the pack in letter order.
        val place = fn(i:num):num {
            if (i == len(player.pack) || player.pack[i].letter > letter) { i } else { recur(i + 1) }
        }
        val at = place(0)
        player = player copy {pack: player.pack[:at] + [{letter: letter, item: item, count: 1}] + player.pack[at:]}
        letter
    }
}

// Removes one item from the stack with `letter`, or the whole entry when it
// is the last; an entry that goes is no longer wielded or worn.
val takeOne = fn(letter:str) {
    val i = packIndex(letter)
    val e = player.pack[i]
    if (e.count > 1) {
        player = player copy {pack: player.pack[:i] + [e copy {count: e.count - 1}] + player.pack[i + 1:]}
    } else {
        removeEntry(letter)
    }
}

val removeEntry = fn(letter:str) {
    val i = packIndex(letter)
    player = player copy {pack: player.pack[:i] + player.pack[i + 1:]}
    val p = player
    setPlayer(p copy {
        weapon: if (p.weapon == letter) { nil } else { p.weapon },
        armour: if (p.armour == letter) { nil } else { p.armour },
    })
}

val setEntry = fn(letter:str, e:map) {
    val i = packIndex(letter)
    player = player copy {pack: player.pack[:i] + [e] + player.pack[i + 1:]}
}

// The player's armour: the worn armour's value plus its bonus, or 0.
val armourTotal = fn():num {
    val i = packIndex(player.armour)
    if (i < 0) {
        0
    } else {
        val item = player.pack[i].item
        data.armours[item.type].armour + item.bonus
    }
}

// Picks up whatever is on the player's square.
val pickUp = fn() {
    val p = player
    val i = indexAt(site().items, p.x, p.y)
    if (i >= 0) {
        val item = site().items[i].item
        if (item.kind == "gold") {
            setHere(site() copy {items: site().items[:i] + site().items[i + 1:]})
            setPlayer(player copy {gold: player.gold + item.amount})
            say("You found " + item.amount + " gold pieces.")
        } else {
            match addToPack(item) {
                letter: str => {
                    setHere(site() copy {items: site().items[:i] + site().items[i + 1:]})
                    say(packLine(player.pack[packIndex(letter)]))
                }
                _ => say("Your pack is full.")
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Seeing.

// The room whose rectangle, walls included, holds (x, y), or nil.
val roomAt = fn(x:num, y:num):map|nil {
    val go = fn(i:num):map|nil {
        if (i == len(site().rooms)) {
            nil
        } else {
            val r = site().rooms[i]
            if (!r.gone && x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) { r } else { recur(i + 1) }
        }
    }
    go(0)
}

// Whether the acting player can see (x, y); see `visible`.
val canSee = fn(x:num, y:num):bool {
    val p = player
    val dx = x - p.x
    val dy = y - p.y
    if (p.blind > 0) {
        false
    } else if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1) {
        true
    } else {
        val room = roomAt(p.x, p.y)
        room != nil && !room.dark && x >= room.x && x < room.x + room.w && y >= room.y && y < room.y + room.h
    }
}

// What the player remembers at (x, y): the item there, or the terrain.
val sight = fn(x:num, y:num):str {
    val i = indexAt(site().items, x, y)
    if (i >= 0) { GLYPHS[site().items[i].item.kind] } else { terrain(x, y) }
}

// Records every visible square in the player's memory.
val see = fn() {
    var seen = memory()
    val look = fn(x:num, y:num) {
        if (inBounds(x, y)) { seen = write(seen, x, y, sight(x, y)) }
    }
    val p = player
    if (p.blind == 0) {
        val room = roomAt(p.x, p.y)
        if (room != nil && !room.dark) {
            val rows = fn(y:num) {
                if (y < room.y + room.h) {
                    val cols = fn(x:num) {
                        if (x < room.x + room.w) {
                            look(x, y)
                            recur(x + 1)
                        }
                    }
                    cols(room.x)
                    recur(y + 1)
                }
            }
            rows(room.y)
        }
        val around = fn(i:num) {
            if (i < 9) {
                look(p.x + i % 3 - 1, p.y + int(i / 3) - 1)
                recur(i + 1)
            }
        }
        around(0)
    }
    setMemory(seen)
}

// The chunk at (cx, cy) on `depth`, generated the first time it is needed.
val chunk = fn(cx:num, cy:num, depth:num):map {
    val key = chunkKey(cx, cy, depth)
    match levels[key] {
        lv: map => lv
        _ => {
            val lv = level.generate(world.seed, cx, cy, depth)
            levels = levels + {[key]: lv}
            lv
        }
    }
}

// Puts the player in the chunk at (cx, cy) on `depth`, at the spot `place`
// gives for that chunk, and looks around. A chunk no one has been in for
// `world.restockAfter` turns is restocked first.
val enter = fn(cx:num, cy:num, depth:num, place:fn) {
    val lv = chunk(cx, cy, depth)
    val spot = place(lv)
    val key = chunkKey(cx, cy, depth)
    val left = world.turn - (lv.seen ?? world.turn)
    if (left >= world.restockAfter && len(companyIn(key)) == 0) { restock(cx, cy, depth, lv, spot) }
    player = player copy {cx: cx, cy: cy, depth: depth, x: spot.x, y: spot.y, sense: false}
    markSeen()
    see()
}

// Gives the chunk at (cx, cy) on `depth` fresh monsters and items, keeping
// the items players dropped there and keeping clear of `spot` and of
// anyone away who stands there.
val restock = fn(cx:num, cy:num, depth:num, lv:map, spot:map) {
    val key = chunkKey(cx, cy, depth)
    val n = (lv.restocks ?? 0) + 1
    val standing = map(filter(keys(players), fn(id) {
        val p = players[id]
        chunkKey(p.cx, p.cy, p.depth) == key
    }), fn(id) { {x: players[id].x, y: players[id].y} })
    val keep = filter(lv.items, fn(i) { i.dropped == true })
    val fresh = level.restock(world.seed, cx, cy, depth, n, lv, keep, standing :+ spot)
    levels = levels + {[key]: lv + fresh + {restocks: n}}
}

// Notes that someone is in the acting player's chunk this turn.
val markSeen = fn() { setHere(site() + {seen: world.turn}) }

// A new character, at a random free spot in a chunk near the origin of
// depth 1.
val newCharacter = fn() {
    val name = player.name ?? "someone"
    player = {
        name: name,
        cx: 0, cy: 0, depth: 1, x: 0, y: 0, hp: 12, maxHp: 12, str: 16, maxStr: 16, gold: 0, level: 1, xp: 0,
        weapon: "a", armour: "b", food: FOOD_START, regen: 0, frozen: 0, confused: 0, blind: 0,
        pack: [
            {letter: "a", item: {kind: "weapon", type: 0, bonus: 1}, count: 1},
            {letter: "b", item: {kind: "armour", type: 1, bonus: 1}, count: 1},
            {letter: "c", item: {kind: "food"}, count: 1},
        ],
        known: {potions: [], scrolls: []},
        memory: {},
        messages: ["Welcome to the dungeon."],
        more: [],
        prompt: nil,
        showingPack: false,
        dead: false,
        sense: false,
    }
    val cx = rng.below(2 * SPAWN + 1) - SPAWN
    val cy = rng.below(2 * SPAWN + 1) - SPAWN
    val key = chunkKey(cx, cy, 1)
    val free = fn(lv:map):map {
        val spot = level.freeSpot(lv)
        if (playerIn(key, spot.x, spot.y)) { recur(lv) } else { spot }
    }
    enter(cx, cy, 1, free)
}

/**
 * The game's snapshot: `current()`, with the generator's state as `rng`.
 */
export val snapshot = fn():map { current() + {rng: rng.getState()} }

/**
 * Continues the game a snapshot holds, exactly as it was saved.
 */
export val load = fn(saved:map) {
    rng.setState(saved.rng)
    world = saved.world
    levels = saved.levels
    players = saved.players
    player = {}
    acting = nil
}

// How many turns a chunk stays as it was with no one in it before it is
// restocked, unless `newGame` is told otherwise.
val RESTOCK_AFTER = 2000

/**
 * Starts a new world with `seed`, with no one in it yet. A chunk that no one
 * has been in for `options.restockAfter` turns or ticks (default 2000) gets
 * fresh monsters and items when someone next enters it; items players
 * dropped there stay.
 */
export val newGame = fn(seed:num, options:map = {}) {
    rng.seed(seed)
    val colours = rng.shuffle(data.colours)
    val titles = rng.shuffle(data.titles)
    world = {seed: seed, turn: 0, colours: colours, titles: titles, restockAfter: options.restockAfter ?? RESTOCK_AFTER}
    levels = {}
    players = {}
    player = {}
    acting = nil
}

/**
 * Adds a player with `id`, called `name`, as a new character on depth 1;
 * does nothing when `id` is already playing.
 */
export val join = fn(id:str, name:str) {
    if (players[id] == nil) {
        players = players + {[id]: {name: name}}
        actAs(id, newCharacter)
    }
}

/**
 * Whether a player with `id` has joined.
 */
export val playing = fn(id:str):bool { current().players[id] != nil }

/**
 * The player with `id`; throws an `Error` of type `crawl.player` when no
 * such player has joined.
 */
export val playerOf = fn(id:str):map {
    match current().players[id] {
        p: map => p
        _ => throw Error {type: "crawl.player", msg: "no player " + id}
    }
}

// ---------------------------------------------------------------------------
// Monsters and combat.

// Whether a step from (x, y) by (dx, dy) is allowed by the terrain: the
// target must be passable, and for a diagonal step so must both squares
// beside it.
val stepOk = fn(x:num, y:num, dx:num, dy:num):bool {
    passable(x + dx, y + dy) && (dx == 0 || dy == 0 || (passable(x + dx, y) && passable(x, y + dy)))
}

val kindOf = fn(m:map) { data.monsters[m.kind] }

val hasFlag = fn(m:map, flag:str):bool { contains(kindOf(m).flags, flag) }

val setMonster = fn(i:num, m:map) {
    setHere(site() copy {monsters: site().monsters[:i] + [m] + site().monsters[i + 1:]})
}

val removeMonster = fn(i:num) {
    setHere(site() copy {monsters: site().monsters[:i] + site().monsters[i + 1:]})
}

// An attack roll: hits when below(20) + 1 + level + bonus >= 10 + armour.
val hits = fn(level:num, bonus:num, armour:num):bool {
    rng.below(20) + 1 + level + bonus >= 10 + armour
}

val strengthHit = fn(str:num):num {
    if (str >= 18) { 1 } else if (str <= 6) { -1 } else { 0 }
}

val strengthDamage = fn(str:num):num {
    if (str >= 18) { 2 } else if (str == 17) { 1 } else if (str <= 6) { -1 } else { 0 }
}

val die = fn(cause:str) {
    player = player copy {dead: true}
    say("You die.")
    say(cause + " on depth " + player.depth + ".")
    say("Press enter to start again.")
}

// Experience: each level from 2 needs 10, 20, 40, ... points; each level
// gained adds roll(1, 10) to hit points and their maximum.
val gainXp = fn(xp:num) {
    setPlayer(player copy {xp: player.xp + xp})
    val up = fn(need:num) {
        val p = player
        if (p.xp >= need) {
            val gain = rng.roll(1, 10)
            setPlayer(p copy {level: p.level + 1, hp: p.hp + gain, maxHp: p.maxHp + gain})
            say("Welcome to level " + (p.level + 1) + ".")
            recur(need * 2)
        }
    }
    val threshold = fn(level:num, need:num):num {
        if (level == player.level) { need } else { recur(level + 1, need * 2) }
    }
    up(threshold(1, 10))
}

// Distances from the player over passable squares, by the step rule,
// keyed y * WIDTH + x; monsters do not block.
val distances = fn():map {
    val p = player
    val go = fn(queue:list, head:num, dist:map):map {
        if (head == len(queue)) {
            dist
        } else {
            val c = queue[head]
            val x = c % level.WIDTH
            val y = (c - x) / level.WIDTH
            val d = dist[c] + 1
            val each = fn(i:num, q:list, dist:map):list {
                if (i == 8) {
                    [q, dist]
                } else {
                    val dx = ORDER[i][0]
                    val dy = ORDER[i][1]
                    val k = (y + dy) * level.WIDTH + x + dx
                    if (stepOk(x, y, dx, dy) && dist[k] == nil) {
                        recur(i + 1, q :+ k, dist + {[k]: d})
                    } else {
                        recur(i + 1, q, dist)
                    }
                }
            }
            match each(0, queue, dist) {
                [q, nd] => recur(q, head + 1, nd)
            }
        }
    }
    val start = p.y * level.WIDTH + p.x
    go([start], 0, {[start]: 0})
}

// Whether a monster at (x, y) is near the player: next to them, or in the
// room the player is in.
val near = fn(x:num, y:num):bool {
    val p = player
    val room = roomAt(p.x, p.y)
    (x - p.x >= -1 && x - p.x <= 1 && y - p.y >= -1 && y - p.y <= 1)
        || (room != nil && x >= room.x && x < room.x + room.w && y >= room.y && y < room.y + room.h)
}

// Whether (x, y) is free for a monster to step to: no monster and not the
// player.
val openFor = fn(x:num, y:num):bool {
    indexAt(site().monsters, x, y) < 0 && !playerAt(x, y)
}

// The pack entries a nymph can steal: everything not wielded or worn.
val stealable = fn():list {
    val p = player
    val go = fn(i:num, acc:list):list {
        if (i == len(player.pack)) {
            acc
        } else {
            val e = player.pack[i]
            recur(i + 1, if (e.letter != p.weapon && e.letter != p.armour) { acc :+ e } else { acc })
        }
    }
    go(0, [])
}

// Monster i attacks the player. Returns whether it is still on the level.
val monsterAttack = fn(i:num):bool {
    val m = site().monsters[i]
    val kind = kindOf(m)
    val p = player
    if (hits(kind.level, 0, armourTotal())) {
        val damage = rng.roll(kind.damage[0], kind.damage[1])
        setPlayer(p copy {hp: p.hp - damage})
        say("The " + kind.name + " hits you.")
        val loot = stealable()
        if (player.hp <= 0) {
            die("Killed by the " + kind.name)
            true
        } else if (hasFlag(m, "stealsGold") && player.gold > 0) {
            val take = rng.below(50 + 10 * player.depth) + 2
            val gold = player.gold
            setPlayer(player copy {gold: if (take < gold) { gold - take } else { 0 }})
            removeMonster(i)
            say("Your purse feels lighter.")
            false
        } else if (hasFlag(m, "stealsItem") && len(loot) > 0) {
            val e = loot[rng.below(len(loot))]
            removeEntry(e.letter)
            removeMonster(i)
            say("The " + kind.name + " stole " + nameOf(e.item, e.count) + "!")
            false
        } else {
            true
        }
    } else {
        say("The " + kind.name + " misses.")
        true
    }
}

// Monster i's action. `dist` gives the distances when already computed.
// Returns [still on the level, distances or nil].
val monsterAct = fn(i:num, dist:map|nil):list {
    val m0 = site().monsters[i]
    val m = if (hasFlag(m0, "regenerates") && m0.hp < m0.maxHp) { m0 copy {hp: m0.hp + 1} } else { m0 }
    setMonster(i, m)
    val p = player
    if (m.state == "asleep") {
        if (!hasFlag(m, "still") && near(m.x, m.y) && (hasFlag(m, "mean") || rng.below(3) == 0)) {
            setMonster(i, m copy {state: "awake"})
        }
        [true, dist]
    } else if (hasFlag(m, "still")) {
        [true, dist]
    } else if (hasFlag(m, "flies") && rng.below(2) == 0) {
        val d = ORDER[rng.below(8)]
        if (stepOk(m.x, m.y, d[0], d[1]) && openFor(m.x + d[0], m.y + d[1])) {
            setMonster(i, m copy {x: m.x + d[0], y: m.y + d[1]})
        }
        [true, dist]
    } else {
        val dx = p.x - m.x
        val dy = p.y - m.y
        if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1 && stepOk(m.x, m.y, dx, dy)) {
            [monsterAttack(i), dist]
        } else {
            val ds = dist ?? distances()
            val start = ds[m.y * level.WIDTH + m.x]
            // The first direction, in ORDER, to the open square nearest the player.
            val best = fn(j:num, choice:list|nil, bestD:num):list|nil {
                if (j == 8) {
                    choice
                } else {
                    val d = ORDER[j]
                    val nd = ds[(m.y + d[1]) * level.WIDTH + m.x + d[0]]
                    if (nd != nil && nd < bestD && stepOk(m.x, m.y, d[0], d[1]) && openFor(m.x + d[0], m.y + d[1])) {
                        recur(j + 1, d, nd)
                    } else {
                        recur(j + 1, choice, bestD)
                    }
                }
            }
            if (start != nil) {
                match best(0, nil, start) {
                    [sx, sy] => setMonster(i, m copy {x: m.x + sx, y: m.y + sy})
                    _ => nil
                }
            }
            [true, ds]
        }
    }
}

// Every monster acts, in list order, until the player dies.
// The id of the living player nearest monster `m` in the acting player's
// chunk, counting diagonal steps as one, the first by id on a tie; nil when
// none is left.
val nearest = fn(m:map):str|nil {
    val company = companyIn(playerKey())
    val go = fn(i:num, best:str|nil, bestD:num):str|nil {
        if (i == len(company)) { return best }
        val p = company[i][1]
        val d = math.max(math.abs(p.x - m.x), math.abs(p.y - m.y))
        if (d < bestD) { recur(i + 1, company[i][0], d) } else { recur(i + 1, best, bestD) }
    }
    go(0, nil, 1000000)
}

// Every monster in the acting player's chunk acts, in list order, against
// the nearest living player, as that player; until no one there is alive.
// Distances are kept per player.
val monstersAct = fn() {
    val go = fn(i:num, dists:map) {
        if (i < len(site().monsters)) {
            match nearest(site().monsters[i]) {
                id: str => {
                    match actAs(id, fn() { monsterAct(i, dists[id]) }) {
                        [true, ds] => recur(i + 1, dists + {[id]: ds})
                        [_, ds] => recur(i, dists + {[id]: ds})
                    }
                }
                _ => nil
            }
        }
    }
    go(0, {})
}

// ---------------------------------------------------------------------------
// Turns.

// The player's upkeep at the end of a turn: hunger, healing, and the
// confusion and blindness timers.
val upkeep = fn() {
    val p0 = player
    val food = p0.food - 1
    setPlayer(p0 copy {food: food})
    if (food == 150) { say("You are starting to get hungry.") }
    if (food == 50) { say("You are starting to feel weak.") }
    if (food <= STARVED) {
        die("Starved to death")
    } else {
        if (food <= 0 && player.frozen == 0 && rng.below(5) == 0) {
            setPlayer(player copy {frozen: player.frozen + rng.below(8) + 4})
            say("You faint from lack of food.")
        }
        val p = player
        val every = if (21 - 2 * p.level < 3) { 3 } else { 21 - 2 * p.level }
        if (p.hp < p.maxHp) {
            if (p.regen + 1 >= every) {
                setPlayer(p copy {hp: p.hp + 1, regen: 0})
            } else {
                setPlayer(p copy {regen: p.regen + 1})
            }
        } else {
            setPlayer(p copy {regen: 0})
        }
        val q = player
        if (q.confused > 0) {
            setPlayer(q copy {confused: q.confused - 1})
            if (q.confused == 1) { say("You feel less confused now.") }
        }
        val r = player
        if (r.blind > 0) {
            setPlayer(r copy {blind: r.blind - 1})
            if (r.blind == 1) { say("The darkness lifts.") }
        }
    }
}

// Ends a turn: the player's action has happened; the monsters act, the
// player's upkeep happens, the turn is counted, and the player looks around.
// In a `tick`, the world's turn waits for the end of the tick, so this only
// notes that the player spent theirs.
val endTurn = fn() {
    if (ticking) {
        spent = true
    } else {
        monstersAct()
        if (!player.dead) { upkeep() }
        world = world copy {turn: world.turn + 1}
        markSeen()
        see()
    }
}

// Turns that pass with the player frozen, until the player thaws or dies.
val thaw = fn() {
    val p = player
    if (p.frozen > 0 && !player.dead) {
        setPlayer(p copy {frozen: p.frozen - 1})
        endTurn()
        recur()
    }
}

// The player attacks monster i.
val attack = fn(i:num) {
    val m = site().monsters[i] copy {state: "awake"}
    setMonster(i, m)
    val kind = kindOf(m)
    val p = player
    val w = packIndex(p.weapon)
    val dice = if (w < 0) { [1, 2] } else { data.weapons[player.pack[w].item.type].damage }
    val bonus = if (w < 0) { 0 } else { player.pack[w].item.bonus }
    if (hits(p.level, strengthHit(p.str) + bonus, kind.armour)) {
        val roll = rng.roll(dice[0], dice[1]) + bonus + strengthDamage(p.str)
        val damage = if (roll < 0) { 0 } else { roll }
        if (m.hp - damage <= 0) {
            removeMonster(i)
            say("You defeat the " + kind.name + ".")
            gainXp(kind.xp)
        } else {
            setMonster(i, m copy {hp: m.hp - damage})
            say("You hit the " + kind.name + ".")
        }
    } else {
        say("You miss the " + kind.name + ".")
    }
    if (hasFlag(m, "paralyses") && p.blind == 0 && indexAt(site().monsters, m.x, m.y) >= 0) {
        say("You are frozen by the " + kind.name + "'s gaze!")
        setPlayer(player copy {frozen: player.frozen + rng.below(4) + 2})
    }
}

// Moves one square, picking up what is there, or attacks the monster there.
// Returns whether the player moved.
val step = fn(dx:num, dy:num):bool {
    val p = player
    if (!inBounds(p.x + dx, p.y + dy)) {
        cross(dx, dy)
    } else if (!stepOk(p.x, p.y, dx, dy) || playerAt(p.x + dx, p.y + dy)) {
        false
    } else {
        val i = indexAt(site().monsters, p.x + dx, p.y + dy)
        if (i >= 0) {
            attack(i)
            endTurn()
            false
        } else {
            setPlayer(p copy {x: p.x + dx, y: p.y + dy})
            pickUp()
            endTurn()
            true
        }
    }
}

// Steps off the map's edge into the next chunk: only straight across, from
// an opening to the matching one, and only when no one stands there.
// Returns whether the player moved.
val cross = fn(dx:num, dy:num):bool {
    val p = player
    val x = p.x + dx
    val y = p.y + dy
    val cx = p.cx + if (x < 0) { -1 } else if (x >= level.WIDTH) { 1 } else { 0 }
    val cy = p.cy + if (y < 0) { -1 } else if (y >= level.HEIGHT) { 1 } else { 0 }
    val nx = (x + level.WIDTH) % level.WIDTH
    val ny = (y + level.HEIGHT) % level.HEIGHT
    if (dx != 0 && dy != 0) { return false }
    val next = chunk(cx, cy, p.depth)
    val blocked = indexAt(next.monsters, nx, ny) >= 0 || playerIn(chunkKey(cx, cy, p.depth), nx, ny)
    if (!contains(PASSABLE, next.map[ny][nx]) || blocked) { return false }
    enter(cx, cy, p.depth, fn(lv) { {x: nx, y: ny} })
    pickUp()
    endTurn()
    true
}

val monsterVisible = fn():bool {
    val go = fn(i:num):bool {
        if (i == len(site().monsters)) {
            false
        } else if (canSee(site().monsters[i].x, site().monsters[i].y)) {
            true
        } else {
            recur(i + 1)
        }
    }
    go(0)
}

// Runs: moves until a move is impossible, or until, after a move, the
// player stands on a door, the stairs, or an item, can see a monster, has a
// message, or is dead. Running never attacks.
val run = fn(dx:num, dy:num) {
    val p = player
    if (indexAt(site().monsters, p.x + dx, p.y + dy) < 0 && step(dx, dy)) {
        val q = player
        val ground = terrain(q.x, q.y)
        val stop = ground == level.DOOR || ground == level.STAIRS || ground == level.UP || indexAt(site().items, q.x, q.y) >= 0
            || monsterVisible() || len(player.messages) > 0 || player.dead
        if (!stop) {
            // In a tick, running takes one step a tick; `keepRunning` goes on.
            if (ticking) { player = player copy {running: [dx, dy]} } else { recur(dx, dy) }
        }
    }
}

// In a tick, another step of a run, unless a monster has come into view.
val keepRunning = fn() {
    match player.running {
        [dx, dy] => {
            player = player copy {running: nil}
            if (!monsterVisible()) { run(dx, dy) }
        }
        _ => nil
    }
}

// Takes the stairs the player stands on: down to the chunk below, arriving
// on its stairs up, or up to the chunk above, arriving on its stairs down.
val takeStairs = fn() {
    val p = player
    val ground = terrain(p.x, p.y)
    if (ground == level.STAIRS) {
        enter(p.cx, p.cy, p.depth + 1, fn(lv) { lv.up })
        if (ticking) { spent = true } else { world = world copy {turn: world.turn + 1} }
    } else if (ground == level.UP) {
        enter(p.cx, p.cy, p.depth - 1, fn(lv) { lv.down })
        if (ticking) { spent = true } else { world = world copy {turn: world.turn + 1} }
    } else {
        say("There are no stairs here.")
    }
}

// ---------------------------------------------------------------------------
// Item commands.

val quaff = fn(type:num) {
    val name = data.potions[type].name
    val p = player
    if (name == "healing") {
        val hp = p.hp + rng.roll(p.level, 4)
        setPlayer(if (hp > p.maxHp) { p copy {hp: p.maxHp + 1, maxHp: p.maxHp + 1} } else { p copy {hp: hp} })
        say("You begin to feel better.")
    } else if (name == "poison") {
        val str = p.str - (rng.below(3) + 1)
        setPlayer(p copy {str: if (str < 3) { 3 } else { str }})
        say("You feel very sick now.")
    } else if (name == "confusion") {
        setPlayer(p copy {confused: p.confused + rng.below(8) + 8})
        say("Wait, what's going on here?")
    } else if (name == "blindness") {
        setPlayer(p copy {blind: p.blind + rng.below(50) + 50})
        say("A cloak of darkness falls around you.")
    } else if (name == "gain strength") {
        setPlayer(p copy {str: p.str + 1, maxStr: if (p.str + 1 > p.maxStr) { p.str + 1 } else { p.maxStr }})
        say("You feel stronger.")
    } else if (len(site().monsters) > 0) {
        player = player copy {sense: true}
        say("You sense the presence of monsters.")
    } else {
        say("You have a strange feeling for a moment.")
    }
}

val read = fn(type:num) {
    val name = data.scrolls[type].name
    val p = player
    if (name == "identify") {
        val find = fn(i:num):num {
            if (i == len(player.pack)) {
                -1
            } else if (!identified(player.pack[i].item)) {
                i
            } else {
                recur(i + 1)
            }
        }
        val i = find(0)
        if (i < 0) {
            say("You have nothing to identify.")
        } else {
            val item = player.pack[i].item
            val known = player.known
            player = player copy {
                known: if (item.kind == "potion") {
                    known copy {potions: known.potions :+ item.type}
                } else {
                    known copy {scrolls: known.scrolls :+ item.type}
                },
            }
            say(packLine(player.pack[i]))
        }
    } else if (name == "teleportation") {
        val spot = level.freeSpot(site())
        setPlayer(p copy {x: spot.x, y: spot.y})
        say("You are somewhere else.")
    } else if (name == "magic mapping") {
        val row = fn(y:num, rows:list):list {
            if (y == level.HEIGHT) {
                rows
            } else {
                val mapped = fn(x:num, acc:str):str {
                    if (x == level.WIDTH) {
                        acc
                    } else {
                        val c = if (memory()[y][x] == level.BLANK) { site().map[y][x] } else { memory()[y][x] }
                        recur(x + 1, acc + c)
                    }
                }
                recur(y + 1, rows :+ mapped(0, ""))
            }
        }
        setMemory(row(0, []))
        say("A map forms in your mind.")
    } else if (name == "enchant weapon") {
        val i = packIndex(p.weapon)
        if (i < 0) {
            say("Your hands tingle.")
        } else {
            val e = player.pack[i]
            setEntry(e.letter, e copy {item: e.item copy {bonus: e.item.bonus + 1}})
            say("Your " + data.weapons[e.item.type].name + " glows blue for a moment.")
        }
    } else {
        val i = packIndex(p.armour)
        if (i < 0) {
            say("Your skin crawls.")
        } else {
            val e = player.pack[i]
            setEntry(e.letter, e copy {item: e.item copy {bonus: e.item.bonus + 1}})
            say("Your " + data.armours[e.item.type].name + " glows silver for a moment.")
        }
    }
}

// Carries out item command `c` on the pack entry with `letter`.
val useItem = fn(c:str, letter:str) {
    match ITEM_COMMANDS[c] {
        spec: struct<ItemCommand> => useWith(spec, c, letter)
        _ => nil
    }
}

val useWith = fn(spec:struct<ItemCommand>, c:str, letter:str) {
    val i = packIndex(letter)
    val p = player
    if (i < 0) {
        say("You have no item " + letter + ".")
    } else if (spec.kind != nil && player.pack[i].item.kind != spec.kind) {
        say(spec.wrong)
    } else {
        val e = player.pack[i]
        match c {
            "e" => {
                takeOne(letter)
                val start = if (p.food < 0) { 0 } else { p.food }
                val food = start + 1100 + rng.below(400)
                setPlayer(player copy {food: if (food > FOOD_MAX) { FOOD_MAX } else { food }})
                say("Yum, that tasted good.")
                endTurn()
            }
            "q" => {
                takeOne(letter)
                player = player copy {known: player.known copy {potions: if (contains(player.known.potions, e.item.type)) { player.known.potions } else { player.known.potions :+ e.item.type }}}
                quaff(e.item.type)
                endTurn()
            }
            "r" => {
                takeOne(letter)
                player = player copy {known: player.known copy {scrolls: if (contains(player.known.scrolls, e.item.type)) { player.known.scrolls } else { player.known.scrolls :+ e.item.type }}}
                read(e.item.type)
                endTurn()
            }
            "w" => {
                if (p.weapon == letter) {
                    say("You are already wielding that.")
                } else {
                    setPlayer(p copy {weapon: letter})
                    say("You are now wielding " + nameOf(e.item, 1) + ".")
                    endTurn()
                }
            }
            "a" => {
                if (p.armour == letter) {
                    setPlayer(p copy {armour: nil})
                    say("You took off " + nameOf(e.item, 1) + ".")
                    endTurn()
                } else if (p.armour != nil) {
                    say("You are already wearing armour.")
                } else {
                    setPlayer(p copy {armour: letter})
                    say("You are now wearing " + nameOf(e.item, 1) + ".")
                    endTurn()
                }
            }
            _ => {
                if (p.armour == letter) {
                    say("You can't drop armour you are wearing.")
                } else if (indexAt(site().items, p.x, p.y) >= 0 || terrain(p.x, p.y) == level.STAIRS || terrain(p.x, p.y) == level.UP) {
                    say("There is no room to drop that here.")
                } else {
                    takeOne(letter)
                    setHere(site() copy {items: site().items :+ {x: p.x, y: p.y, item: e.item, dropped: true}})
                    say("Dropped " + nameOf(e.item, 1) + ".")
                    endTurn()
                }
            }
        }
    }
}

// Starts item command `c`: asks which item, unless there is nothing to use.
val askItem = fn(c:str) {
    match ITEM_COMMANDS[c] {
        spec: struct<ItemCommand> => askWith(spec, c)
        _ => nil
    }
}

val askWith = fn(spec:struct<ItemCommand>, c:str) {
    val any = fn(i:num):bool {
        if (i == len(player.pack)) {
            false
        } else if (spec.kind == nil || player.pack[i].item.kind == spec.kind) {
            true
        } else {
            recur(i + 1)
        }
    }
    if (c == "r" && player.blind > 0) {
        say("You can't see to read.")
    } else if (!any(0)) {
        say(spec.nothing)
    } else {
        val question = spec.verb + " which item? (space to cancel)"
        player = player copy {prompt: c, question: question}
        say(question)
    }
}

// ---------------------------------------------------------------------------
// Commands.

/**
 * Splits messages into the page shown now and the rest: all of them if they
 * fit in 80 columns joined by two spaces, or else the most that fit with
 * " --More--" after them (at least one).
 */
val paginate = fn(messages:list):list {
    val width = fn(n:num):num { len(string.join(messages[:n], "  ")) }
    if (width(len(messages)) <= 80) {
        [messages, []]
    } else {
        val fit = fn(n:num):num {
            if (n < len(messages) && width(n + 1) + 9 <= 80) { recur(n + 1) } else { n }
        }
        val n = fit(1)
        [messages[:n], messages[n:]]
    }
}

val showMessages = fn(messages:list) {
    match paginate(messages) {
        [shown, more] => player = player copy {messages: shown, more: more}
    }
}

// After a command: outside a tick, the turns the player spends frozen, and
// the messages paged to fit the top line. A tick does neither.
val finish = fn() {
    if (!ticking) {
        thaw()
        showMessages(player.messages)
    }
}

// Carries out one command key for the acting player; see `command`.
val perform = fn(key:str, shift:bool) {
    player = player copy {running: nil}
    if (len(player.more) > 0) {
        if (key == "space") { showMessages(player.more) }
    } else if (player.dead) {
        if (key == "enter") { newCharacter() }
    } else if (player.showingPack) {
        if (key == "space") { player = player copy {showingPack: false, messages: []} }
    } else if (player.prompt != nil) {
        val c = player.prompt
        if (key == "space") {
            player = player copy {prompt: nil, messages: []}
        } else if (len(key) == 1) {
            player = player copy {prompt: nil, messages: []}
            useItem(c, key)
            finish()
        }
    } else {
        val direction = DIRECTIONS[key]
        val known = key == "space" || key == "enter" || key == "i" || direction != nil || ITEM_COMMANDS[key] != nil
        if (known) {
            player = player copy {messages: []}
            if (key == "space") {
                endTurn()
            } else if (key == "enter") {
                takeStairs()
            } else if (key == "i") {
                if (len(player.pack) == 0) {
                    say("You are empty-handed.")
                } else {
                    player = player copy {showingPack: true}
                    say("Press space to continue.")
                }
            } else if (direction != nil) {
                if (player.confused > 0) {
                    val d = ORDER[rng.below(8)]
                    step(d[0], d[1])
                } else {
                    match direction {
                        [dx, dy] => if (shift) { run(dx, dy) } else { step(dx, dy) }
                        _ => nil
                    }
                }
            } else {
                askItem(key)
            }
            finish()
        }
    }
}

// The acting player's screen; see `text`.
val screen = fn():list {
    val p = player
    val map = if (player.showingPack) {
        val lines = fn(i:num, rows:list):list {
            if (i == level.HEIGHT) {
                rows
            } else {
                recur(i + 1, rows :+ (if (i < len(player.pack)) { packLine(player.pack[i]) } else { "" }))
            }
        }
        lines(0, [])
    } else {
        val monsters = fn(i:num, rows:list):list {
            if (i == len(site().monsters)) {
                rows
            } else {
                val m = site().monsters[i]
                val shown = player.sense || canSee(m.x, m.y)
                recur(i + 1, if (shown) { write(rows, m.x, m.y, data.monsters[m.kind].letter) } else { rows })
            }
        }
        val company = companyIn(playerKey())
        val others = fn(i:num, rows:list):list {
            if (i == len(company)) {
                rows
            } else {
                val o = company[i][1]
                recur(i + 1, if (canSee(o.x, o.y)) { write(rows, o.x, o.y, "@") } else { rows })
            }
        }
        write(others(0, monsters(0, memory())), p.x, p.y, "@")
    }
    val hunger = if (p.food <= 0) { "  Faint" } else if (p.food <= 50) { "  Weak" } else if (p.food <= 150) { "  Hungry" } else { "" }
    val status = "Depth:" + player.depth + "  Gold:" + p.gold + "  Hp:" + p.hp + "(" + p.maxHp + ")  Str:" + p.str
        + "(" + p.maxStr + ")  Arm:" + armourTotal() + "  Exp:" + p.level + "/" + p.xp + hunger
    val more = if (len(player.more) > 0) { " --More--" } else { "" }
    [string.join(player.messages, "  ") + more] + map + [status]
}

// ---------------------------------------------------------------------------
// Players by id.

/**
 * Carries out one command key for the player with `id`: a letter, "space",
 * or "enter", with `shift` held or not, as the eval's task.md describes,
 * except that `enter` takes stairs up as well as down, and after death
 * starts a new character.
 */
export val command = fn(id:str, key:str, shift:bool) { actAs(id, fn() { perform(key, shift) }) }

/**
 * Advances the world by one tick. Each of `actions`, `{id, key, shift}` in
 * the order they arrived, at most one per player, is carried out as
 * `command` would, except that a frozen player's is dropped, and a run
 * takes one step a tick. Players in `present` (those playing now) with no
 * action carry on running, or lose a turn while frozen. Then, on every
 * `monsterEvery`-th tick, the monsters act once in each chunk with a living
 * present player; everyone who spent a turn has their upkeep, the turn is
 * counted, and everyone present looks around. Each present player's
 * messages are this tick's; none are paged.
 */
export val tick = fn(actions:list, present:list, monsterEvery:num = 4) {
    ticking = true
    val each = fn(ids:list, body:fn) {
        val go = fn(i:num) {
            if (i < len(ids)) {
                if (players[ids[i]] != nil) { actAs(ids[i], body) }
                recur(i + 1)
            }
        }
        go(0)
    }
    each(present, fn() { player = player copy {messages: [], more: []} })
    var timed = []
    var acted = []
    val doActions = fn(i:num) {
        if (i < len(actions)) {
            val a = actions[i]
            val free = players[a.id] != nil && !contains(acted, a.id)
                && (players[a.id].frozen == 0 || players[a.id].dead)
            if (free) {
                acted = acted :+ a.id
                actAs(a.id, fn() {
                    spent = false
                    perform(a.key, a.shift ?? false)
                    if (spent) { timed = timed :+ a.id }
                })
            }
            recur(i + 1)
        }
    }
    doActions(0)
    each(present, fn() {
        if (!contains(acted, acting) && !player.dead) {
            spent = false
            if (player.frozen > 0) {
                player = player copy {frozen: player.frozen - 1}
                spent = true
            } else {
                keepRunning()
            }
            if (spent) { timed = timed :+ acting }
        }
    })
    // The monsters of each chunk with a living present player, once each,
    // on their ticks.
    var chunks = []
    each(present, fn() {
        val key = playerKey()
        if (!player.dead && !contains(chunks, key)) {
            chunks = chunks :+ key
            markSeen()
            if (world.turn % monsterEvery == 0) { monstersAct() }
        }
    })
    each(timed, fn() { if (!player.dead) { upkeep() } })
    world = world copy {turn: world.turn + 1}
    each(present, fn() { if (!player.dead) { see() } })
    ticking = false
}

/**
 * The screen's 24 text rows for the player with `id`: messages, the map as
 * they know it (or their pack), and their status line. Other players they
 * can see are drawn as `@` too.
 */
export val text = fn(id:str):list { actAs(id, screen) }

/**
 * The chunk the player with `id` is in.
 */
export val here = fn(id:str):map { actAs(id, site) }

/**
 * Whether the player with `id` can see (x, y) in their chunk: never while
 * blind; otherwise when it is their square or one of its eight
 * neighbours, or they are in a lit room whose rectangle holds it.
 */
export val visible = fn(id:str, x:num, y:num):bool { actAs(id, fn() { canSee(x, y) }) }

/**
 * The armour of the player with `id`: the worn armour's value plus its
 * bonus, or 0.
 */
export val armourValue = fn(id:str):num { actAs(id, armourTotal) }

/**
 * The name of `count` of `item`, as the player with `id` knows it.
 */
export val itemName = fn(id:str, item:map, count:num):str { actAs(id, fn() { nameOf(item, count) }) }

/**
 * The living players in the chunk the player with `id` is in, other than
 * them, as [id, player] pairs in id order.
 */
export val others = fn(id:str):list {
    actAs(id, fn() {
        val company = companyIn(playerKey())
        val go = fn(i:num, acc:list):list {
            if (i == len(company)) { acc } else { recur(i + 1, if (company[i][0] == id) { acc } else { acc :+ company[i] }) }
        }
        go(0, [])
    })
}
