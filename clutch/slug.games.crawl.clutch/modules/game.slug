/**
 * The game: its state, the player's commands, and the text the screen shows.
 *
 * The state is a world and a player. The world is what every player would
 * share: its seed, the turn, item appearances, and the chunks generated so
 * far, each with its map, rooms, items, monsters, and stairs. The player is
 * everything that is one person's own: the chunk they are in and their
 * place in it, stats, pack, what they have identified, what they remember
 * of each chunk, and their messages, prompt, and whether they are dead.
 *
 * Players who walk into each other meet: a menu opens, to say something
 * from a list of phrases or give the other an item or gold. Players can
 * also say what they type, and everyone who can see them hears it.
 *
 * Monsters live in populations that breed, die off and move from chunk to
 * chunk while no one is there (`slug.games.crawl.region`), so a chunk
 * cleared fills again in time, from its neighbours as well as its own.
 *
 * Factions of the peoples above and below hold the land, a region at a band
 * of depths, and fight over it (`slug.games.crawl.empire`): their peoples'
 * monsters thrive where they hold it, players' kills weaken them, and
 * their nature sets prices and the bounties forts pay.
 *
 * A new world can live through years of history before anyone comes, and
 * settlements that fell are ruins: broken walls, no one there, and a richer
 * dungeon below.
 *
 * The surface has towns and forts (`slug.games.crawl.town`), whose people,
 * characters, stand in place: walking into one opens their menu, to buy and
 * sell, eat, rest, hear a rumour, or talk.
 *
 * A player starts, and after dying starts again as a new character, in the
 * streets of the town nearest the middle of the world; the world carries
 * on.
 */
val data = import("slug.games.crawl.data")
val bestiary = import("slug.games.crawl.bestiary")
val rng = import("slug.games.crawl.rng")
val level = import("slug.games.crawl.level")
val town = import("slug.games.crawl.town")
val region = import("slug.games.crawl.region")
val empire = import("slug.games.crawl.empire")
val lore = import("slug.games.crawl.lore")
val string = import("slug.string")
val math = import("slug.math")
val {map, filter, reduce, remove, range} = import("slug.std")

export val DIRECTIONS = {
    h: [-1, 0], j: [0, 1], k: [0, -1], l: [1, 0],
    y: [-1, -1], u: [1, -1], b: [-1, 1], n: [1, 1],
    left: [-1, 0], down: [0, 1], up: [0, -1], right: [1, 0],
}

// The eight directions in the order the rules try them.
val ORDER = [[-1, 0], [0, 1], [0, -1], [1, 0], [-1, -1], [1, -1], [-1, 1], [1, 1]]

val GLYPHS = {gold: "*", potion: "!", scroll: "?", food: ":", weapon: ")", armour: "]"}

val PASSABLE = [level.FLOOR, level.CORRIDOR, level.DOOR, level.STAIRS, level.UP, level.SCRUB, level.TREE, level.ROAD]

// Players start on the surface in a chunk within SPAWN of the middle of the
// world on each axis.
val SPAWN = 2

// How many chunks across and down a world is, unless `newGame` is told.
val SIZE = 32

// How far a player sees outdoors in daylight: SIGHT columns across, and
// half as many rows, as rows are about twice as tall.
val SIGHT = 18

val LETTERS = "abcdefghijklmnopqrstuvwxyz"
val PACK_SIZE = 22

// Hunger: the food counter's start, its cap, and when the player starves.
val FOOD_START = 1300
val FOOD_MAX = 2000
val STARVED = -850

// Item commands: their prompt verb, the item kind they need (nil for any),
// and what they say when there is nothing to use or the item is wrong.
val ItemCommand = struct { verb:str, kind:str|nil, nothing:str, wrong:str }

val ITEM_COMMANDS = {
    e: ItemCommand {verb: "Eat", kind: "food", nothing: "You have nothing to eat.", wrong: "You can't eat that."},
    q: ItemCommand {verb: "Quaff", kind: "potion", nothing: "You have nothing to quaff.", wrong: "You can't quaff that."},
    r: ItemCommand {verb: "Read", kind: "scroll", nothing: "You have nothing to read.", wrong: "You can't read that."},
    w: ItemCommand {verb: "Wield", kind: "weapon", nothing: "You have nothing to wield.", wrong: "You can't wield that."},
    a: ItemCommand {verb: "Wear or take off", kind: "armour", nothing: "You have nothing to wear.", wrong: "You can't wear that."},
    d: ItemCommand {verb: "Drop", kind: nil, nothing: "You have nothing to drop.", wrong: ""},
}

var world = {}
var levels = {}
var players = {}

// The monsters of chunks not made yet, beside those that are, as counts by
// name (see `slug.games.crawl.region`), by chunk key.
var populations = {}

// The player acting now, loaded from `players` by `actAs`, and their id.
var player = {}
var acting:str|nil = nil

// Whether a `tick` is running, and whether the action it is carrying out
// spent the player's turn.
var ticking = false
var spent = false

// Whether the step being taken is part of a run, which stops at another
// player instead of meeting them.
var runStep = false

// What has changed since `changes` was last asked, for saving: chunk keys,
// player ids, and remembered chunks as [id, chunk key] by "id chunk key",
// each as a set, and the players whose memories were wiped.
var dirty = {levels: {}, players: {}, memories: {}, forgotten: {}, populations: {}}

val touchLevel = fn(key:str) { dirty = dirty copy {levels: dirty.levels + {[key]: true}} }

/**
 * The whole game: `world`, `levels` (the chunks generated so far, by
 * `chunkKey`), `players` by id, and `populations`, the monsters of chunks
 * beside them not generated yet, as counts.
 */
export val current = fn():map {
    val all = if (acting == nil) { players } else { players + {[acting]: player} }
    {world: world, levels: levels, players: all, populations: populations}
}

// Runs `body` as the player with `id`: the engine's rules all act on
// `player`, which holds them meanwhile and is saved back after. Nests, as
// when a monster attacks another player during someone's turn.
val actAs = fn(id:str, body:fn) {
    val outer = acting
    if (outer != nil) { players = players + {[outer]: player} }
    acting = id
    player = players[id]
    dirty = dirty copy {players: dirty.players + {[id]: true}}
    val result = body()
    players = players + {[id]: player}
    acting = outer
    if (outer != nil) { player = players[outer] }
    result
}

/**
 * The key of the chunk at (cx, cy) on `depth`, such as "0,-1,2".
 */
export val chunkKey = fn(cx:num, cy:num, depth:num):str { "" + cx + "," + cy + "," + depth }

val playerKey = fn():str { chunkKey(player.cx, player.cy, player.depth) }

// `a` divided by `b` > 0, rounded down, as chunk coordinates need.
val floorDiv = fn(a:num, b:num):num {
    if (a >= 0) { math.div(a, b) } else { -math.div(-a - 1, b) - 1 }
}

// The chunk the acting player is in.
val site = fn():map { levels[playerKey()] }

val setHere = fn(lv:map) {
    levels = levels + {[playerKey()]: lv}
    touchLevel(playerKey())
}

// A chunk no one remembers anything of.
val BLANK_ROWS = (fn(i:num, rows:list):list {
    if (i == level.HEIGHT) { rows } else { recur(i + 1, rows :+ (level.BLANK * level.WIDTH)) }
})(0, [])

// Sets what the acting player remembers of the chunk with `key`.
val remember = fn(key:str, rows:list) {
    if (player.memory[key] != rows) {
        player = player copy {memory: player.memory + {[key]: rows}}
        dirty = dirty copy {memories: dirty.memories + {[(acting ?? "") + " " + key]: [acting, key]}}
    }
}

// What the player remembers of the chunk they are in, as its rows.
val memory = fn():list { player.memory[playerKey()] ?? BLANK_ROWS }

val setMemory = fn(rows:list) { remember(playerKey(), rows) }

// The living players in the chunk with `key`, the acting player among them,
// as [id, player] pairs in id order.
val companyIn = fn(key:str):list {
    val ids = string.sort(keys(players))
    val go = fn(i:num, acc:list):list {
        if (i == len(ids)) { return acc }
        val id = ids[i]
        val p = if (id == acting) { player } else { players[id] }
        recur(i + 1, if (!p.dead && chunkKey(p.cx, p.cy, p.depth) == key) { acc :+ [id, p] } else { acc })
    }
    go(0, [])
}

// Whether a living player stands at (x, y) in the chunk with `key`.
val playerIn = fn(key:str, x:num, y:num):bool {
    val company = companyIn(key)
    val go = fn(i:num):bool {
        if (i == len(company)) { false } else if (company[i][1].x == x && company[i][1].y == y) { true } else { recur(i + 1) }
    }
    go(0)
}

val playerAt = fn(x:num, y:num):bool { playerIn(playerKey(), x, y) }

// The index of the character at (x, y) in the acting player's chunk, or -1.
val characterAt = fn(x:num, y:num):num { indexAt(site().characters ?? [], x, y) }

val contains = fn(xs:list, v):bool {
    val go = fn(i:num):bool {
        if (i == len(xs)) { false } else if (xs[i] == v) { true } else { recur(i + 1) }
    }
    go(0)
}

val write = fn(rows:list, x:num, y:num, text:str):list {
    val row = rows[y]
    rows[:y] + [row[:x] + text + row[x + len(text):]] + rows[y + 1:]
}

val inBounds = fn(x:num, y:num):bool {
    x >= 0 && x < level.WIDTH && y >= 0 && y < level.HEIGHT
}

val terrain = fn(x:num, y:num):str {
    if (inBounds(x, y)) { site().map[y][x] } else { level.BLANK }
}

val passable = fn(x:num, y:num):bool { contains(PASSABLE, terrain(x, y)) }

// The index of the first entry of `list` at (x, y), or -1.
val indexAt = fn(list:list, x:num, y:num):num {
    val go = fn(i:num):num {
        if (i == len(list)) {
            -1
        } else if (list[i].x == x && list[i].y == y) {
            i
        } else {
            recur(i + 1)
        }
    }
    go(0)
}

val say = fn(text:str) {
    player = player copy {messages: player.messages :+ text}
}

val setPlayer = fn(p:map) {
    player = p
}

// ---------------------------------------------------------------------------
// Items and the pack.

val sign = fn(n:num):str { if (n >= 0) { "+" + n } else { "" + n } }

val an = fn(word:str):str {
    if (contains(["a", "e", "i", "o", "u"], word[0])) { "an " + word } else { "a " + word }
}

val identified = fn(item:map):bool {
    match item.kind {
        "potion" => contains(player.known.potions, item.type)
        "scroll" => contains(player.known.scrolls, item.type)
        _ => true
    }
}

// The name of `count` of `item`, as messages and the inventory show it.
val nameOf = fn(item:map, count:num):str {
    val many = count > 1
    val n = "" + count + " "
    match item.kind {
        "food" => if (many) { n + "food rations" } else { "a food ration" }
        "weapon" => "a " + sign(item.bonus) + " " + data.weapons[item.type].name
        "armour" => sign(item.bonus) + " " + data.armours[item.type].name
        "potion" => {
            if (identified(item)) {
                val name = data.potions[item.type].name
                if (many) { n + "potions of " + name } else { "a potion of " + name }
            } else {
                val colour = world.colours[item.type]
                if (many) { n + colour + " potions" } else { an(colour + " potion") }
            }
        }
        "scroll" => {
            if (identified(item)) {
                val name = data.scrolls[item.type].name
                if (many) { n + "scrolls of " + name } else { "a scroll of " + name }
            } else {
                val title = "\"" + world.titles[item.type] + "\""
                if (many) { n + "scrolls titled " + title } else { "a scroll titled " + title }
            }
        }
        _ => item.kind
    }
}

// The index of the pack entry with `letter`, or -1.
val packIndex = fn(letter:str|nil):num {
    val go = fn(i:num):num {
        if (i == len(player.pack)) {
            -1
        } else if (player.pack[i].letter == letter) {
            i
        } else {
            recur(i + 1)
        }
    }
    go(0)
}

// A pack entry's inventory line.
val packLine = fn(e:map):str {
    val p = player
    val suffix = if (e.letter == p.weapon) {
        " (weapon in hand)"
    } else if (e.letter == p.armour) {
        " (being worn)"
    } else {
        ""
    }
    e.letter + ") " + nameOf(e.item, e.count) + suffix
}

val stacks = fn(a:map, b:map):bool {
    a.kind == b.kind && (a.kind == "food" || ((a.kind == "potion" || a.kind == "scroll") && a.type == b.type))
}

// Adds `item` to the pack: onto a stack it belongs to, or under the lowest
// free letter if the pack has room. Returns the letter, or nil when full.
val addToPack = fn(item:map):str|nil {
    val stack = fn(i:num):num {
        if (i == len(player.pack)) {
            -1
        } else if (stacks(player.pack[i].item, item)) {
            i
        } else {
            recur(i + 1)
        }
    }
    val s = stack(0)
    if (s >= 0) {
        val e = player.pack[s]
        player = player copy {pack: player.pack[:s] + [e copy {count: e.count + 1}] + player.pack[s + 1:]}
        e.letter
    } else if (len(player.pack) >= PACK_SIZE) {
        nil
    } else {
        val free = fn(i:num):str {
            if (packIndex(LETTERS[i]) < 0) { LETTERS[i] } else { recur(i + 1) }
        }
        val letter = free(0)
        // Keep the pack in letter order.
        val place = fn(i:num):num {
            if (i == len(player.pack) || player.pack[i].letter > letter) { i } else { recur(i + 1) }
        }
        val at = place(0)
        player = player copy {pack: player.pack[:at] + [{letter: letter, item: item, count: 1}] + player.pack[at:]}
        letter
    }
}

// Removes one item from the stack with `letter`, or the whole entry when it
// is the last; an entry that goes is no longer wielded or worn.
val takeOne = fn(letter:str) {
    val i = packIndex(letter)
    val e = player.pack[i]
    if (e.count > 1) {
        player = player copy {pack: player.pack[:i] + [e copy {count: e.count - 1}] + player.pack[i + 1:]}
    } else {
        removeEntry(letter)
    }
}

val removeEntry = fn(letter:str) {
    val i = packIndex(letter)
    player = player copy {pack: player.pack[:i] + player.pack[i + 1:]}
    val p = player
    setPlayer(p copy {
        weapon: if (p.weapon == letter) { nil } else { p.weapon },
        armour: if (p.armour == letter) { nil } else { p.armour },
    })
}

val setEntry = fn(letter:str, e:map) {
    val i = packIndex(letter)
    player = player copy {pack: player.pack[:i] + [e] + player.pack[i + 1:]}
}

// The player's armour: the worn armour's value plus its bonus, or 0.
val armourTotal = fn():num {
    val i = packIndex(player.armour)
    if (i < 0) {
        0
    } else {
        val item = player.pack[i].item
        data.armours[item.type].armour + item.bonus
    }
}

// Picks up whatever is on the player's square.
val pickUp = fn() {
    val p = player
    val i = indexAt(site().items, p.x, p.y)
    if (i >= 0) {
        val item = site().items[i].item
        if (item.kind == "gold") {
            setHere(site() copy {items: site().items[:i] + site().items[i + 1:]})
            setPlayer(player copy {gold: player.gold + item.amount})
            say("You found " + item.amount + " gold pieces.")
        } else {
            match addToPack(item) {
                letter: str => {
                    setHere(site() copy {items: site().items[:i] + site().items[i + 1:]})
                    say(packLine(player.pack[packIndex(letter)]))
                }
                _ => say("Your pack is full; you leave " + nameOf(item, 1) + ".")
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Seeing.

// The room whose rectangle, walls included, holds (x, y), or nil.
val roomAt = fn(x:num, y:num):map|nil {
    val go = fn(i:num):map|nil {
        if (i == len(site().rooms)) {
            nil
        } else {
            val r = site().rooms[i]
            if (!r.gone && x >= r.x && x < r.x + r.w && y >= r.y && y < r.y + r.h) { r } else { recur(i + 1) }
        }
    }
    go(0)
}

// Whether the acting player can see (x, y); see `visible`.
val canSee = fn(x:num, y:num):bool {
    val p = player
    val dx = x - p.x
    val dy = y - p.y
    if (p.blind > 0) {
        false
    } else if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1) {
        true
    } else if (site().outdoor == true) {
        outdoorSight()[viewKey(x, y)] == true
    } else {
        val room = roomAt(p.x, p.y)
        room != nil && !room.dark && x >= room.x && x < room.x + room.w && y >= room.y && y < room.y + room.h
    }
}

// Whether a square (dx, dy) from the player is near enough to see outdoors.
val inSight = fn(dx:num, dy:num):bool { dx * dx + 4 * dy * dy <= SIGHT * SIGHT }

// The terrain around player `p` outdoors, as a function of (x, y) in their
// chunk's coordinates, which run on into the chunks beside it: those chunks
// are generated if need be, and beyond the world's bounds is blank.
val around = fn(p:map):fn {
    val box = sightBox(p)
    val ox0 = floorDiv(box.left, level.WIDTH)
    val oy0 = floorDiv(box.top, level.HEIGHT)
    val nx = floorDiv(box.right, level.WIDTH) - ox0 + 1
    val ny = floorDiv(box.bottom, level.HEIGHT) - oy0 + 1
    val fetch = fn(i:num, acc:list):list {
        if (i == nx * ny) { return acc }
        val cx = p.cx + ox0 + i % nx
        val cy = p.cy + oy0 + math.div(i, nx)
        recur(i + 1, acc :+ (if (inWorld(cx, cy)) { chunk(cx, cy, p.depth).map } else { BLANK_ROWS }))
    }
    val maps = fetch(0, [])
    fn(x:num, y:num):str {
        val ox = floorDiv(x, level.WIDTH)
        val oy = floorDiv(y, level.HEIGHT)
        maps[(oy - oy0) * nx + ox - ox0][y - oy * level.HEIGHT][x - ox * level.WIDTH]
    }
}

// What each player saw outdoors when last asked, by id: `at`, where they
// stood, and `found`, what they saw from there. Outdoor terrain never
// changes, so sight depends only on where a player stands.
var sights = {}

// The squares the acting player sees outdoors, blind or not, as a map from
// `viewKey` to true: rays from the player to each square on the edge of
// their sight box, each going as far as they can see, through the squares
// next to them, and up to and including the first tree or rock.
val outdoorSight = fn():map {
    val p = player
    val stand = playerKey() + ":" + p.x + "," + p.y
    val id = acting ?? ""
    match sights[id] {
        last: map => if (last.at == stand) { return last.found }
        _ => nil
    }
    val at = around(p)
    var found = {}
    val ray = fn(x1:num, y1:num) {
        val dx = math.abs(x1 - p.x)
        val dy = -math.abs(y1 - p.y)
        val sx = if (p.x < x1) { 1 } else { -1 }
        val sy = if (p.y < y1) { 1 } else { -1 }
        val go = fn(x:num, y:num, err:num) {
            if (x == x1 && y == y1) { return nil }
            val e2 = 2 * err
            val nx = if (e2 >= dy) { x + sx } else { x }
            val ny = if (e2 <= dx) { y + sy } else { y }
            val near = nx - p.x >= -1 && nx - p.x <= 1 && ny - p.y >= -1 && ny - p.y <= 1
            if (near || inSight(nx - p.x, ny - p.y)) {
                found = found + {[viewKey(nx, ny)]: true}
                val c = at(nx, ny)
                if (!contains(level.OPAQUE, c)) {
                    recur(nx, ny, err + (if (e2 >= dy) { dy } else { 0 }) + (if (e2 <= dx) { dx } else { 0 }))
                }
            }
        }
        go(p.x, p.y, dx + dy)
    }
    val box = sightBox(p)
    val across = fn(x:num) {
        if (x <= box.right) { ray(x, box.top); ray(x, box.bottom); recur(x + 1) }
    }
    across(box.left)
    val down = fn(y:num) {
        if (y <= box.bottom) { ray(box.left, y); ray(box.right, y); recur(y + 1) }
    }
    down(box.top)
    found = found + {[viewKey(p.x, p.y)]: true}
    sights = sights + {[id]: {at: stand, found: found}}
    found
}

// What the player remembers at (x, y): the item there, or the terrain.
val sight = fn(x:num, y:num):str {
    val i = indexAt(site().items, x, y)
    if (i >= 0) { GLYPHS[site().items[i].item.kind] } else { terrain(x, y) }
}

// Records every visible square in the player's memory.
val see = fn() {
    if (site().outdoor == true) { return seeOutdoors() }
    var seen = memory()
    val look = fn(x:num, y:num) {
        if (inBounds(x, y)) { seen = write(seen, x, y, sight(x, y)) }
    }
    val p = player
    if (p.blind == 0) {
        val room = roomAt(p.x, p.y)
        if (room != nil && !room.dark) {
            val rows = fn(y:num) {
                if (y < room.y + room.h) {
                    val cols = fn(x:num) {
                        if (x < room.x + room.w) {
                            look(x, y)
                            recur(x + 1)
                        }
                    }
                    cols(room.x)
                    recur(y + 1)
                }
            }
            rows(room.y)
        }
        val around = fn(i:num) {
            if (i < 9) {
                look(p.x + i % 3 - 1, p.y + int(i / 3) - 1)
                recur(i + 1)
            }
        }
        around(0)
    }
    setMemory(seen)
}

// The box of squares (inclusive) that might be in sight outdoors, in the
// coordinates of player `p`'s chunk; it can reach into the chunks beside it.
val sightBox = fn(p:map):map {
    val half = math.div(SIGHT, 2)
    {top: p.y - half, bottom: p.y + half, left: p.x - SIGHT, right: p.x + SIGHT}
}

/**
 * The key `inView` gives square (x, y) in the coordinates of a player's
 * chunk, from one chunk before it to one chunk past it on each axis.
 */
export val viewKey = fn(x:num, y:num):num { (y + level.HEIGHT) * 3 * level.WIDTH + x + level.WIDTH }

// The squares the acting player can see, as a map from `viewKey` to true:
// what `canSee` says of each in their chunk, worked out at once, and
// outdoors the squares they see in the chunks beside it.
val inSightNow = fn():map {
    val p = player
    if (p.blind > 0) { return {} }
    if (site().outdoor == true) { return outdoorSight() }
    val alone = {top: p.y, bottom: p.y, left: p.x, right: p.x}
    val box = match roomAt(p.x, p.y) {
        room: map => if (room.dark) { alone } else {
            {top: room.y, bottom: room.y + room.h - 1, left: room.x, right: room.x + room.w - 1}
        }
        _ => alone
    }
    var found = {}
    val rows = fn(y:num) {
        if (y <= box.bottom) {
            val cols = fn(x:num) {
                if (x <= box.right) {
                    found = found + {[viewKey(x, y)]: true}
                    recur(x + 1)
                }
            }
            cols(box.left)
            recur(y + 1)
        }
    }
    rows(box.top)
    val next = fn(i:num) {
        if (i < 9) {
            val x = p.x + i % 3 - 1
            val y = p.y + int(i / 3) - 1
            if (inBounds(x, y)) { found = found + {[viewKey(x, y)]: true} }
            recur(i + 1)
        }
    }
    next(0)
    found
}

// Records every square the player can see outdoors in their memory, in
// their chunk and in the chunks beside it.
val seeOutdoors = fn() {
    val p = player
    if (p.blind > 0) { return nil }
    val box = sightBox(p)
    val visible = inSightNow()
    // The part of the box in the chunk (ox, oy) chunks from the player's.
    val record = fn(ox:num, oy:num) {
        val cx = p.cx + ox
        val cy = p.cy + oy
        if (!inWorld(cx, cy)) { return nil }
        val key = chunkKey(cx, cy, p.depth)
        val lv = chunk(cx, cy, p.depth)
        val rows = player.memory[key] ?? BLANK_ROWS
        val x0 = ox * level.WIDTH
        val y0 = oy * level.HEIGHT
        val top = math.max(box.top - y0, 0)
        val bottom = math.min(box.bottom - y0, level.HEIGHT - 1)
        val left = math.max(box.left - x0, 0)
        val right = math.min(box.right - x0, level.WIDTH - 1)
        val shown = fn(x:num, y:num):str {
            if (visible[viewKey(x0 + x, y0 + y)] == true) {
                val i = indexAt(lv.items, x, y)
                if (i >= 0) { GLYPHS[lv.items[i].item.kind] } else { lv.map[y][x] }
            } else {
                rows[y][x]
            }
        }
        val line = fn(y:num, x:num, out:str):str {
            if (x > right) { out } else { recur(y, x + 1, out + shown(x, y)) }
        }
        val go = fn(y:num, acc:list):list {
            if (y > bottom) { return acc }
            val row = rows[y]
            recur(y + 1, acc :+ (row[:left] + line(y, left, "") + row[right + 1:]))
        }
        remember(key, rows[:top] + go(top, []) + rows[bottom + 1:])
    }
    val ox0 = floorDiv(box.left, level.WIDTH)
    val oy0 = floorDiv(box.top, level.HEIGHT)
    val each = fn(oy:num, ox:num) {
        if (oy <= floorDiv(box.bottom, level.HEIGHT)) {
            if (ox > floorDiv(box.right, level.WIDTH)) {
                recur(oy + 1, ox0)
            } else {
                record(ox, oy)
                recur(oy, ox + 1)
            }
        }
    }
    each(oy0, ox0)
}

// Whether chunk (cx, cy) is inside the world's bounds.
val inWorld = fn(cx:num, cy:num):bool { level.inWorld(world.size ?? 0, cx, cy) }

// The settlement at chunk (cx, cy) on `depth`, or nil: settlements are all
// on the surface.
val settlementAt = fn(cx:num, cy:num, depth:num):map|nil {
    if (depth != 0) { return nil }
    val found = filter(world.settlements ?? [], fn(s) { s.cx == cx && s.cy == cy })
    if (len(found) == 0) { nil } else { found[0] }
}

// ---------------------------------------------------------------------------
// The region layer: monster populations as counts, visited a share at a
// tick. Chunks someone living is in are left to the dungeon.

// The chunks next to (cx, cy) on `depth`: across each edge, inside the
// world, and up and down the stairs, as [cx, cy, depth].
val neighbours = fn(cx:num, cy:num, depth:num):list {
    val across = filter([[cx - 1, cy, depth], [cx + 1, cy, depth], [cx, cy - 1, depth], [cx, cy + 1, depth]], fn(n) { inWorld(n[0], n[1]) })
    across + [[cx, cy, depth + 1]] + (if (depth > 0) { [[cx, cy, depth - 1]] } else { [] })
}

// The monster kinds that belong in chunk (cx, cy) on `depth`: those of its
// depth, as the faction holding the land has it (see `empire.habitatAt`).
val habitatOf = fn(cx:num, cy:num, depth:num):list {
    empire.habitatAt(world.empire ?? {holds: {}, factions: []}, empire.territoryOf(cx, cy, depth), level.habitat(depth))
}

// Whether monsters can live in chunk (cx, cy) on `depth`: anywhere but a
// settlement still standing.
val wild = fn(cx:num, cy:num, depth:num):bool {
    match settlementAt(cx, cy, depth) {
        s: map => s.kind == "ruin"
        _ => true
    }
}

// Gives the chunks beside (cx, cy) on `depth` that are not made and have
// no counts yet the monsters they start with.
val frontier = fn(cx:num, cy:num, depth:num) {
    map(neighbours(cx, cy, depth), fn(n) {
        val [ncx, ncy, nd] = n
        val key = chunkKey(ncx, ncy, nd)
        if (levels[key] == nil && populations[key] == nil && wild(ncx, ncy, nd)) {
            val counts = rng.within(rng.mix([world.seed, 52, ncx, ncy, nd]), fn() { region.initial(nd, habitatOf(ncx, ncy, nd)) })
            populations = populations + {[key]: counts}
            dirty = dirty copy {populations: dirty.populations + {[key]: true}}
        }
    })
}

// Chunk `lv` with monsters to match `counts`: new ones asleep at free
// squares, and of a kind with too many, those asleep go first.
val withCounts = fn(lv:map, counts:map):map {
    val have = region.tally(lv.monsters)
    val names = string.sort(keys(have + counts))
    val adjust = fn(i:num, now:map):map {
        if (i == len(names)) { return now }
        val name = names[i]
        val want = counts[name] ?? 0
        val got = have[name] ?? 0
        val added = fn(k:num, l:map):map {
            if (k <= 0) { l } else { recur(k - 1, l copy {monsters: l.monsters :+ level.monsterIn(l, name)}) }
        }
        val removed = fn(k:num, l:map):map {
            if (k <= 0) { return l }
            val ofKind = filter(range(len(l.monsters)), fn(j) { bestiary.monsters[l.monsters[j].kind].name == name })
            val asleep = filter(ofKind, fn(j) { l.monsters[j].state == "asleep" })
            val pool = if (len(asleep) > 0) { asleep } else { ofKind }
            val j = pool[rng.below(len(pool))]
            recur(k - 1, l copy {monsters: l.monsters[:j] + l.monsters[j + 1:]})
        }
        recur(i + 1, if (want > got) { added(want - got, now) } else { removed(got - want, now) })
    }
    adjust(0, lv)
}

// Each chunk's turn in the region layer, from its coordinates: one of the
// `world.regionEvery` ticks of each round.
var slots = {}

val slotOf = fn(key:str):num {
    match slots[key] {
        n: num => n
        _ => {
            val [cx, cy, depth] = map(string.split(key, ","), fn(t) { string.toInt(t) ?? 0 })
            val n = rng.mix([cx, cy, depth, 54]) % (world.regionEvery ?? REGION_EVERY)
            slots = slots + {[key]: n}
            n
        }
    }
}

// Loose things the region layer keeps a chunk stocked with, at most.
val lootCap = fn(depth:num):num { if (depth == 0) { 2 } else { 6 } }

// The chunks with someone living in them, as a set of keys.
val occupied = fn():map {
    reduce(keys(players), {}, fn(acc, id) {
        val p = if (id == acting) { player } else { players[id] }
        if (p.dead) { acc } else { acc + {[chunkKey(p.cx, p.cy, p.depth)]: true} }
    })
}

// A monster of the kind called `name` that left (cx, cy) on `depth` goes to
// a neighbouring chunk no one is in, made or with counts, if there is one.
val moveOn = fn(name:str, cx:num, cy:num, depth:num, busy:map) {
    val ways = filter(neighbours(cx, cy, depth), fn(n) {
        val key = chunkKey(n[0], n[1], n[2])
        busy[key] == nil && wild(n[0], n[1], n[2]) && (levels[key] != nil || populations[key] != nil)
    })
    if (len(ways) == 0) { return nil }
    val [ncx, ncy, nd] = ways[rng.below(len(ways))]
    val key = chunkKey(ncx, ncy, nd)
    match levels[key] {
        lv: map => {
            levels = levels + {[key]: lv copy {monsters: lv.monsters :+ level.monsterIn(lv, name)}}
            touchLevel(key)
        }
        _ => {
            val counts = populations[key]
            populations = populations + {[key]: counts + {[name]: (counts[name] ?? 0) + 1}}
            dirty = dirty copy {populations: dirty.populations + {[key]: true}}
        }
    }
}

// The region layer's visit to the chunk with `key`; see `region.visit`.
val visitChunk = fn(key:str, busy:map) {
    val [cx, cy, depth] = map(string.split(key, ","), fn(t) { string.toInt(t) ?? 0 })
    if (!wild(cx, cy, depth)) { return nil }
    rng.within(rng.mix([world.seed, 51, world.turn, cx, cy, depth]), fn() {
        val habitat = habitatOf(cx, cy, depth)
        val cap = region.capacity(depth)
        match levels[key] {
            lv: map => {
                val before = region.tally(lv.monsters)
                val r = region.visit(before, habitat, cap)
                val loose = len(filter(lv.items, fn(i) { i.dropped != true }))
                val stocked = if (r.counts == before) { lv } else { withCounts(lv, r.counts) }
                val looted = if (r.loot && loose < lootCap(depth)) { stocked copy {items: stocked.items :+ level.lootIn(stocked, depth)} } else { stocked }
                if (r.counts != before || looted.items != lv.items) {
                    levels = levels + {[key]: looted}
                    touchLevel(key)
                }
                match r.leaving {
                    name: str => moveOn(name, cx, cy, depth, busy)
                    _ => nil
                }
            }
            _ => {
                val before = populations[key]
                val r = region.visit(before, habitat, cap)
                if (r.counts != before) {
                    populations = populations + {[key]: r.counts}
                    dirty = dirty copy {populations: dirty.populations + {[key]: true}}
                }
                match r.leaving {
                    name: str => moveOn(name, cx, cy, depth, busy)
                    _ => nil
                }
            }
        }
    })
}

// This tick's share of the region layer: the chunks whose turn it is, in
// key order, but those someone living is in.
val regionTick = fn() {
    val slot = world.turn % (world.regionEvery ?? REGION_EVERY)
    val busy = occupied()
    val due = string.sort(filter(keys(levels) + keys(populations), fn(k) { slotOf(k) == slot }))
    map(due, fn(k) { if (busy[k] == nil) { visitChunk(k, busy) } })
}

// Dungeon chunk `lv` at (cx, cy) on `depth`, richer for lying under a ruin:
// down to depth 3, what the fallen left behind lies about.
val underRuin = fn(lv:map, cx:num, cy:num, depth:num):map {
    val above = settlementAt(cx, cy, 0)
    if (depth == 0 || depth > 3 || above == nil || above.kind != "ruin") { return lv }
    rng.within(rng.mix([world.seed, 55, cx, cy, depth]), fn() {
        val more = fn(k:num, l:map):map {
            if (k == 0) { l } else { recur(k - 1, l copy {items: l.items :+ level.lootIn(l, depth + 2)}) }
        }
        more(5, lv)
    })
}

// The chunk at (cx, cy) on `depth`, generated the first time it is needed.
val chunk = fn(cx:num, cy:num, depth:num):map {
    val key = chunkKey(cx, cy, depth)
    match levels[key] {
        lv: map => lv
        _ => {
            val plain = level.generate(world.seed, cx, cy, depth, world.size ?? 0)
            val built = match settlementAt(cx, cy, depth) {
                s: map => town.build(world.seed, plain, s)
                _ => underRuin(plain, cx, cy, depth)
            }
            val lv = if (!wild(cx, cy, depth)) { built } else {
                match populations[key] {
                    counts: map => {
                        // Its monsters are those its counts say it has now.
                        populations = populations - key
                        dirty = dirty copy {populations: dirty.populations + {[key]: true}}
                        rng.within(rng.mix([world.seed, 53, cx, cy, depth]), fn() { withCounts(built, counts) })
                    }
                    _ => built
                }
            }
            levels = levels + {[key]: lv}
            touchLevel(key)
            frontier(cx, cy, depth)
            lv
        }
    }
}

// Puts the player in the chunk at (cx, cy) on `depth`, at the spot `place`
// gives for that chunk, and looks around.
val enter = fn(cx:num, cy:num, depth:num, place:fn) {
    val lv = chunk(cx, cy, depth)
    val spot = place(lv)
    val arriving = player.cx != cx || player.cy != cy || player.depth != depth
    val from = empire.territoryOf(player.cx, player.cy, player.depth)
    val to = empire.territoryOf(cx, cy, depth)
    player = player copy {cx: cx, cy: cy, depth: depth, x: spot.x, y: spot.y, sense: false}
    // Coming into new land, where it is and who holds it, in a world of
    // factions.
    val e = world.empire ?? {factions: []}
    val factions = len(e.factions) > 0
    if (arriving && factions && to != from) { say(lore.arriving(world.seed, e, to)) }
    match lv.place {
        p: map => if (arriving) {
            say("You come to " + p.name + ".")
            // What a settlement shows of its past.
            if (factions) {
                match lore.settlementPast(e, p.was ?? p.name, p.kind == "ruin") {
                    past: str => say(past)
                    _ => nil
                }
            }
        }
        _ => nil
    }
    see()
}


// A new character, at a random free spot in the streets of the start town.
val newCharacter = fn() {
    val name = player.name ?? "someone"
    val id = acting ?? ""
    val kept = filter(keys(dirty.memories), fn(k) { dirty.memories[k][0] != id })
    dirty = dirty copy {
        forgotten: dirty.forgotten + {[id]: true},
        memories: reduce(kept, {}, fn(acc, k) { acc + {[k]: dirty.memories[k]} }),
    }
    player = {
        name: name,
        cx: 0, cy: 0, depth: 1, x: 0, y: 0, hp: 12, maxHp: 12, str: 16, maxStr: 16, gold: 0, level: 1, xp: 0,
        weapon: "a", armour: "b", food: FOOD_START, regen: 0, frozen: 0, confused: 0, blind: 0,
        pack: [
            {letter: "a", item: {kind: "weapon", type: 0, bonus: 1}, count: 1},
            {letter: "b", item: {kind: "armour", type: 1, bonus: 1}, count: 1},
            {letter: "c", item: {kind: "food"}, count: 1},
        ],
        known: {potions: [], scrolls: []},
        memory: {},
        messages: ["Welcome! The dungeon lies below."],
        more: [],
        prompt: nil,
        menu: nil,
        showingPack: false,
        dead: false,
        sense: false,
    }
    // The first settlement is the town where everyone starts.
    val home = (world.settlements ?? [])[0]
    val middle = math.div(world.size ?? 0, 2)
    val cx = if (home != nil) { home.cx } else { middle + rng.below(2 * SPAWN + 1) - SPAWN }
    val cy = if (home != nil) { home.cy } else { middle + rng.below(2 * SPAWN + 1) - SPAWN }
    val key = chunkKey(cx, cy, 0)
    val free = fn(lv:map):map {
        val spot = if (lv.walls != nil) { insideSpot(lv) } else { level.freeSpot(lv) }
        if (playerIn(key, spot.x, spot.y)) { recur(lv) } else { spot }
    }
    enter(cx, cy, 0, free)
}

// A free square of street or yard inside settlement chunk `lv`'s walls.
val insideSpot = fn(lv:map):map {
    val w = lv.walls
    val x = w.left + 1 + rng.below(w.right - w.left - 1)
    val y = w.top + 1 + rng.below(w.bottom - w.top - 1)
    val c = lv.map[y][x]
    val open = (c == level.ROAD || c == level.FLOOR) && indexAt(lv.items, x, y) < 0 && indexAt(lv.characters, x, y) < 0
    // Not inside a building: open ground the walls' gates can reach.
    val street = c == level.ROAD || lv.place.kind == "fort"
    if (open && street) { {x: x, y: y} } else { recur(lv) }
}

/**
 * The game's snapshot: `current()`, with the generator's state as `rng`.
 */
export val snapshot = fn():map { current() + {rng: rng.getState()} }

/**
 * Continues the game a snapshot holds, exactly as it was saved.
 */
export val load = fn(saved:map) {
    rng.setState(saved.rng)
    // Worlds saved before there were settlements gain them; chunks already
    // made stay as they are.
    val placed = if (saved.world.settlements == nil) {
        saved.world + {settlements: town.place(saved.world.seed, saved.world.size ?? 0)}
    } else {
        saved.world
    }
    // And worlds saved before there were empires gain them.
    world = if (placed.empire == nil) {
        placed + {empire: rng.within(rng.mix([placed.seed, 60]), fn() { empire.create(placed.seed, placed.size ?? 0, placed.settlements) })}
    } else {
        placed
    }
    levels = saved.levels
    players = saved.players
    populations = saved.populations ?? {}
    slots = {}
    sights = {}
    player = {}
    acting = nil
    dirty = {levels: {}, players: {}, memories: {}, forgotten: {}, populations: {}}
}

// How many ticks pass between visits of the region layer to each chunk,
// and between steps of the empire layer, unless `newGame` is told
// otherwise.
val REGION_EVERY = 20
val EMPIRE_EVERY = 6000

/**
 * Starts a new world with `seed`, with no one in it yet. The region layer
 * visits each chunk no one is in once every `options.regionEvery` ticks
 * (default 20), where its monsters breed, die off and move on, and loot
 * turns up; and the empire layer takes a step, a season, every
 * `options.empireEvery` ticks (default 6000, 15 minutes at 150 ms a tick),
 * after `options.history` years (default 0) of history, four seasons
 * each, run before anyone comes, in which settlements may fall to the
 * peoples below and become ruins. The world is `options.size` chunks
 * across and down
 * (default 32), with towns and forts on its surface, and new characters
 * start in the town nearest its middle.
 */
export val newGame = fn(seed:num, options:map = {}) {
    rng.seed(seed)
    val colours = rng.shuffle(data.colours)
    val titles = rng.shuffle(data.titles)
    world = {
        seed: seed, turn: 0, colours: colours, titles: titles,
        regionEvery: options.regionEvery ?? REGION_EVERY, empireEvery: options.empireEvery ?? EMPIRE_EVERY,
        size: options.size ?? SIZE,
    }
    world = world + {settlements: town.place(seed, world.size)}
    world = world + {empire: rng.within(rng.mix([seed, 60]), fn() { empire.create(seed, world.size, world.settlements) })}
    // History: the empires run for `options.history` years before anyone
    // comes, and the settlements that fell are ruins.
    val seasons = 4 * (options.history ?? 0)
    val past = fn(e:map):map {
        if (e.step >= seasons) { return e }
        recur(rng.within(rng.mix([seed, 61, e.step]), fn() { empire.step(e, seed, true) }))
    }
    val made = past(world.empire)
    val fell = map(made.fallen, fn(f) { f.name })
    world = world + {
        empire: made,
        settlements: map(world.settlements, fn(s) {
            if (contains(fell, s.name)) { s + {kind: "ruin", was: s.kind} } else { s }
        }),
    }
    levels = {}
    players = {}
    populations = {}
    slots = {}
    player = {}
    acting = nil
    sights = {}
    dirty = {levels: {}, players: {}, memories: {}, forgotten: {}, populations: {}}
}

/**
 * What has changed since the game started, was loaded, or this was last
 * called, for saving it: the `world` and the generator's state `rng` as
 * they are now; the chunks that changed in `levels`, by key; the players
 * who did in `players`, by id and without their memories; what they
 * remember of the chunks whose memory changed in `memories`, as `{id, key,
 * rows}`; in `forgotten` the ids of players whose memories were wiped
 * first, by dying; and in `populations` the counts of chunks not made yet
 * that changed, by key, nil for those now made.
 */
export val changes = fn():map {
    val all = current()
    val result = {
        world: world,
        rng: rng.getState(),
        levels: reduce(keys(dirty.levels), {}, fn(acc, k) { acc + {[k]: levels[k]} }),
        players: reduce(keys(dirty.players), {}, fn(acc, id) { acc + {[id]: remove(all.players[id], "memory")} }),
        memories: map(keys(dirty.memories), fn(k) {
            val [id, key] = dirty.memories[k]
            {id: id, key: key, rows: all.players[id].memory[key]}
        }),
        forgotten: keys(dirty.forgotten),
        populations: reduce(keys(dirty.populations), {}, fn(acc, k) { acc + {[k]: populations[k]} }),
    }
    dirty = {levels: {}, players: {}, memories: {}, forgotten: {}, populations: {}}
    result
}

/**
 * Adds a player with `id`, called `name`, as a new character on the surface;
 * does nothing when `id` is already playing.
 */
export val join = fn(id:str, name:str) {
    if (players[id] == nil) {
        players = players + {[id]: {name: name}}
        actAs(id, newCharacter)
    }
}

/**
 * Whether a player with `id` has joined.
 */
export val playing = fn(id:str):bool { current().players[id] != nil }

/**
 * The player with `id`; throws an `Error` of type `crawl.player` when no
 * such player has joined.
 */
export val playerOf = fn(id:str):map {
    match current().players[id] {
        p: map => p
        _ => throw Error {type: "crawl.player", msg: "no player " + id}
    }
}

// ---------------------------------------------------------------------------
// Monsters and combat.

// Whether a step from (x, y) by (dx, dy) is allowed by the terrain: the
// target must be passable, and for a diagonal step so must both squares
// beside it.
val stepOk = fn(x:num, y:num, dx:num, dy:num):bool {
    passable(x + dx, y + dy) && (dx == 0 || dy == 0 || (passable(x + dx, y) && passable(x, y + dy)))
}

val kindOf = fn(m:map) { bestiary.monsters[m.kind] }

val hasFlag = fn(m:map, flag:str):bool { contains(kindOf(m).flags, flag) }

val setMonster = fn(i:num, m:map) {
    setHere(site() copy {monsters: site().monsters[:i] + [m] + site().monsters[i + 1:]})
}

val removeMonster = fn(i:num) {
    setHere(site() copy {monsters: site().monsters[:i] + site().monsters[i + 1:]})
}

// An attack roll: hits when below(20) + 1 + level + bonus >= 10 + armour.
val hits = fn(level:num, bonus:num, armour:num):bool {
    rng.below(20) + 1 + level + bonus >= 10 + armour
}

val strengthHit = fn(str:num):num {
    if (str >= 18) { 1 } else if (str <= 6) { -1 } else { 0 }
}

val strengthDamage = fn(str:num):num {
    if (str >= 18) { 2 } else if (str == 17) { 1 } else if (str <= 6) { -1 } else { 0 }
}

// A kill of a monster of the kind called `name`, if it belongs to a people:
// it weakens that people's faction where it happened, at the empire's next
// step, and counts towards the bounties posted for the region.
val counted = fn(name:str) {
    if (empire.peopleOf(name) == nil) { return nil }
    val p = player
    val territory = empire.territoryOf(p.cx, p.cy, p.depth)
    world = world copy {empire: empire.killed(world.empire, territory, name)}
    val [rx, ry, _] = string.split(territory, ",")
    val k = rx + "," + ry + "|" + name
    val kills = p.kills ?? {}
    setPlayer(p copy {kills: kills + {[k]: (kills[k] ?? 0) + 1}})
}

val die = fn(cause:str) {
    player = player copy {dead: true}
    say("You die.")
    say(cause + " on depth " + player.depth + ".")
    say("Press enter to start again.")
}

// Experience: each level from 2 needs 10, 20, 40, ... points; each level
// gained adds roll(1, 10) to hit points and their maximum.
val gainXp = fn(xp:num) {
    setPlayer(player copy {xp: player.xp + xp})
    val up = fn(need:num) {
        val p = player
        if (p.xp >= need) {
            val gain = rng.roll(1, 10)
            setPlayer(p copy {level: p.level + 1, hp: p.hp + gain, maxHp: p.maxHp + gain})
            say("Welcome to level " + (p.level + 1) + ".")
            recur(need * 2)
        }
    }
    val threshold = fn(level:num, need:num):num {
        if (level == player.level) { need } else { recur(level + 1, need * 2) }
    }
    up(threshold(1, 10))
}

// Distances from the player over passable squares, by the step rule,
// keyed y * WIDTH + x; monsters do not block.
val distances = fn():map {
    val p = player
    val go = fn(queue:list, head:num, dist:map):map {
        if (head == len(queue)) {
            dist
        } else {
            val c = queue[head]
            val x = c % level.WIDTH
            val y = (c - x) / level.WIDTH
            val d = dist[c] + 1
            val each = fn(i:num, q:list, dist:map):list {
                if (i == 8) {
                    [q, dist]
                } else {
                    val dx = ORDER[i][0]
                    val dy = ORDER[i][1]
                    val k = (y + dy) * level.WIDTH + x + dx
                    if (stepOk(x, y, dx, dy) && dist[k] == nil) {
                        recur(i + 1, q :+ k, dist + {[k]: d})
                    } else {
                        recur(i + 1, q, dist)
                    }
                }
            }
            match each(0, queue, dist) {
                [q, nd] => recur(q, head + 1, nd)
            }
        }
    }
    val start = p.y * level.WIDTH + p.x
    go([start], 0, {[start]: 0})
}

// Whether a monster at (x, y) is near the player: next to them, or in the
// room the player is in, or outdoors in their line of sight.
val near = fn(x:num, y:num):bool {
    val p = player
    if (site().outdoor == true) {
        val dx = x - p.x
        val dy = y - p.y
        return (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1) || outdoorSight()[viewKey(x, y)] == true
    }
    val room = roomAt(p.x, p.y)
    (x - p.x >= -1 && x - p.x <= 1 && y - p.y >= -1 && y - p.y <= 1)
        || (room != nil && x >= room.x && x < room.x + room.w && y >= room.y && y < room.y + room.h)
}

// Whether (x, y) is free for a monster to step to: no monster and not the
// player.
val openFor = fn(x:num, y:num):bool {
    indexAt(site().monsters, x, y) < 0 && !playerAt(x, y) && characterAt(x, y) < 0
}

// The pack entries a nymph can steal: everything not wielded or worn.
val stealable = fn():list {
    val p = player
    val go = fn(i:num, acc:list):list {
        if (i == len(player.pack)) {
            acc
        } else {
            val e = player.pack[i]
            recur(i + 1, if (e.letter != p.weapon && e.letter != p.armour) { acc :+ e } else { acc })
        }
    }
    go(0, [])
}

// Monster i attacks the player. Returns whether it is still on the level.
val monsterAttack = fn(i:num):bool {
    val m = site().monsters[i]
    val kind = kindOf(m)
    val p = player
    if (hits(kind.level, 0, armourTotal())) {
        val damage = rng.roll(kind.damage[0], kind.damage[1])
        setPlayer(p copy {hp: p.hp - damage})
        say("The " + kind.name + " hits you.")
        val loot = stealable()
        if (player.hp <= 0) {
            die("Killed by the " + kind.name)
            true
        } else if (hasFlag(m, "weakens") && player.str > 3 && rng.below(3) == 0) {
            setPlayer(player copy {str: player.str - 1})
            say("You feel weaker.")
            true
        } else if (hasFlag(m, "stealsGold") && player.gold > 0) {
            val take = rng.below(50 + 10 * player.depth) + 2
            val gold = player.gold
            setPlayer(player copy {gold: if (take < gold) { gold - take } else { 0 }})
            removeMonster(i)
            say("Your purse feels lighter.")
            false
        } else if (hasFlag(m, "stealsItem") && len(loot) > 0) {
            val e = loot[rng.below(len(loot))]
            removeEntry(e.letter)
            removeMonster(i)
            say("The " + kind.name + " stole " + nameOf(e.item, e.count) + "!")
            false
        } else {
            true
        }
    } else {
        say("The " + kind.name + " misses.")
        true
    }
}

// Monster i's action. `dist` gives the distances when already computed.
// Returns [still on the level, distances or nil].
val monsterAct = fn(i:num, dist:map|nil):list {
    val m0 = site().monsters[i]
    val m = if (hasFlag(m0, "regenerates") && m0.hp < m0.maxHp) { m0 copy {hp: m0.hp + 1} } else { m0 }
    setMonster(i, m)
    val p = player
    if (m.state == "asleep") {
        if (!hasFlag(m, "still") && near(m.x, m.y) && (hasFlag(m, "mean") || rng.below(3) == 0)) {
            setMonster(i, m copy {state: "awake"})
        }
        [true, dist]
    } else if (hasFlag(m, "still")) {
        [true, dist]
    } else if (hasFlag(m, "flies") && rng.below(2) == 0) {
        val d = ORDER[rng.below(8)]
        if (stepOk(m.x, m.y, d[0], d[1]) && openFor(m.x + d[0], m.y + d[1])) {
            setMonster(i, m copy {x: m.x + d[0], y: m.y + d[1]})
        }
        [true, dist]
    } else {
        val dx = p.x - m.x
        val dy = p.y - m.y
        if (dx >= -1 && dx <= 1 && dy >= -1 && dy <= 1 && stepOk(m.x, m.y, dx, dy)) {
            [monsterAttack(i), dist]
        } else {
            val ds = dist ?? distances()
            val start = ds[m.y * level.WIDTH + m.x]
            // The first direction, in ORDER, to the open square nearest the player.
            val best = fn(j:num, choice:list|nil, bestD:num):list|nil {
                if (j == 8) {
                    choice
                } else {
                    val d = ORDER[j]
                    val nd = ds[(m.y + d[1]) * level.WIDTH + m.x + d[0]]
                    if (nd != nil && nd < bestD && stepOk(m.x, m.y, d[0], d[1]) && openFor(m.x + d[0], m.y + d[1])) {
                        recur(j + 1, d, nd)
                    } else {
                        recur(j + 1, choice, bestD)
                    }
                }
            }
            if (start != nil) {
                match best(0, nil, start) {
                    [sx, sy] => setMonster(i, m copy {x: m.x + sx, y: m.y + sy})
                    _ => nil
                }
            }
            [true, ds]
        }
    }
}

// Every monster acts, in list order, until the player dies.
// The id of the living player nearest monster `m` in the acting player's
// chunk, counting diagonal steps as one, the first by id on a tie; nil when
// none is left.
val nearest = fn(m:map):str|nil {
    val company = companyIn(playerKey())
    val go = fn(i:num, best:str|nil, bestD:num):str|nil {
        if (i == len(company)) { return best }
        val p = company[i][1]
        val d = math.max(math.abs(p.x - m.x), math.abs(p.y - m.y))
        if (d < bestD) { recur(i + 1, company[i][0], d) } else { recur(i + 1, best, bestD) }
    }
    go(0, nil, 1000000)
}

// Every monster in the acting player's chunk acts, in list order, against
// the nearest living player, as that player; until no one there is alive.
// Distances are kept per player.
val monstersAct = fn() {
    val go = fn(i:num, dists:map) {
        if (i < len(site().monsters)) {
            match nearest(site().monsters[i]) {
                id: str => {
                    match actAs(id, fn() { monsterAct(i, dists[id]) }) {
                        [true, ds] => recur(i + 1, dists + {[id]: ds})
                        [_, ds] => recur(i, dists + {[id]: ds})
                    }
                }
                _ => nil
            }
        }
    }
    go(0, {})
}

// ---------------------------------------------------------------------------
// Turns.

// The player's upkeep at the end of a turn: hunger, healing, and the
// confusion and blindness timers.
val upkeep = fn() {
    val p0 = player
    val food = p0.food - 1
    setPlayer(p0 copy {food: food})
    if (food == 150) { say("You are starting to get hungry.") }
    if (food == 50) { say("You are starting to feel weak.") }
    if (food <= STARVED) {
        die("Starved to death")
    } else {
        if (food <= 0 && player.frozen == 0 && rng.below(5) == 0) {
            setPlayer(player copy {frozen: player.frozen + rng.below(8) + 4})
            say("You faint from lack of food.")
        }
        val p = player
        val every = if (21 - 2 * p.level < 3) { 3 } else { 21 - 2 * p.level }
        if (p.hp < p.maxHp) {
            if (p.regen + 1 >= every) {
                setPlayer(p copy {hp: p.hp + 1, regen: 0})
            } else {
                setPlayer(p copy {regen: p.regen + 1})
            }
        } else {
            setPlayer(p copy {regen: 0})
        }
        val q = player
        if (q.confused > 0) {
            setPlayer(q copy {confused: q.confused - 1})
            if (q.confused == 1) { say("You feel less confused now.") }
        }
        val r = player
        if (r.blind > 0) {
            setPlayer(r copy {blind: r.blind - 1})
            if (r.blind == 1) { say("The darkness lifts.") }
        }
    }
}

// Ends a turn: the player's action has happened; the monsters act, the
// player's upkeep happens, the turn is counted, and the player looks around.
// In a `tick`, the world's turn waits for the end of the tick, so this only
// notes that the player spent theirs.
val endTurn = fn() {
    if (ticking) {
        spent = true
    } else {
        monstersAct()
        if (!player.dead) { upkeep() }
        world = world copy {turn: world.turn + 1}
        see()
    }
}

// Turns that pass with the player frozen, until the player thaws or dies.
val thaw = fn() {
    val p = player
    if (p.frozen > 0 && !player.dead) {
        setPlayer(p copy {frozen: p.frozen - 1})
        endTurn()
        recur()
    }
}

// The player attacks monster i.
val attack = fn(i:num) {
    val m = site().monsters[i] copy {state: "awake"}
    setMonster(i, m)
    val kind = kindOf(m)
    val p = player
    val w = packIndex(p.weapon)
    val dice = if (w < 0) { [1, 2] } else { data.weapons[player.pack[w].item.type].damage }
    val bonus = if (w < 0) { 0 } else { player.pack[w].item.bonus }
    if (hits(p.level, strengthHit(p.str) + bonus, kind.armour)) {
        val roll = rng.roll(dice[0], dice[1]) + bonus + strengthDamage(p.str)
        val damage = if (roll < 0) { 0 } else { roll }
        if (m.hp - damage <= 0) {
            removeMonster(i)
            say("You defeat the " + kind.name + ".")
            gainXp(kind.xp)
            counted(kind.name)
        } else {
            setMonster(i, m copy {hp: m.hp - damage})
            say("You hit the " + kind.name + ".")
        }
    } else {
        say("You miss the " + kind.name + ".")
    }
    if (hasFlag(m, "paralyses") && p.blind == 0 && indexAt(site().monsters, m.x, m.y) >= 0) {
        say("You are frozen by the " + kind.name + "'s gaze!")
        setPlayer(player copy {frozen: player.frozen + rng.below(4) + 2})
    }
}

// Moves one square, picking up what is there, or attacks the monster there.
// Returns whether the player moved.
val step = fn(dx:num, dy:num):bool {
    val p = player
    if (!inBounds(p.x + dx, p.y + dy)) {
        cross(dx, dy)
    } else if (!stepOk(p.x, p.y, dx, dy)) {
        false
    } else if (playerAt(p.x + dx, p.y + dy)) {
        match playerIdIn(playerKey(), p.x + dx, p.y + dy) {
            id: str => if (!runStep) { meet(id) }
            _ => nil
        }
        false
    } else if (characterAt(p.x + dx, p.y + dy) >= 0) {
        if (!runStep) { greet(characterAt(p.x + dx, p.y + dy)) }
        false
    } else {
        val i = indexAt(site().monsters, p.x + dx, p.y + dy)
        if (i >= 0) {
            attack(i)
            endTurn()
            false
        } else {
            setPlayer(p copy {x: p.x + dx, y: p.y + dy})
            pickUp()
            endTurn()
            true
        }
    }
}

// Steps off the map's edge into the next chunk: only straight across, from
// an opening to the matching one, and only when no one stands there.
// Returns whether the player moved.
val cross = fn(dx:num, dy:num):bool {
    val p = player
    val x = p.x + dx
    val y = p.y + dy
    val cx = p.cx + if (x < 0) { -1 } else if (x >= level.WIDTH) { 1 } else { 0 }
    val cy = p.cy + if (y < 0) { -1 } else if (y >= level.HEIGHT) { 1 } else { 0 }
    val nx = (x + level.WIDTH) % level.WIDTH
    val ny = (y + level.HEIGHT) % level.HEIGHT
    if ((dx != 0 && dy != 0) || !inWorld(cx, cy)) { return false }
    val next = chunk(cx, cy, p.depth)
    match playerIdIn(chunkKey(cx, cy, p.depth), nx, ny) {
        id: str => {
            if (!runStep) { meet(id) }
            return false
        }
        _ => nil
    }
    val blocked = indexAt(next.monsters, nx, ny) >= 0
    if (!contains(PASSABLE, next.map[ny][nx]) || blocked) { return false }
    enter(cx, cy, p.depth, fn(lv) { {x: nx, y: ny} })
    pickUp()
    endTurn()
    true
}

val monsterVisible = fn():bool {
    val go = fn(i:num):bool {
        if (i == len(site().monsters)) {
            false
        } else if (canSee(site().monsters[i].x, site().monsters[i].y)) {
            true
        } else {
            recur(i + 1)
        }
    }
    go(0)
}

// Runs: moves until a move is impossible, or until, after a move, the
// player stands on a door, the stairs, or an item, can see a monster, has a
// message, or is dead. Running never attacks.
val run = fn(dx:num, dy:num) {
    val p = player
    runStep = true
    val moved = indexAt(site().monsters, p.x + dx, p.y + dy) < 0 && step(dx, dy)
    runStep = false
    if (moved) {
        val q = player
        val ground = terrain(q.x, q.y)
        val stop = ground == level.DOOR || ground == level.STAIRS || ground == level.UP || indexAt(site().items, q.x, q.y) >= 0
            || monsterVisible() || len(player.messages) > 0 || player.dead
        if (!stop) {
            // In a tick, running takes one step a tick; `keepRunning` goes on.
            if (ticking) { player = player copy {running: [dx, dy]} } else { recur(dx, dy) }
        }
    }
}

// In a tick, another step of a run, unless a monster has come into view.
val keepRunning = fn() {
    match player.running {
        [dx, dy] => {
            player = player copy {running: nil}
            if (!monsterVisible()) { run(dx, dy) }
        }
        _ => nil
    }
}

// Takes the stairs the player stands on: down to the chunk below, arriving
// on its stairs up, or up to the chunk above, arriving on its stairs down.
val takeStairs = fn() {
    val p = player
    val ground = terrain(p.x, p.y)
    if (ground == level.STAIRS) {
        enter(p.cx, p.cy, p.depth + 1, fn(lv) { lv.up })
        if (ticking) { spent = true } else { world = world copy {turn: world.turn + 1} }
    } else if (ground == level.UP) {
        enter(p.cx, p.cy, p.depth - 1, fn(lv) { lv.down })
        if (ticking) { spent = true } else { world = world copy {turn: world.turn + 1} }
    } else {
        say("There are no stairs here.")
    }
}

// ---------------------------------------------------------------------------
// Item commands.

val quaff = fn(type:num) {
    val name = data.potions[type].name
    val p = player
    if (name == "healing") {
        val hp = p.hp + rng.roll(p.level, 4)
        setPlayer(if (hp > p.maxHp) { p copy {hp: p.maxHp + 1, maxHp: p.maxHp + 1} } else { p copy {hp: hp} })
        say("You begin to feel better.")
    } else if (name == "poison") {
        val str = p.str - (rng.below(3) + 1)
        setPlayer(p copy {str: if (str < 3) { 3 } else { str }})
        say("You feel very sick now.")
    } else if (name == "confusion") {
        setPlayer(p copy {confused: p.confused + rng.below(8) + 8})
        say("Wait, what's going on here?")
    } else if (name == "blindness") {
        setPlayer(p copy {blind: p.blind + rng.below(50) + 50})
        say("A cloak of darkness falls around you.")
    } else if (name == "gain strength") {
        setPlayer(p copy {str: p.str + 1, maxStr: if (p.str + 1 > p.maxStr) { p.str + 1 } else { p.maxStr }})
        say("You feel stronger.")
    } else if (len(site().monsters) > 0) {
        player = player copy {sense: true}
        say("You sense the presence of monsters.")
    } else {
        say("You have a strange feeling for a moment.")
    }
}

val read = fn(type:num) {
    val name = data.scrolls[type].name
    val p = player
    if (name == "identify") {
        val find = fn(i:num):num {
            if (i == len(player.pack)) {
                -1
            } else if (!identified(player.pack[i].item)) {
                i
            } else {
                recur(i + 1)
            }
        }
        val i = find(0)
        if (i < 0) {
            say("You have nothing to identify.")
        } else {
            val item = player.pack[i].item
            val known = player.known
            player = player copy {
                known: if (item.kind == "potion") {
                    known copy {potions: known.potions :+ item.type}
                } else {
                    known copy {scrolls: known.scrolls :+ item.type}
                },
            }
            say(packLine(player.pack[i]))
        }
    } else if (name == "teleportation") {
        val spot = level.freeSpot(site())
        setPlayer(p copy {x: spot.x, y: spot.y})
        say("You are somewhere else.")
    } else if (name == "magic mapping") {
        val row = fn(y:num, rows:list):list {
            if (y == level.HEIGHT) {
                rows
            } else {
                val mapped = fn(x:num, acc:str):str {
                    if (x == level.WIDTH) {
                        acc
                    } else {
                        val c = if (memory()[y][x] == level.BLANK) { site().map[y][x] } else { memory()[y][x] }
                        recur(x + 1, acc + c)
                    }
                }
                recur(y + 1, rows :+ mapped(0, ""))
            }
        }
        setMemory(row(0, []))
        say("A map forms in your mind.")
    } else if (name == "enchant weapon") {
        val i = packIndex(p.weapon)
        if (i < 0) {
            say("Your hands tingle.")
        } else {
            val e = player.pack[i]
            setEntry(e.letter, e copy {item: e.item copy {bonus: e.item.bonus + 1}})
            say("Your " + data.weapons[e.item.type].name + " glows blue for a moment.")
        }
    } else {
        val i = packIndex(p.armour)
        if (i < 0) {
            say("Your skin crawls.")
        } else {
            val e = player.pack[i]
            setEntry(e.letter, e copy {item: e.item copy {bonus: e.item.bonus + 1}})
            say("Your " + data.armours[e.item.type].name + " glows silver for a moment.")
        }
    }
}

// Carries out item command `c` on the pack entry with `letter`.
val useItem = fn(c:str, letter:str) {
    match ITEM_COMMANDS[c] {
        spec: struct<ItemCommand> => useWith(spec, c, letter)
        _ => nil
    }
}

val useWith = fn(spec:struct<ItemCommand>, c:str, letter:str) {
    val i = packIndex(letter)
    val p = player
    if (i < 0) {
        say("You have no item " + letter + ".")
    } else if (spec.kind != nil && player.pack[i].item.kind != spec.kind) {
        say(spec.wrong)
    } else {
        val e = player.pack[i]
        match c {
            "e" => {
                takeOne(letter)
                val start = if (p.food < 0) { 0 } else { p.food }
                val food = start + 1100 + rng.below(400)
                setPlayer(player copy {food: if (food > FOOD_MAX) { FOOD_MAX } else { food }})
                say("Yum, that tasted good.")
                endTurn()
            }
            "q" => {
                takeOne(letter)
                player = player copy {known: player.known copy {potions: if (contains(player.known.potions, e.item.type)) { player.known.potions } else { player.known.potions :+ e.item.type }}}
                quaff(e.item.type)
                endTurn()
            }
            "r" => {
                takeOne(letter)
                player = player copy {known: player.known copy {scrolls: if (contains(player.known.scrolls, e.item.type)) { player.known.scrolls } else { player.known.scrolls :+ e.item.type }}}
                read(e.item.type)
                endTurn()
            }
            "w" => {
                if (p.weapon == letter) {
                    say("You are already wielding that.")
                } else {
                    setPlayer(p copy {weapon: letter})
                    say("You are now wielding " + nameOf(e.item, 1) + ".")
                    endTurn()
                }
            }
            "a" => {
                if (p.armour == letter) {
                    setPlayer(p copy {armour: nil})
                    say("You took off " + nameOf(e.item, 1) + ".")
                    endTurn()
                } else if (p.armour != nil) {
                    say("You are already wearing armour.")
                } else {
                    setPlayer(p copy {armour: letter})
                    say("You are now wearing " + nameOf(e.item, 1) + ".")
                    endTurn()
                }
            }
            _ => {
                if (p.armour == letter) {
                    say("You can't drop armour you are wearing.")
                } else if (indexAt(site().items, p.x, p.y) >= 0 || terrain(p.x, p.y) == level.STAIRS || terrain(p.x, p.y) == level.UP) {
                    say("There is no room to drop that here.")
                } else {
                    takeOne(letter)
                    setHere(site() copy {items: site().items :+ {x: p.x, y: p.y, item: e.item, dropped: true}})
                    say("Dropped " + nameOf(e.item, 1) + ".")
                    endTurn()
                }
            }
        }
    }
}

// Starts item command `c`: asks which item, unless there is nothing to use.
val askItem = fn(c:str) {
    match ITEM_COMMANDS[c] {
        spec: struct<ItemCommand> => askWith(spec, c)
        _ => nil
    }
}

val askWith = fn(spec:struct<ItemCommand>, c:str) {
    val any = fn(i:num):bool {
        if (i == len(player.pack)) {
            false
        } else if (spec.kind == nil || player.pack[i].item.kind == spec.kind) {
            true
        } else {
            recur(i + 1)
        }
    }
    if (c == "r" && player.blind > 0) {
        say("You can't see to read.")
    } else if (!any(0)) {
        say(spec.nothing)
    } else {
        val question = spec.verb + " which item? (space to cancel)"
        player = player copy {prompt: c, question: question}
        say(question)
    }
}

// ---------------------------------------------------------------------------
// Meeting other players.

/**
 * What players can say to each other with one key from the Talk menu.
 */
export val PHRASES = ["Hello!", "Follow me.", "Wait here.", "Help!", "Watch out!", "Thanks!", "Goodbye."]

// The longest thing a player can say, in characters.
val SAY_LIMIT = 80

// The id of the living player other than the acting one at (x, y) in the
// chunk with `key`, or nil.
val playerIdIn = fn(key:str, x:num, y:num):str|nil {
    val company = companyIn(key)
    val go = fn(i:num):str|nil {
        if (i == len(company)) { return nil }
        val [id, o] = company[i]
        if (id != acting && o.x == x && o.y == y) { id } else { recur(i + 1) }
    }
    go(0)
}

// Where player `o` stands, in the coordinates of the acting player's chunk.
val relative = fn(o:map):map {
    {x: o.x + (o.cx - player.cx) * level.WIDTH, y: o.y + (o.cy - player.cy) * level.HEIGHT}
}

// The player with `id` if they are alive, on the acting player's depth,
// and on a square next to them, or nil.
val beside = fn(id:str):map|nil {
    match players[id] {
        o: map => {
            val r = relative(o)
            val near = math.max(math.abs(r.x - player.x), math.abs(r.y - player.y)) == 1
            if (!o.dead && o.depth == player.depth && near) { o } else { nil }
        }
        _ => nil
    }
}

// Opens the menu for meeting the player with `id`, as bumping into them
// does: it takes no time.
val meet = fn(id:str) {
    player = player copy {menu: {with: id, page: "main"}}
}

val closeMenu = fn() { player = player copy {menu: nil} }

// Opens the menu for the character with index `i` in the acting player's
// chunk, as walking into them does: it takes no time.
val greet = fn(i:num) {
    player = player copy {menu: {character: i, page: "main"}}
}

// The territory the acting player is in.
val territoryHere = fn():str { empire.territoryOf(player.cx, player.cy, player.depth) }

// What things cost here and what dealers pay, as the faction holding the
// land has it (see `empire.priceFactor`).
val factorHere = fn():num { empire.priceFactor(world.empire ?? {holds: {}}, territoryHere()) }
val buyPrice = fn(item:map):num { math.max(1, math.div(town.price(item) * factorHere(), 100)) }
val sellPrice = fn(item:map):num { math.max(1, math.div(town.offer(item) * 100, factorHere())) }
val innPrice = fn(base:num):num { math.max(1, math.div(base * factorHere(), 100)) }

// Something a character in `role` says of the world near the acting
// player (see `slug.games.crawl.lore`), or nil.
val tellHere = fn(role:str):str|nil {
    match world.empire {
        e: map => lore.talk(role, world.seed, e, territoryHere())
        _ => nil
    }
}

// The bounties posted for the region the acting player is in, and what
// they are owed under them: `{bounties, gold, kills}`.
val bountiesHere = fn():map {
    val [rx, ry, _] = string.split(territoryHere(), ",")
    val posted = empire.bounties(world.empire ?? {holds: {}, factions: []}, string.toInt(rx) ?? 0, string.toInt(ry) ?? 0)
    val kills = player.kills ?? {}
    val owed = reduce(posted, {gold: 0, kills: 0}, fn(acc, b) {
        val n = kills[rx + "," + ry + "|" + b.kind] ?? 0
        {gold: acc.gold + n * b.price, kills: acc.kills + n}
    })
    {bounties: posted, gold: owed.gold, kills: owed.kills, region: rx + "," + ry}
}

// What a ware is called: by what it is, since a dealer knows.
val wareName = fn(item:map):str {
    match item.kind {
        "potion" => "a potion of " + data.potions[item.type].name
        "scroll" => "a scroll of " + data.scrolls[item.type].name
        _ => nameOf(item, 1)
    }
}

// The pack entries character `c` would buy: anything of a kind they deal
// in but the weapon in hand and worn armour.
val sellable = fn(c:map):list {
    filter(player.pack, fn(e) { e.letter != player.armour && e.letter != player.weapon && town.buys(c.role, e.item) })
}

// The menu of character `c` on `page`, as `menuOf` gives.
val characterMenu = fn(c:map, page:str):map {
    val name = town.title(c)
    val lines = town.LINES[c.role] ?? []
    match page {
        "buy" => {
            val wares = town.wares(c.role)
            {
                title: name + " sells, for your " + player.gold + " gold:",
                entries: map(range(len(wares)), fn(i) {
                    {key: "" + (i + 1), label: wareName(wares[i]) + ", " + buyPrice(wares[i]) + " gold", act: ["buy", i]}
                }),
            }
        }
        "sell" => {
            val goods = sellable(c)
            {
                title: if (len(goods) == 0) { name + " wants nothing you have." } else { name + " would pay:" },
                entries: map(goods, fn(e) { {key: e.letter, label: nameOf(e.item, 1) + ", " + sellPrice(e.item) + " gold", act: ["sell", e.letter]} }),
            }
        }
        _ => {
            // Only a captain deals in bounties.
            val here = if (c.role == "captain") { bountiesHere() } else { {bounties: [], gold: 0, kills: 0, region: ""} }
            val posted = if (len(here.bounties) == 0) { "No bounties are posted here." } else {
                val [rx, ry] = string.split(here.region, ",")
                "Bounties for " + empire.regionName(world.seed, string.toInt(rx) ?? 0, string.toInt(ry) ?? 0) + ": "
                    + string.join(map(here.bounties, fn(b) { "" + b.price + " gold " + an(b.kind) }), ", ") + "."
            }
            // A dealer says why prices are as they are, if they are not as usual.
            val prices = if (c.role == "trader" || c.role == "quartermaster") {
                lore.prices(world.seed, world.empire ?? {holds: {}}, territoryHere())
            } else { nil }
            val greeting = if (c.role == "guard" || c.role == "townsperson") { name + "." }
                else if (c.role == "captain") { name + ": \"" + posted + "\"" }
                else { name + ": \"" + (prices ?? lines[0]) + "\"" }
            val entries = match c.role {
                "captain" => (if (here.gold > 0) {
                    [{key: "1", label: "Claim " + here.gold + " gold for " + here.kills + (if (here.kills == 1) { " kill" } else { " kills" }), act: ["claim"]}]
                } else { [] }) + [{key: "2", label: "Talk", act: ["talk"]}]
                "trader", "quartermaster" => [
                    {key: "1", label: "Buy", act: ["page", "buy"]},
                    {key: "2", label: "Sell", act: ["page", "sell"]},
                ]
                "innkeeper" => [
                    {key: "1", label: "Hear a rumour", act: ["rumour"]},
                    {key: "2", label: "A meal, " + innPrice(town.MEAL) + " gold", act: ["meal"]},
                    {key: "3", label: "A bed for the night, " + innPrice(town.BED) + " gold", act: ["bed"]},
                ]
                _ => [{key: "1", label: "Talk", act: ["talk"]}]
            }
            {title: greeting, entries: entries}
        }
    }
}

// Pays `cost` gold for something, saying so; returns false, saying why,
// when the player has too little.
val pay = fn(cost:num, what:str):bool {
    if (player.gold < cost) {
        say("You can't afford " + what + ".")
        false
    } else {
        setPlayer(player copy {gold: player.gold - cost})
        true
    }
}

// Does what character `c`'s menu entry `act` says. The menu stays open.
val deal = fn(c:map, act:list) {
    match act {
        ["buy", i] => {
            val ware = town.wares(c.role)[i]
            val cost = buyPrice(ware)
            if (player.gold < cost) {
                say("You can't afford " + wareName(ware) + ".")
            } else if (addToPack(ware) == nil) {
                say("Your pack is full; there's no room for " + wareName(ware) + ".")
            } else {
                setPlayer(player copy {gold: player.gold - cost})
                // A ware bought is known for what it is.
                val known = player.known
                setPlayer(player copy {known: match ware.kind {
                    "potion" => known copy {potions: if (contains(known.potions, ware.type)) { known.potions } else { known.potions :+ ware.type }}
                    "scroll" => known copy {scrolls: if (contains(known.scrolls, ware.type)) { known.scrolls } else { known.scrolls :+ ware.type }}
                    _ => known
                }})
                say("You buy " + wareName(ware) + " for " + cost + " gold.")
            }
        }
        ["sell", letter] => {
            val i = packIndex(letter)
            if (i >= 0) {
                val item = player.pack[i].item
                val paid = sellPrice(item)
                val name = nameOf(item, 1)
                takeOne(letter)
                setPlayer(player copy {gold: player.gold + paid})
                say("You sell " + name + " for " + paid + " gold.")
            }
        }
        ["rumour"] => {
            // Half the time, what has been heard of the world near here.
            val heard = if (rng.below(2) == 0) { tellHere(c.role) } else { nil }
            say(c.name + " says: \"" + (heard ?? town.RUMOURS[rng.below(len(town.RUMOURS))]) + "\"")
        }
        ["claim"] => {
            val here = bountiesHere()
            if (here.gold > 0) {
                val kills = player.kills ?? {}
                val left = reduce(here.bounties, kills, fn(acc, b) { acc - (here.region + "|" + b.kind) })
                setPlayer(player copy {gold: player.gold + here.gold, kills: left})
                say(c.name + " pays you " + here.gold + " gold.")
            }
        }
        ["talk"] => {
            // Half the time, something of the world near here.
            val lines = town.LINES[c.role] ?? ["..."]
            val told = if (rng.below(2) == 0) { tellHere(c.role) } else { nil }
            say(c.name + " says: \"" + (told ?? lines[rng.below(len(lines))]) + "\"")
        }
        ["meal"] => if (pay(innPrice(town.MEAL), "a meal")) {
            setPlayer(player copy {food: FOOD_MAX})
            say("You eat a hot meal.")
        }
        ["bed"] => if (pay(innPrice(town.BED), "a bed")) {
            setPlayer(player copy {hp: player.maxHp})
            say("You sleep soundly and wake refreshed.")
        }
        _ => nil
    }
}

// The entries of the acting player's open menu, each `{key, label}` and
// what choosing it does as `act`, with the menu's title.
val menuOf = fn():map {
    val m = player.menu
    if (m.character != nil) { return characterMenu(site().characters[m.character], m.page) }
    val name = players[m.with].name
    match m.page {
        "talk" => {
            title: "Say to " + name + ":",
            entries: map(range(len(PHRASES)), fn(i) { {key: "" + (i + 1), label: PHRASES[i], act: ["phrase", i]} }),
        }
        "give" => {
            val worn = player.armour
            val items = filter(player.pack, fn(e) { e.letter != worn })
            val gold = player.gold
            val some = if (gold >= 20) { [{key: "1", label: "10 gold", act: ["gold", 10]}] } else { [] }
            val all = if (gold > 0) { [{key: "2", label: "All your gold (" + gold + ")", act: ["gold", gold]}] } else { [] }
            {
                title: "Give " + name + ":",
                entries: map(items, fn(e) {
                    val held = if (e.letter == player.weapon) { " (weapon in hand)" } else { "" }
                    {key: e.letter, label: nameOf(e.item, 1) + held, act: ["item", e.letter]}
                }) + some + all,
            }
        }
        _ => {
            title: "You meet " + name + ".",
            entries: [
                {key: "1", label: "Talk", act: ["page", "talk"]},
                {key: "2", label: "Give", act: ["page", "give"]},
            ],
        }
    }
}

// The players who can hear the acting player: everyone else alive whom
// they can see.
val hearers = fn():list {
    val sight = inSightNow()
    filter(string.sort(keys(players)), fn(id) {
        val o = if (id == acting) { nil } else { players[id] }
        if (o == nil || o.dead || o.depth != player.depth) { return false }
        val r = relative(o)
        sight[viewKey(r.x, r.y)] == true
    })
}

// The acting player says `words` aloud, to everyone who can see them.
val speak = fn(words:str) {
    val name = player.name
    say("You say: \"" + words + "\"")
    map(hearers(), fn(id) { actAs(id, fn() { say(name + " says: \"" + words + "\"") }) })
}

// What a player typed, made fit to say: control characters as spaces, so on
// one line, trimmed, and at most SAY_LIMIT characters.
val tidy = fn(text:str, limit:num = SAY_LIMIT):str {
    val flat = string.join(map(string.chars(text), fn(c) { if (string.ord(c) < 32 || string.ord(c) == 127) { " " } else { c } }), "")
    val trimmed = string.trim(flat)
    if (len(trimmed) > limit) { string.trim(trimmed[:limit]) } else { trimmed }
}

// The longest name a player can take, in characters.
val NAME_LIMIT = 20

// The acting player takes the name `wanted`, tidied as what is said is
// and at most NAME_LIMIT characters; everyone who can see them hears of
// it. A name that tidies to nothing, or is theirs already, changes nothing.
val rename = fn(wanted:str) {
    val name = tidy(wanted, NAME_LIMIT)
    val old = player.name
    if (name == "" || name == old) { return nil }
    player = player copy {name: name}
    say("You are now known as " + name + ".")
    map(hearers(), fn(id) { actAs(id, fn() { say(old + " is now known as " + name + ".") }) })
}

// Gives the player with `id`, who is beside the acting player, one of the
// item with `letter`; it takes a turn.
val giveItem = fn(id:str, letter:str) {
    val i = packIndex(letter)
    if (i < 0) { return nil }
    val item = player.pack[i].item
    val giver = player.name
    val taken = actAs(id, fn() {
        val got = addToPack(item)
        if (got != nil) { say(giver + " gives you " + nameOf(item, 1) + " (" + got + ").") }
        got != nil
    })
    if (taken) {
        say("You give " + players[id].name + " " + nameOf(item, 1) + ".")
        takeOne(letter)
        endTurn()
    } else {
        say(players[id].name + " can't carry any more.")
    }
}

val giveGold = fn(id:str, amount:num) {
    val n = math.min(amount, player.gold)
    if (n <= 0) { return nil }
    val giver = player.name
    setPlayer(player copy {gold: player.gold - n})
    actAs(id, fn() {
        setPlayer(player copy {gold: player.gold + n})
        say(giver + " gives you " + n + " gold.")
    })
    say("You give " + players[id].name + " " + n + " gold.")
    endTurn()
}

// Does what menu entry `act` says, for the player the menu is about, if
// they are still beside the acting player.
val choose = fn(act:list) {
    val m = player.menu
    if (m.character != nil && act[0] != "page" && act[0] != "close") {
        return deal(site().characters[m.character], act)
    }
    val id = m.with
    match act {
        ["page", page] => player = player copy {menu: player.menu copy {page: page}}
        ["close"] => closeMenu()
        _ => {
            closeMenu()
            if (beside(id) == nil) {
                say((players[id] ?? {name: "They"}).name + " is no longer beside you.")
            } else {
                match act {
                    ["phrase", i] => speak(PHRASES[i])
                    ["item", letter] => giveItem(id, letter)
                    ["gold", n] => giveGold(id, n)
                    _ => nil
                }
            }
        }
    }
}

// A key while a menu is open: an entry's key chooses it, and space goes
// back a page, or closes the menu from its first. Returns whether the key
// was the menu's; any other key closes it and acts as usual.
val menuKey = fn(key:str):bool {
    if (key == "space") {
        if (player.menu.page == "main") { closeMenu() } else { player = player copy {menu: player.menu copy {page: "main"}} }
        return true
    }
    val chosen = filter(menuOf().entries, fn(e) { e.key == key })
    if (len(chosen) > 0) {
        // Each choice's messages are its own.
        player = player copy {messages: []}
        choose(chosen[0].act)
        true
    } else {
        closeMenu()
        false
    }
}

// ---------------------------------------------------------------------------
// Commands.

/**
 * Splits messages into the page shown now and the rest: all of them if they
 * fit in 80 columns joined by two spaces, or else the most that fit with
 * " --More--" after them (at least one).
 */
val paginate = fn(messages:list):list {
    val width = fn(n:num):num { len(string.join(messages[:n], "  ")) }
    if (width(len(messages)) <= 80) {
        [messages, []]
    } else {
        val fit = fn(n:num):num {
            if (n < len(messages) && width(n + 1) + 9 <= 80) { recur(n + 1) } else { n }
        }
        val n = fit(1)
        [messages[:n], messages[n:]]
    }
}

val showMessages = fn(messages:list) {
    match paginate(messages) {
        [shown, more] => player = player copy {messages: shown, more: more}
    }
}

// After a command: outside a tick, the turns the player spends frozen, and
// the messages paged to fit the top line. A tick does neither.
val finish = fn() {
    if (!ticking) {
        thaw()
        showMessages(player.messages)
    }
}

// Carries out one command key for the acting player; see `command`.
val perform = fn(key:str, shift:bool, text:str = "") {
    player = player copy {running: nil}
    if (key == "say") {
        val words = tidy(text)
        if (!player.dead && words != "") {
            player = player copy {messages: []}
            speak(words)
            finish()
        }
    } else if (key == "name") {
        player = player copy {messages: []}
        rename(text)
        finish()
    } else if (len(player.more) > 0) {
        if (key == "space") { showMessages(player.more) }
    } else if (player.dead) {
        if (key == "enter") { newCharacter() }
    } else if (player.showingPack) {
        if (key == "space") { player = player copy {showingPack: false, messages: []} }
    } else if (player.menu != nil && menuKey(key)) {
        finish()
    } else if (player.prompt != nil) {
        val c = player.prompt
        if (key == "space") {
            player = player copy {prompt: nil, messages: []}
        } else if (len(key) == 1) {
            player = player copy {prompt: nil, messages: []}
            useItem(c, key)
            finish()
        }
    } else {
        val direction = DIRECTIONS[key]
        val known = key == "space" || key == "enter" || key == "i" || direction != nil || ITEM_COMMANDS[key] != nil
        if (known) {
            player = player copy {messages: []}
            if (key == "space") {
                endTurn()
            } else if (key == "enter") {
                takeStairs()
            } else if (key == "i") {
                if (len(player.pack) == 0) {
                    say("You are empty-handed.")
                } else {
                    player = player copy {showingPack: true}
                    say("Press space to continue.")
                }
            } else if (direction != nil) {
                if (player.confused > 0) {
                    val d = ORDER[rng.below(8)]
                    step(d[0], d[1])
                } else {
                    match direction {
                        [dx, dy] => if (shift) { run(dx, dy) } else { step(dx, dy) }
                        _ => nil
                    }
                }
            } else {
                askItem(key)
            }
            finish()
        }
    }
}

// The map of the acting player's chunk as they know it, with the monsters
// and players they can see on it.
val mapRows = fn():list {
    val monsters = fn(i:num, rows:list):list {
        if (i == len(site().monsters)) {
            rows
        } else {
            val m = site().monsters[i]
            val shown = player.sense || canSee(m.x, m.y)
            recur(i + 1, if (shown) { write(rows, m.x, m.y, bestiary.monsters[m.kind].letter) } else { rows })
        }
    }
    val company = companyIn(playerKey())
    val others = fn(i:num, rows:list):list {
        if (i == len(company)) {
            rows
        } else {
            val o = company[i][1]
            recur(i + 1, if (canSee(o.x, o.y)) { write(rows, o.x, o.y, "@") } else { rows })
        }
    }
    val people = site().characters ?? []
    val characters = fn(i:num, rows:list):list {
        if (i == len(people)) { return rows }
        val c = people[i]
        recur(i + 1, if (canSee(c.x, c.y)) { write(rows, c.x, c.y, "@") } else { rows })
    }
    write(others(0, characters(0, monsters(0, memory()))), player.x, player.y, "@")
}

// The acting player's screen; see `text`.
val screen = fn():list {
    val p = player
    val map = if (player.menu != nil) {
        val m = menuOf()
        val all = [m.title, ""] + map(m.entries, fn(e) { e.key + ") " + e.label }) + ["", "(space to go back)"]
        val lines = if (len(all) > level.HEIGHT) { all[:level.HEIGHT] } else { all }
        lines + map(range(level.HEIGHT - len(lines)), fn(_) { "" })
    } else if (player.showingPack) {
        val lines = fn(i:num, rows:list):list {
            if (i == level.HEIGHT) {
                rows
            } else {
                recur(i + 1, rows :+ (if (i < len(player.pack)) { packLine(player.pack[i]) } else { "" }))
            }
        }
        lines(0, [])
    } else {
        mapRows()
    }
    val hunger = if (p.food <= 0) { "  Faint" } else if (p.food <= 50) { "  Weak" } else if (p.food <= 150) { "  Hungry" } else { "" }
    val status = "Depth:" + player.depth + "  Gold:" + p.gold + "  Hp:" + p.hp + "(" + p.maxHp + ")  Str:" + p.str
        + "(" + p.maxStr + ")  Arm:" + armourTotal() + "  Exp:" + p.level + "/" + p.xp + hunger
    val more = if (len(player.more) > 0) { " --More--" } else { "" }
    [string.join(player.messages, "  ") + more] + map + [status]
}

// ---------------------------------------------------------------------------
// Players by id.

/**
 * Carries out one command key for the player with `id`: a letter, "space",
 * or "enter", with `shift` held or not, as the eval's task.md describes,
 * except that `enter` takes stairs up as well as down, and after death
 * starts a new character. Walking into another player opens a menu, which
 * an entry's key chooses from and space backs out of; the key "say" says
 * `text` aloud to everyone who can see the player, and the key "name"
 * gives the player the name `text`, at most 20 characters.
 */
export val command = fn(id:str, key:str, shift:bool, text:str = "") { actAs(id, fn() { perform(key, shift, text) }) }

/**
 * The menu the player with `id` has open, as `{title, entries}` with each
 * entry `{key, label}`, the key that chooses it; or nil when none is open.
 * Bumping into another player opens one: Talk, Give, or Leave.
 */
export val menu = fn(id:str):map|nil {
    actAs(id, fn() {
        if (player.menu == nil) { return nil }
        val m = menuOf()
        {title: m.title, page: player.menu.page, entries: map(m.entries, fn(e) { {key: e.key, label: e.label} })}
    })
}

/**
 * Advances the world by one tick. Each of `actions`, `{id, key, shift}`,
 * or `{id, key: "say", text}` to say `text` aloud, or `{id, key: "name",
 * text}` to take the name `text`, in
 * the order they arrived, at most one per player, is carried out as
 * `command` would, except that a frozen player's is dropped, and a run
 * takes one step a tick. Players in `present` (those playing now) with no
 * action carry on running, or lose a turn while frozen. Then, on every
 * `monsterEvery`-th tick, the monsters act once in each chunk with a living
 * present player; everyone who spent a turn has their upkeep, the turn is
 * counted, and everyone present looks around. Each present player's
 * messages are this tick's; none are paged.
 */
export val tick = fn(actions:list, present:list, monsterEvery:num = 4) {
    ticking = true
    val each = fn(ids:list, body:fn) {
        val go = fn(i:num) {
            if (i < len(ids)) {
                if (players[ids[i]] != nil) { actAs(ids[i], body) }
                recur(i + 1)
            }
        }
        go(0)
    }
    each(present, fn() { player = player copy {messages: [], more: []} })
    var timed = []
    var acted = []
    val doActions = fn(i:num) {
        if (i < len(actions)) {
            val a = actions[i]
            val free = players[a.id] != nil && !contains(acted, a.id)
                && (players[a.id].frozen == 0 || players[a.id].dead)
            if (free) {
                acted = acted :+ a.id
                actAs(a.id, fn() {
                    spent = false
                    perform(a.key, a.shift ?? false, a.text ?? "")
                    if (spent) { timed = timed :+ a.id }
                })
            }
            recur(i + 1)
        }
    }
    doActions(0)
    each(present, fn() {
        if (!contains(acted, acting) && !player.dead) {
            spent = false
            if (player.frozen > 0) {
                player = player copy {frozen: player.frozen - 1}
                spent = true
            } else {
                keepRunning()
            }
            if (spent) { timed = timed :+ acting }
        }
    })
    // The monsters of each chunk with a living present player, once each,
    // on their ticks.
    var chunks = []
    each(present, fn() {
        val key = playerKey()
        if (!player.dead && !contains(chunks, key)) {
            chunks = chunks :+ key
            if (world.turn % monsterEvery == 0) { monstersAct() }
        }
    })
    each(timed, fn() { if (!player.dead) { upkeep() } })
    regionTick()
    if (world.turn % (world.empireEvery ?? EMPIRE_EVERY) == 0 && world.turn > 0) {
        val e = world.empire
        world = world copy {empire: rng.within(rng.mix([world.seed, 61, e.step]), fn() { empire.step(e, world.seed) })}
        val comes = string.upper(empire.seasonOf(world.empire.step)[:1]) + empire.seasonOf(world.empire.step)[1:] + " comes."
        each(present, fn() { say(comes) })
    }
    world = world copy {turn: world.turn + 1}
    each(present, fn() { if (!player.dead) { see() } })
    ticking = false
}

/**
 * The screen's 24 text rows for the player with `id`: messages, the map as
 * they know it (or their pack), and their status line. Other players they
 * can see are drawn as `@` too.
 */
export val text = fn(id:str):list { actAs(id, screen) }

// `a` divided by `b` > 0, rounded down, as chunk coordinates need.

/**
 * The map rows the player with `id` sees through a window `cols` wide and
 * `rows` tall whose top left corner is at (left, top) in world coordinates
 * on their depth, where a square's world x is its chunk's x times WIDTH
 * plus its x in the chunk, and likewise y. The chunk they are in is drawn
 * as `text` draws it, with the monsters and players they can see; other
 * chunks as they remember them, blank where they have never been.
 */
export val view = fn(id:str, left:num, top:num, cols:num, rows:num):list {
    actAs(id, fn() {
        val current = mapRows()
        val rowOf = fn(cx:num, cy:num, ly:num):str {
            if (cx == player.cx && cy == player.cy) {
                current[ly]
            } else {
                (player.memory[chunkKey(cx, cy, player.depth)] ?? BLANK_ROWS)[ly]
            }
        }
        // One window row, a piece from each chunk it crosses.
        val line = fn(wy:num):str {
            val cy = floorDiv(wy, level.HEIGHT)
            val ly = wy - cy * level.HEIGHT
            val go = fn(wx:num, out:str):str {
                if (wx >= left + cols) { return out }
                val cx = floorDiv(wx, level.WIDTH)
                val lx = wx - cx * level.WIDTH
                val end = math.min(left + cols, (cx + 1) * level.WIDTH)
                recur(end, out + rowOf(cx, cy, ly)[lx:lx + end - wx])
            }
            go(left, "")
        }
        val go = fn(wy:num, out:list):list {
            if (wy == top + rows) { out } else { recur(wy + 1, out :+ line(wy)) }
        }
        go(top, [])
    })
}

/**
 * The date in the world: `{year, season, part}`, the part of the season
 * "early", "mid" or "late", and `text`, as "Late spring, year 76", or
 * "Spring, year 76" in the middle of it.
 */
export val date = fn():map {
    val step = (world.empire ?? {step: 0}).step
    val every = world.empireEvery ?? EMPIRE_EVERY
    val part = ["early", "mid", "late"][math.min(2, math.div(3 * (world.turn % every), every))]
    val season = empire.seasonOf(step)
    val year = empire.yearOf(step)
    val named = if (part == "mid") { season } else { part + " " + season }
    {year: year, season: season, part: part, text: string.upper(named[:1]) + named[1:] + ", year " + year}
}

/**
 * The land the player with `id` is in: `{holder, place, since}`, the name
 * of the faction holding it, or nil, where it is in words, and how long it
 * has been held (see `slug.games.crawl.lore.heldSince`), or nil.
 */
export val land = fn(id:str):map {
    actAs(id, fn() {
        val t = territoryHere()
        {
            holder: match empire.holder(world.empire ?? {holds: {}}, t) {
                f: map => f.name
                _ => nil
            },
            place: empire.placeName(world.seed, t),
            since: lore.heldSince(world.empire ?? {holds: {}}, t),
        }
    })
}

/**
 * The chunk the player with `id` is in.
 */
export val here = fn(id:str):map { actAs(id, site) }

/**
 * Whether the player with `id` can see (x, y) in their chunk: never while
 * blind; otherwise when it is their square or one of its eight
 * neighbours, or they are in a lit room whose rectangle holds it.
 */
export val visible = fn(id:str, x:num, y:num):bool { actAs(id, fn() { canSee(x, y) }) }

/**
 * Every square the player with `id` can see, as a map from `viewKey(x, y)`
 * to true: in their chunk what `visible` says of each square, and outdoors
 * also the squares they see in the chunks beside it.
 */
export val inView = fn(id:str):map { actAs(id, inSightNow) }

/**
 * The armour of the player with `id`: the worn armour's value plus its
 * bonus, or 0.
 */
export val armourValue = fn(id:str):num { actAs(id, armourTotal) }

/**
 * The name of `count` of `item`, as the player with `id` knows it.
 */
export val itemName = fn(id:str, item:map, count:num):str { actAs(id, fn() { nameOf(item, count) }) }

/**
 * The living players in the chunk the player with `id` is in, other than
 * them, as [id, player] pairs in id order.
 */
export val others = fn(id:str):list {
    actAs(id, fn() {
        val company = companyIn(playerKey())
        val go = fn(i:num, acc:list):list {
            if (i == len(company)) { acc } else { recur(i + 1, if (company[i][0] == id) { acc } else { acc :+ company[i] }) }
        }
        go(0, [])
    })
}
