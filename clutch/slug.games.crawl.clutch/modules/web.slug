/**
 * slug.games.crawl.web — Crawl in a web browser
 *
 * Serves one world of Crawl over `slug.net.http` to everyone who opens the
 * page, drawn as HTML from the Mustache templates in the clutch's assets
 * (`page.mustache`, `game.mustache`, and `pack-item.mustache`), with its
 * style and script beside them. The engine is `slug.games.crawl`.
 *
 * The world runs on a tick (150 milliseconds by default). The page posts
 * each key the game knows to `/key`, which queues it for that browser's
 * player; each tick carries out at most one queued key per player with the
 * engine's `tick`, and the world moves on whether anyone pressed a key or
 * not. Each open page listens on `/events`, a stream of server-sent events,
 * and the server pushes it the game's HTML after each tick that changed it.
 * A player whose page is closed is away: they stay in the world, but their
 * chunk stands still unless someone present is in it.
 *
 * A `crawl` cookie names each browser's player; a browser without one, or
 * with one this server does not know, joins as a new player. The ids are
 * not secret, so anyone who can reach the server can play as anyone.
 *
 * The page shows what the terminal screen folds into 24 rows on its own: the
 * map, with squares out of sight dimmed; the player's stats; the pack, whose
 * items act when clicked; the monsters in view; and a message log. It pages
 * through `--More--` itself, and the pack is always shown, so `i` is unused.
 *
 * ```slug
 * val tcp = import("slug.net.tcp")
 * val web = import("slug.games.crawl.web")
 *
 * web.serve(tcp.listen("127.0.0.1", 8080), {seed: 7})
 * ```
 */

val http = import("slug.net.http")
val tcp = import("slug.net.tcp")
val game = import("slug.games.crawl")
val data = import("slug.games.crawl.data")
val level = import("slug.games.crawl.level")
val {map, filter, contains} = import("slug.std")
val {chars, fromBytes} = import("slug.string")
val math = import("slug.math")
val mustache = import("slug.text.mustache")
val rng = import("slug.games.crawl.rng")
val {split, trim, join} = import("slug.string")
val {trySend} = import("slug.channel")

// The keys `/key` accepts, as the engine names them. `i` shows the pack in
// place of the map, which the page does not need.
val KEYS = chars("abcdefghjklmnopqrstuvwxyz") + ["left", "down", "up", "right", "space", "enter"]

// The command that uses each kind of item, with its button label.
val USES = {
    food: ["e", "Eat"], potion: ["q", "Quaff"], scroll: ["r", "Read"],
    weapon: ["w", "Wield"], armour: ["a", "Wear"],
}

// The item kind each item command's prompt asks for; nil for any.
val PROMPT_KINDS = {e: "food", q: "potion", r: "scroll", w: "weapon", a: "armour", d: nil}

val GLYPHS = {gold: "*", potion: "!", scroll: "?", food: ":", weapon: ")", armour: "]"}

// The class of each map character; capital letters are monsters.
val CLASSES = {
    ".": "floor", "#": "corridor", "+": "door", "-": "wall", "|": "wall",
    "%": "stairs", "<": "stairs", "*": "gold", "!": "potion", "?": "scroll", ":": "food",
    ")": "weapon", "]": "armour",
}

// How many messages the log keeps.
val LOG_SIZE = 60

// How many keys a player can queue ahead of the ticks.
val QUEUE_SIZE = 4

// How many ticks pass between keep-alive comments on each stream, which
// find streams whose page has gone.
val HEARTBEAT = 60

// Each player's log, by id: `log` holds [move, message] pairs, oldest
// first, and `moves` counts the commands that did something, so the latest
// move's messages can be told apart.
var logs = {}

// The world's seed, and how many players have joined, which numbers them.
var seed = 1
var joined = 0

// The keys waiting for a tick, `{id, key, shift}` in the order they came.
var queue = []

// The open event streams by player id, each a list of channels, the HTML
// each player was last sent, and how many ticks have run.
var streams = {}
var shown = {}
var ticks = 0

// Whether `serve` is serving, which keeps its ticks going.
var serving = false

val percent = fn(part:num, whole:num):num {
    if (whole <= 0) { 0 } else { math.max(0, math.min(100, math.div(part * 100, whole))) }
}

// The colour band of a player's health bar.
val band = fn(hp:num, maxHp:num):str {
    if (hp * 3 <= maxHp) { "low" } else if (hp * 3 <= maxHp * 2) { "mid" } else { "high" }
}

// --- Playing -----------------------------------------------------------------

val logOf = fn(id:str):map { logs[id] ?? {log: [], moves: 0} }

// Records the messages of a move that did something.
val record = fn(id:str, messages:list) {
    val l = logOf(id)
    val moves = l.moves + 1
    val all = l.log + map(messages, fn(message) { [moves, message] })
    logs = logs + {[id]: {log: if (len(all) > LOG_SIZE) { all[len(all) - LOG_SIZE:] } else { all }, moves: moves}}
}

/**
 * Adds a new player to the world and returns their id.
 */
export val newPlayer = fn():str {
    joined = joined + 1
    val id = "" + joined + "-" + rng.mix([seed, joined])
    game.join(id, "Player " + joined)
    record(id, game.playerOf(id).messages)
    id
}

/**
 * Queues command `key` for the player with `id`, with `shift` held or not,
 * for a coming tick; returns whether it was queued, which it is not when
 * they already have QUEUE_SIZE keys waiting.
 */
export val press = fn(id:str, key:str, shift:bool):bool {
    if (len(filter(queue, fn(a) { a.id == id })) >= QUEUE_SIZE) { return false }
    queue = queue :+ {id: id, key: key, shift: shift}
    true
}

/**
 * Runs one tick: carries out the first queued key of each player, moves the
 * world on, logs what each player was told, and pushes each open page its
 * game's HTML when it changed.
 */
export val tickOnce = fn() {
    // The first queued key of each player; the rest wait.
    val firsts = fn(i:num, now:list, later:list, seen:list):list {
        if (i == len(queue)) { return [now, later] }
        val a = queue[i]
        if (contains(seen, a.id)) { recur(i + 1, now, later :+ a, seen) } else { recur(i + 1, now :+ a, later, seen :+ a.id) }
    }
    val [actions, rest] = firsts(0, [], [], [])
    queue = rest
    val present = filter(keys(streams), fn(id) { len(streams[id]) > 0 })
    val wasDead = filter(map(actions, fn(a) { a.id }), fn(id) { game.playerOf(id).dead })
    game.tick(actions, present)
    ticks = ticks + 1
    // Log what each present player, or each who acted, was told.
    val actors = map(actions, fn(a) { a.id })
    val told = actors + filter(present, fn(id) { !contains(actors, id) })
    val log = fn(i:num) {
        if (i < len(told)) {
            val id = told[i]
            val p = game.playerOf(id)
            if (contains(wasDead, id) && !p.dead) { logs = logs - id }
            // A prompt's question is shown above the map, not logged.
            val said = filter(p.messages, fn(m) { p.prompt == nil || m != p.question })
            if (contains(actors, id) || len(said) > 0) { record(id, said) }
            recur(i + 1)
        }
    }
    log(0)
    push(present)
}

// Sends each present player's page their game's HTML when it changed, and
// a keep-alive comment every HEARTBEAT ticks; drops streams that are closed.
val push = fn(present:list) {
    val each = fn(i:num) {
        if (i < len(present)) {
            val id = present[i]
            val html = gameHtml(id)
            if (html != shown[id]) {
                shown = shown + {[id]: html}
                broadcast(id, event(html))
            } else if (ticks % HEARTBEAT == 0) {
                broadcast(id, ": alive\n\n")
            }
            recur(i + 1)
        }
    }
    each(0)
}

// One server-sent event of type `game` carrying `html`.
val event = fn(html:str):str {
    "event: game\n" + join(map(split(html, "\n"), fn(line) { "data: " + line }), "\n") + "\n\n"
}

// Sends `text` to each of the player's streams, dropping closed ones; a
// stream whose page is too slow to keep up misses this one.
val broadcast = fn(id:str, text:str) {
    val open = filter(streams[id] ?? [], fn(channel) {
        defer onerror(_) { return false }
        trySend(channel, text)
        true
    })
    streams = streams + {[id]: open}
}

// --- The view ----------------------------------------------------------------
//
// The templates in the clutch's assets draw the game from plain data, which
// these functions build. Mustache escapes the text they insert.

val GAME_TEXT = fromBytes(asset("game.mustache"))
val PAGE = mustache.parse(fromBytes(asset("page.mustache")))
val GAME = mustache.parse(GAME_TEXT)
val PARTIALS = {game: GAME_TEXT, "pack-item": fromBytes(asset("pack-item.mustache"))}

// How the map draws `c` at (x, y) for the player with `id` at `p`: its
// class, dimmed when the square is out of sight, and for a monster or
// another player their name; nil for a blank square.
val cell = fn(id:str, p:map, c:str, x:num, y:num):map {
    if (c == "@") {
        if (x == p.x && y == p.y) { return {cls: "you", title: nil} }
        val there = filter(game.others(id), fn(o) { o[1].x == x && o[1].y == y })
        return {cls: "ally", title: if (len(there) > 0) { there[0][1].name } else { nil }}
    }
    if (c >= "A" && c <= "Z") {
        val named = filter(data.monsters, fn(m) { m.letter == c })
        return {cls: "monster", title: if (len(named) > 0) { named[0].name } else { "monster" }}
    }
    val kind = CLASSES[c]
    if (kind == nil) {
        {cls: nil, title: nil}
    } else if (!game.visible(id, x, y)) {
        {cls: kind + " seen", title: nil}
    } else {
        {cls: kind, title: nil}
    }
}

// One row of the map as runs of characters that look alike.
val mapRow = fn(id:str, p:map, row:str, y:num, end:str):map {
    val go = fn(x:num, start:num, look:map, out:list):list {
        if (x == len(row)) { return out :+ (look + {text: row[start:x]}) }
        val next = cell(id, p, row[x], x, y)
        if (next == look) { recur(x + 1, start, look, out) } else { recur(x + 1, x, next, out :+ (look + {text: row[start:x]})) }
    }
    {runs: go(1, 0, cell(id, p, row[0], 0, y), []), end: end}
}

val mapRows = fn(id:str, p:map, rows:list):list {
    val go = fn(y:num, out:list):list {
        if (y == level.HEIGHT) { return out }
        recur(y + 1, out :+ mapRow(id, p, rows[y + 1], y, if (y < level.HEIGHT - 1) { "\n" } else { "" }))
    }
    go(0, [])
}

val statsView = fn(id:str, p:map):map {
    val hunger = if (p.food <= 0) { "Faint" } else if (p.food <= 50) { "Weak" } else if (p.food <= 150) { "Hungry" } else { "" }
    {
        hp: p.hp, maxHp: p.maxHp, health: percent(p.hp, p.maxHp),
        band: band(p.hp, p.maxHp),
        depth: p.depth, area: "" + p.cx + ", " + p.cy, gold: p.gold, str: p.str, maxStr: p.maxStr,
        armour: game.armourValue(id), level: p.level, xp: p.xp,
        conditions: filter([
            hunger,
            if (p.confused > 0) { "Confused" } else { "" },
            if (p.blind > 0) { "Blind" } else { "" },
            if (p.frozen > 0) { "Frozen" } else { "" },
            if (p.sense) { "Sensing" } else { "" },
        ], fn(c) { c != "" }),
    }
}

// The pack: while a prompt asks for an item, the items it accepts can be
// chosen and the rest are disabled; otherwise clicking an item uses it.
val packView = fn(id:str, p:map):map {
    val asking = p.prompt != nil
    val wanted = if (asking) { PROMPT_KINDS[p.prompt] } else { nil }
    val item = fn(e:map):map {
        val kind = e.item.kind
        val fits = wanted == nil || kind == wanted
        {
            letter: e.letter, kind: kind, glyph: GLYPHS[kind] ?? "?", name: game.itemName(id, e.item, e.count),
            tag: if (e.letter == p.weapon) { "in hand" } else if (e.letter == p.armour) { "worn" } else { nil },
            choose: asking && fits, disabled: asking && !fits,
            use: if (asking) { nil } else { {title: (USES[kind] ?? [nil, nil])[1]} },
        }
    }
    {asking: asking, count: len(p.pack), size: 22, items: map(p.pack, item)}
}

// Who is in view: other players the player sees, then monsters.
val foesView = fn(id:str, p:map):list {
    val people = filter(game.others(id), fn(o) { game.visible(id, o[1].x, o[1].y) })
    val seen = filter(game.here(id).monsters, fn(m) { p.sense || game.visible(id, m.x, m.y) })
    map(people, fn(o) { {cls: "ally", bar: band(o[1].hp, o[1].maxHp), letter: "@", name: o[1].name, asleep: false, health: percent(o[1].hp, o[1].maxHp)} })
        + map(seen, fn(m) {
            val kind = data.monsters[m.kind]
            {cls: "monster", bar: "foe", letter: kind.letter, name: kind.name, asleep: m.state == "asleep", health: percent(m.hp, m.maxHp)}
        })
}

val overView = fn(p:map) {
    if (p.dead) {
        {title: "You died.", detail: "On depth " + p.depth + ", with " + p.gold + " gold, at experience level " + p.level + "."}
    } else {
        nil
    }
}

// The data the game template draws: above the map, the prompt's question or
// what the latest move said; below it, the older messages.
val view = fn(id:str):map {
    val p = game.playerOf(id)
    val prompt = p.prompt != nil
    val foes = foesView(id, p)
    val l = logOf(id)
    {
        prompt: prompt,
        top: if (prompt) { [p.question] } else { map(filter(l.log, fn(entry) { entry[0] == l.moves }), fn(entry) { entry[1] }) },
        rows: mapRows(id, p, game.text(id)),
        over: overView(p),
        log: map(filter(l.log, fn(entry) { entry[0] != l.moves }), fn(entry) { entry[1] }),
        foes: foes,
        hasFoes: len(foes) > 0,
        name: p.name,
        stats: statsView(id, p),
        pack: packView(id, p),
    }
}

/**
 * The game's HTML for the player with `id`, which the page's `#game`
 * element holds.
 */
export val gameHtml = fn(id:str):str { mustache.render(GAME, view(id), PARTIALS) }

// --- Serving -----------------------------------------------------------------

val html = fn(body:str):map {
    {status: 200, headers: {"Content-Type": "text/html; charset=utf-8", "Cache-Control": "no-store"}, body: body}
}

// A static file from the clutch's assets.
val file = fn(name:str, body:bytes):map {
    {status: 200, headers: {"Content-Type": http.mediaType(name), "Cache-Control": "no-cache"}, body: body}
}

// The id in the request's `crawl` cookie, or nil.
val cookieId = fn(request:map):str|nil {
    val pairs = map(split(request.headers.cookie ?? "", ";"), fn(part) { split(trim(part), "=") })
    val ours = filter(pairs, fn(pair) { len(pair) == 2 && pair[0] == "crawl" })
    if (len(ours) == 0) { nil } else { ours[0][1] }
}

// Answers `request` with `respond(id)` for the browser's player: the one its
// cookie names, or a new player, whose cookie the response sets.
val asPlayer = fn(request:map, respond:fn):map {
    val known = match cookieId(request) {
        id: str => if (game.playing(id)) { id } else { nil }
        _ => nil
    }
    match known {
        id: str => respond(id)
        _ => {
            val id = newPlayer()
            val response = respond(id)
            val cookie = "crawl=" + id + "; Path=/; HttpOnly; SameSite=Strict"
            response copy {headers: (response.headers ?? {}) + {"Set-Cookie": cookie}}
        }
    }
}

val onKey = fn(request:map):map {
    asPlayer(request, fn(id) {
        val fields = http.form(request)
        val key = fields.key ?? ""
        if (contains(KEYS, key)) { press(id, key, fields.shift == "true") }
        {status: 204}
    })
}

// Uses a pack item the way its kind is used: eats food, wields a weapon.
val onUse = fn(request:map):map {
    asPlayer(request, fn(id) {
        val letter = http.form(request).letter ?? ""
        val p = game.playerOf(id)
        val held = filter(p.pack, fn(e) { e.letter == letter })
        if (len(held) == 0 || p.prompt != nil || p.dead || len(p.more) > 0) { return {status: 204} }
        val use = USES[held[0].item.kind]
        if (use != nil && press(id, use[0], false)) { press(id, letter, false) }
        {status: 204}
    })
}

// A stream of the player's game as server-sent events, starting with how it
// is now.
val onEvents = fn(request:map):map {
    asPlayer(request, fn(id) {
        val channel = chan(8)
        val html = gameHtml(id)
        trySend(channel, event(html))
        streams = streams + {[id]: (streams[id] ?? []) :+ channel}
        shown = shown + {[id]: html}
        {status: 200, headers: {"Content-Type": "text/event-stream", "Cache-Control": "no-store"}, body: channel}
    })
}

/**
 * The HTTP handler for the game: `GET /` serves the page; `/htmx.js`,
 * `/crawl.css`, and `/crawl.js` the clutch's assets; and `POST /key` and
 * `POST /use` play.
 */
export val handler = fn():fn {
    http.router([
        ["GET", "/", fn(request) { asPlayer(request, fn(id) { html(mustache.render(PAGE, view(id), PARTIALS)) }) }],
        ["GET", "/htmx.js", fn(request) { file("htmx.js", asset("htmx.js")) }],
        ["GET", "/crawl.css", fn(request) { file("crawl.css", asset("crawl.css")) }],
        ["GET", "/crawl.js", fn(request) { file("crawl.js", asset("crawl.js")) }],
        ["POST", "/key", onKey],
        ["POST", "/use", onUse],
        ["GET", "/events", onEvents],
    ])
}

/**
 * Starts a new world with `worldSeed`, with no one in it.
 */
export val start = fn(worldSeed:num) {
    game.newGame(worldSeed)
    seed = worldSeed
    joined = 0
    logs = {}
    queue = []
    streams = {}
    shown = {}
    ticks = 0
}

/**
 * Starts a new world with `options.seed` (default 1) and serves it on
 * `listener`, ticking every `options.tick` milliseconds (default 150), until
 * the listener closes.
 */
export val serve = fn(listener:tcp.Listener, options:map = {}) {
    start(options.seed ?? 1)
    serving = true
    val every = options.tick ?? 150
    spawn {
        val loop = fn() {
            if (serving) {
                select { after every /> fn(_) { nil } }
                tickOnce()
                recur()
            }
        }
        loop()
    }
    http.serve(listener, handler())
    serving = false
}
