/**
 * Crawl's random numbers: one slug.random generator, whose state snapshots
 * save and restore, and the game's own draws on top of it. slug.random is
 * the xorshift32 the spec defines, so games play exactly as the spec says.
 */
val random = import("slug.random")

var gen = random.generator(0)

/**
 * Starts the sequence for a game's seed; seeds equal modulo 2^32 are the
 * same.
 */
export val seed = fn(s:num):nil {
    gen = random.generator(s)
    nil
}

export val getState = fn():num { gen.state() }

export val setState = fn(s:num):nil {
    gen = random.generator(s)
    nil
}

/**
 * An integer from 0 to n - 1, each equally likely.
 */
export val below = fn(n:num):num { gen.below(n) }

/**
 * The sum of `dice` draws of `below(sides) + 1`; zero dice draw nothing.
 */
export val roll = fn(dice:num, sides:num):num {
    val go = fn(i:num, total:num):num {
        if (i == dice) { total } else { recur(i + 1, total + below(sides) + 1) }
    }
    go(0, 0)
}

/**
 * The index of an entry chosen by weight: one draw r = below(total of the
 * weights), then the first entry whose running total exceeds r.
 */
export val pick = fn(entries:list):num {
    val total = fn(i:num, sum:num):num {
        if (i == len(entries)) { sum } else { recur(i + 1, sum + entries[i].weight) }
    }
    val r = below(total(0, 0))
    val find = fn(i:num, sum:num):num {
        val next = sum + entries[i].weight
        if (r < next) { i } else { recur(i + 1, next) }
    }
    find(0, 0)
}

/**
 * A shuffled copy: for i from len - 1 down to 1, swap entry i with entry
 * below(i + 1).
 */
export val shuffle = fn(items:list):list { gen.shuffle(items) }
