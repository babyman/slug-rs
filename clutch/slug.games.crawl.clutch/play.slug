/**
 * Plays Crawl in a web browser: serves slug.games.crawl.web and prints its
 * address.
 *
 * Options: `--port N` (default 8080; 0 picks a free one), `--host H`
 * (default 127.0.0.1), `--seed N` (default: a fresh world each time; the
 * seed is printed, so a world can be played again), `--tick MS`, the
 * milliseconds between the world's ticks (default 150), `--pace N`, how
 * many ticks pass for each move of the monsters (default 4), and
 * `--restock N`, how many ticks a chunk stays as it was with no one in it
 * before it gets fresh monsters and items (default 2000, 5 minutes).
 */
val tcp = import("slug.net.tcp")
val web = import("slug.games.crawl.web")
val secure = import("slug.random.secure")

val main = fn() {
    val host = cfg("host", "127.0.0.1")
    val listener = tcp.listen(host, cfg("port", 8080))
    val seed = cfg("seed", -1)
    val world = if (seed < 0) { secure.seed() } else { seed }
    println("Crawl: http://" + host + ":" + tcp.localPort(listener) + "/ (world seed " + world + ")")
    web.serve(listener, {seed: world, tick: cfg("tick", 150), pace: cfg("pace", 4), restock: cfg("restock", 2000)})
}
