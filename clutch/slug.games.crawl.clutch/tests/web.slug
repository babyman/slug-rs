val web = import("slug.games.crawl.web")
val game = import("slug.games.crawl")
val {toBytes, fromBytes, split} = import("slug.string")
val {recv} = import("slug.channel")
val {map} = import("slug.std")
val {assertEqual, assertTrue} = import("slug.test")

// Whether `text` contains `part`.
val includes = fn(text:str, part:str):bool {
    val go = fn(i:num):bool {
        if (i + len(part) > len(text)) { false } else if (text[i:i + len(part)] == part) { true } else { recur(i + 1) }
    }
    go(0)
}

val headersFor = fn(id:str|nil):map {
    if (id == nil) { {} } else { {cookie: "theme=dark; crawl=" + id} }
}

val get = fn(path:str, id:str|nil = nil):map {
    web.handler()({method: "GET", path: path, query: {}, headers: headersFor(id), body: 0x"", params: {}})
}

val post = fn(path:str, body:str, id:str|nil = nil):map {
    val headers = headersFor(id) + {"content-type": "application/x-www-form-urlencoded"}
    web.handler()({method: "POST", path: path, query: {}, headers: headers, body: toBytes(body), params: {}})
}

// The id a response's cookie gives.
val cookieOf = fn(response:map):str {
    split(split(response.headers["Set-Cookie"], ";")[0], "=")[1]
}

@test
val servesThePageAndHtmx = fn() {
    web.start(1)
    val page = get("/")
    assertEqual(page.status, 200)
    assertTrue(includes(page.body, "<script src=\"/htmx.js\"></script>"))
    assertTrue(includes(page.body, "Welcome to the dungeon."))
    val script = get("/htmx.js")
    assertEqual(script.headers["Content-Type"], "text/javascript; charset=utf-8")
    assertTrue(includes(fromBytes(script.body), "var htmx="))
}

@test
val aNewBrowserJoinsAndKeepsItsPlayer = fn() {
    web.start(1)
    val first = get("/")
    val id = cookieOf(first)
    assertTrue(includes(first.headers["Set-Cookie"], "HttpOnly"))
    assertTrue(game.playing(id))
    val again = get("/", id)
    assertEqual(again.headers["Set-Cookie"], nil)
    assertEqual(len(game.current().players), 1)
    val stranger = get("/", "unknown")
    assertTrue(cookieOf(stranger) != id)
    assertEqual(len(game.current().players), 2)
}

@test
val keysWaitForTheNextTick = fn() {
    web.start(1)
    val id = web.newPlayer()
    val before = game.playerOf(id)
    assertEqual(post("/key", "key=h&shift=false", id).status, 204)
    assertEqual(game.playerOf(id), before)
    web.tickOnce()
    assertTrue(game.playerOf(id).x != before.x || game.playerOf(id).messages != before.messages)
    assertTrue(includes(web.gameHtml(id), "class=\"you\""))
}

@test
val unknownKeysAreIgnored = fn() {
    web.start(1)
    val id = web.newPlayer()
    val before = game.playerOf(id)
    assertEqual(post("/key", "key=i", id).status, 204)
    assertEqual(post("/key", "key=f1", id).status, 204)
    assertEqual(post("/key", "", id).status, 204)
    web.tickOnce()
    assertEqual(game.playerOf(id), before)
}

@test
val aPlayerCanQueueOnlyAFewKeys = fn() {
    web.start(1)
    val id = web.newPlayer()
    assertEqual(map4(fn() { web.press(id, "space", false) }), [true, true, true, true])
    assertEqual(web.press(id, "space", false), false)
    web.tickOnce()
    assertEqual(web.press(id, "space", false), true)
}

val map4 = fn(body:fn):list { [body(), body(), body(), body()] }

@test
val itemPromptsOfferMatchingItems = fn() {
    web.start(1)
    val id = web.newPlayer()
    post("/key", "key=e", id)
    web.tickOnce()
    val asked = web.gameHtml(id)
    assertTrue(includes(asked, "Eat which item?"))
    assertTrue(includes(asked, "hx-vals='{\"key\": \"c\"}'"))
    assertTrue(includes(asked, "<button class=\"item\" disabled>"))
    post("/key", "key=space", id)
    web.tickOnce()
    assertEqual(game.playerOf(id).prompt, nil)
}

@test
val clickingAnItemUsesIt = fn() {
    web.start(1)
    val id = web.newPlayer()
    assertEqual(len(game.playerOf(id).pack), 3)
    assertEqual(post("/use", "letter=c", id).status, 204)
    web.tickOnce()
    web.tickOnce()
    assertEqual(len(game.playerOf(id).pack), 2)
    assertEqual(post("/use", "letter=z", id).status, 204)
}

@test
val eventsStreamTheGameAfterEachChange = fn() {
    web.start(1)
    val id = web.newPlayer()
    val events = get("/events", id)
    assertEqual(events.headers["Content-Type"], "text/event-stream")
    val first = recv(events.body, 1000)
    assertTrue(includes(first, "event: game\ndata: "))
    assertTrue(includes(first, "Welcome to the dungeon."))
    web.press(id, "e", false)
    web.tickOnce()
    assertTrue(includes(recv(events.body, 1000), "Eat which item?"))
    // A closed stream is dropped, and its player is away.
    close(events.body)
    web.tickOnce()
    web.tickOnce()
}

@test
val deathOffersANewCharacterInTheSameWorld = fn() {
    web.start(1)
    val id = web.newPlayer()
    val alive = game.snapshot()
    val p = alive.players[id]
    game.load(alive copy {players: alive.players + {[id]: p copy {dead: true, gold: 99}}})
    assertTrue(includes(web.gameHtml(id), "You died."))
    post("/key", "key=enter", id)
    web.tickOnce()
    val now = game.current()
    assertEqual(now.world.seed, alive.world.seed)
    val kept = keys(alive.levels)
    assertEqual(map(kept, fn(k) { now.levels[k] }), map(kept, fn(k) { alive.levels[k] }))
    assertEqual(now.players[id].dead, false)
    assertEqual(now.players[id].depth, 1)
    assertEqual(now.players[id].gold, 0)
    assertEqual(now.players[id].name, p.name)
}

@test
val playersSeeEachOther = fn() {
    web.start(1)
    val a = web.newPlayer()
    val b = web.newPlayer()
    // Put b next to a.
    val s = game.snapshot()
    val pa = s.players[a]
    val spot = if (game.here(a).map[pa.y][pa.x + 1] == ".") { pa.x + 1 } else { pa.x - 1 }
    game.load(s copy {players: s.players + {[b]: s.players[b] copy {cx: pa.cx, cy: pa.cy, depth: 1, x: spot, y: pa.y}}})
    val html = web.gameHtml(a)
    assertTrue(includes(html, "class=\"ally\" title=\"Player 2\""))
    assertTrue(includes(html, "<i class=\"ally\">@</i>"))
    assertTrue(includes(web.gameHtml(b), "title=\"Player 1\""))
}

// Plays many seeded games with pseudo-random keys for two players: every
// move renders, and none leaves a --More-- waiting.
@test
val randomPlayNeverLeavesMore = fn() {
    val keys = ["h", "j", "k", "l", "y", "u", "b", "n", "space", "enter", "e", "q", "r", "w", "a", "d", "c", "f"]
    web.start(3)
    val ids = [web.newPlayer(), web.newPlayer()]
    val go = fn(i:num, seed:num) {
        if (i == 800) { return nil }
        val next = (seed * 1103515245 + 12345) % 2147483648
        val id = ids[i % 2]
        web.press(id, keys[next % len(keys)], next % 7 == 0)
        web.tickOnce()
        assertEqual(game.playerOf(id).more, [])
        assertTrue(len(web.gameHtml(id)) > 0)
        recur(i + 1, next)
    }
    go(0, 3)
}

@test
val aPromptStaysAboveTheMapWhileTheWorldMoves = fn() {
    web.start(1)
    val id = web.newPlayer()
    val events = get("/events", id)
    web.press(id, "e", false)
    web.tickOnce()
    web.tickOnce()
    web.tickOnce()
    assertEqual(game.playerOf(id).messages, [])
    assertTrue(includes(web.gameHtml(id), "Eat which item? (space to cancel)"))
    close(events.body)
}
