val game = import("slug.games.crawl")
val level = import("slug.games.crawl.level")
val rng = import("slug.games.crawl.rng")
val {assertEqual, assertTrue} = import("slug.test")
val {map, filter, range} = import("slug.std")

val PASSABLE = [level.FLOOR, level.CORRIDOR, level.DOOR, level.STAIRS, level.UP, level.SCRUB, level.TREE]

val contains = fn(xs:list, v):bool {
    val go = fn(i:num):bool {
        if (i == len(xs)) { false } else if (xs[i] == v) { true } else { recur(i + 1) }
    }
    go(0)
}

val passable = fn(lv:map, x:num, y:num):bool {
    x >= 0 && x < level.WIDTH && y >= 0 && y < level.HEIGHT && contains(PASSABLE, lv.map[y][x])
}

// The squares reachable from `start` by the game's step rule, as a map from
// "x,y" to true.
val reach = fn(lv:map, start:map):map {
    val go = fn(queue:list, head:num, seen:map):map {
        if (head == len(queue)) { return seen }
        val c = queue[head]
        val each = fn(i:num, q:list, seen:map):list {
            if (i == 8) { return [q, seen] }
            val d = [[-1, 0], [0, 1], [0, -1], [1, 0], [-1, -1], [1, -1], [-1, 1], [1, 1]][i]
            val x = c[0] + d[0]
            val y = c[1] + d[1]
            val key = "" + x + "," + y
            val ok = passable(lv, x, y) && seen[key] == nil
                && (d[0] == 0 || d[1] == 0 || (passable(lv, x, c[1]) && passable(lv, c[0], y)))
            if (ok) { recur(i + 1, q :+ [x, y], seen + {[key]: true}) } else { recur(i + 1, q, seen) }
        }
        match each(0, queue, seen) {
            [q, s] => recur(q, head + 1, s)
        }
    }
    go([[start.x, start.y]], 0, {["" + start.x + "," + start.y]: true})
}

val reached = fn(seen:map, x:num, y:num):bool { seen["" + x + "," + y] == true }

// The open squares on a border: a column when `x` is a number, else a row.
val openOnColumn = fn(lv:map, x:num):list {
    val go = fn(y:num, acc:list):list {
        if (y == level.HEIGHT) { acc } else { recur(y + 1, if (passable(lv, x, y)) { acc :+ y } else { acc }) }
    }
    go(0, [])
}

val openOnRow = fn(lv:map, y:num):list {
    val go = fn(x:num, acc:list):list {
        if (x == level.WIDTH) { acc } else { recur(x + 1, if (passable(lv, x, y)) { acc :+ x } else { acc }) }
    }
    go(0, [])
}

// Calls `body(cx, cy, depth)` for each chunk from -1 to 1 on each axis of
// depths 1 and 2.
val eachChunk = fn(body:fn) {
    val go = fn(i:num) {
        if (i < 18) {
            body(i % 3 - 1, int(i / 3) % 3 - 1, int(i / 9) + 1)
            recur(i + 1)
        }
    }
    go(0)
}

@test
val mixedSeedsDifferForNeighbours = fn() {
    assertEqual(rng.mix([1, 2, 3]), rng.mix([1, 2, 3]))
    assertTrue(rng.mix([1, 2, 3]) != rng.mix([1, 2, 4]))
    assertTrue(rng.mix([1, 2, 3]) != rng.mix([1, 3, 2]))
    assertTrue(rng.mix([1, -1, 0]) != rng.mix([1, 0, -1]))
    assertTrue(rng.mix([1, 2, 3]) >= 0 && rng.mix([1, 2, 3]) <= 0xFFFFFFFF)
}

@test
val chunksAreTheSameEachTime = fn() {
    assertEqual(level.generate(7, 3, -2, 4), level.generate(7, 3, -2, 4))
    assertTrue(level.generate(7, 3, -2, 4).map != level.generate(7, 4, -2, 4).map)
}

@test
val neighboursShareOneOpeningOnEachEdge = fn() {
    eachChunk(fn(cx, cy, depth) {
        val lv = level.generate(5, cx, cy, depth)
        val east = level.generate(5, cx + 1, cy, depth)
        val south = level.generate(5, cx, cy + 1, depth)
        val row = openOnColumn(lv, level.WIDTH - 1)
        assertEqual(len(row), 1)
        assertEqual(openOnColumn(east, 0), row)
        val column = openOnRow(lv, level.HEIGHT - 1)
        assertEqual(len(column), 1)
        assertEqual(openOnRow(south, 0), column)
    })
}

@test
val everythingInAChunkIsReachable = fn() {
    eachChunk(fn(cx, cy, depth) {
        val lv = level.generate(9, cx, cy, depth)
        val seen = reach(lv, lv.start)
        assertTrue(reached(seen, lv.down.x, lv.down.y))
        assertTrue(reached(seen, lv.up.x, lv.up.y))
        assertTrue(reached(seen, level.WIDTH - 1, openOnColumn(lv, level.WIDTH - 1)[0]))
        assertTrue(reached(seen, 0, openOnColumn(lv, 0)[0]))
        assertTrue(reached(seen, openOnRow(lv, 0)[0], 0))
        assertTrue(reached(seen, openOnRow(lv, level.HEIGHT - 1)[0], level.HEIGHT - 1))
        val items = fn(i:num) {
            if (i < len(lv.items)) {
                assertTrue(reached(seen, lv.items[i].x, lv.items[i].y))
                recur(i + 1)
            }
        }
        items(0)
    })
}

@test
val deepChunksHaveMonstersFromTheDeepestTable = fn() {
    val lv = level.generate(3, 0, 0, 40)
    assertTrue(lv.up != nil)
    assertTrue(len(lv.map) == level.HEIGHT)
}

val ME = "me"

// Moves the player to (x, y) in the chunk they are in.
val placePlayer = fn(x:num, y:num) {
    val s = game.snapshot()
    game.load(s copy {players: s.players + {[ME]: s.players[ME] copy {x: x, y: y}}})
}

// Starts a world with `seed` and `options`, joins it, and takes the stairs
// from the surface down to depth 1.
val intoTheDungeon = fn(seed:num, options:map = {}) {
    game.newGame(seed, options)
    game.join(ME, "me")
    val down = game.here(ME).down
    placePlayer(down.x, down.y)
    game.command(ME, "enter", false)
}

@test
val walkingOffAnOpeningEntersTheNextChunk = fn() {
    intoTheDungeon(4)
    val before = game.playerOf(ME)
    val row = openOnColumn(game.here(ME), level.WIDTH - 1)[0]
    placePlayer(level.WIDTH - 1, row)
    game.command(ME, "l", false)
    val after = game.playerOf(ME)
    assertEqual([after.cx, after.cy, after.depth, after.x, after.y], [before.cx + 1, before.cy, 1, 0, row])
    game.command(ME, "h", false)
    val back = game.playerOf(ME)
    assertEqual([back.cx, back.x, back.y], [before.cx, level.WIDTH - 1, row])
}

@test
val wallsAtTheEdgeDoNotLeadAnywhere = fn() {
    intoTheDungeon(4)
    val row = openOnColumn(game.here(ME), level.WIDTH - 1)[0]
    placePlayer(level.WIDTH - 1, row)
    val before = game.current()
    game.command(ME, "u", false)
    game.command(ME, "n", false)
    assertEqual(game.playerOf(ME).cx, before.players[ME].cx)
}

@test
val stairsLeadDownAndBackUp = fn() {
    intoTheDungeon(6)
    val top = game.playerOf(ME)
    val down = game.here(ME).down
    placePlayer(down.x, down.y)
    game.command(ME, "enter", false)
    val below = game.playerOf(ME)
    assertEqual([below.cx, below.cy, below.depth], [top.cx, top.cy, 2])
    assertEqual({x: below.x, y: below.y}, game.here(ME).up)
    game.command(ME, "enter", false)
    val again = game.playerOf(ME)
    assertEqual([again.cx, again.cy, again.depth, again.x, again.y], [top.cx, top.cy, 1, down.x, down.y])
    // From depth 1 the stairs up lead to the surface.
    val up = game.here(ME).up
    placePlayer(up.x, up.y)
    game.command(ME, "enter", false)
    val out = game.playerOf(ME)
    assertEqual([out.cx, out.cy, out.depth], [top.cx, top.cy, 0])
    assertEqual({x: out.x, y: out.y}, game.here(ME).down)
}

@test
val chunksKeepWhatHappenedInThem = fn() {
    intoTheDungeon(6)
    val key = game.chunkKey(game.playerOf(ME).cx, game.playerOf(ME).cy, 1)
    assertEqual(game.playerOf(ME).depth, 1)
    val down = game.here(ME).down
    placePlayer(down.x, down.y)
    val before = game.current().levels[key]
    game.command(ME, "enter", false)
    game.command(ME, "enter", false)
    assertEqual(game.current().levels[key].map, before.map)
    assertEqual(game.current().levels[key].items, before.items)
}

// Empties the chunk the player is in but for one dropped food ration at
// (x, y), and returns its key.
val emptyChunk = fn(x:num, y:num):str {
    val p = game.playerOf(ME)
    val key = game.chunkKey(p.cx, p.cy, p.depth)
    val s = game.snapshot()
    val dropped = {x: x, y: y, item: {kind: "food"}, dropped: true}
    game.load(s copy {levels: s.levels + {[key]: s.levels[key] + {monsters: [], items: [dropped]}}})
    key
}

// Leaves through the east opening, spends `turns` turns in the next chunk,
// and comes back.
val awayFor = fn(turns:num) {
    val row = openOnColumn(game.here(ME), level.WIDTH - 1)[0]
    placePlayer(level.WIDTH - 1, row)
    game.command(ME, "l", false)
    val wait = fn(n:num) { if (n > 0) { game.command(ME, "space", false); recur(n - 1) } }
    wait(turns)
    game.command(ME, "h", false)
}

@test
val chunksRestockAfterNoOneHasBeenThereAWhile = fn() {
    intoTheDungeon(4, {restockAfter: 10})
    val down = game.here(ME).down
    val key = emptyChunk(down.x - 1, down.y)
    awayFor(10)
    val lv = game.current().levels[key]
    assertEqual(lv.restocks, 1)
    assertTrue(len(lv.items) > 1)
    assertEqual(lv.items[0], {x: down.x - 1, y: down.y, item: {kind: "food"}, dropped: true})
}

@test
val chunksStayAsTheyWereForAShortAbsence = fn() {
    intoTheDungeon(4, {restockAfter: 10})
    val down = game.here(ME).down
    val key = emptyChunk(down.x - 1, down.y)
    awayFor(5)
    val lv = game.current().levels[key]
    assertEqual(lv.restocks, nil)
    assertEqual(lv.monsters, [])
    assertEqual(len(lv.items), 1)
}

@test
val restockingIsSeededByItsCount = fn() {
    val lv = level.generate(2, 1, 1, 3)
    val first = level.restock(2, 1, 1, 3, 1, lv, [], [])
    assertEqual(level.restock(2, 1, 1, 3, 1, lv, [], []), first)
    assertTrue(level.restock(2, 1, 1, 3, 2, lv, [], []) != first)
    val spots = map(first.items + first.monsters, fn(t) { lv.map[t.y][t.x] })
    assertEqual(filter(spots, fn(c) { c != level.FLOOR }), [])
}

@test
val theViewStitchesChunksTogether = fn() {
    intoTheDungeon(4)
    val p = game.playerOf(ME)
    val ox = p.cx * level.WIDTH
    val oy = p.cy * level.HEIGHT
    // The whole chunk the player is in is the text's map.
    assertEqual(game.view(ME, ox, oy, level.WIDTH, level.HEIGHT), game.text(ME)[1:level.HEIGHT + 1])
    // A window across the east edge: the chunk's last ten columns, then
    // nothing of a chunk the player has never seen.
    val across = game.view(ME, ox + level.WIDTH - 10, oy, 20, level.HEIGHT)
    assertEqual(across[3][:10], game.text(ME)[4][level.WIDTH - 10:])
    assertEqual(across[3][10:], " " * 10)
    // After walking through, the view from the next chunk shows the one
    // remembered behind it.
    val row = openOnColumn(game.here(ME), level.WIDTH - 1)[0]
    placePlayer(level.WIDTH - 1, row)
    game.command(ME, "space", false)
    game.command(ME, "l", false)
    val back = game.view(ME, ox + level.WIDTH - 1, oy + row, 2, 1)[0]
    assertEqual(back, "#@")
}

// The surface.

@test
val newCharactersStartOnTheSurfaceNearTheMiddle = fn() {
    game.newGame(3)
    game.join(ME, "me")
    val p = game.playerOf(ME)
    assertEqual(p.depth, 0)
    assertTrue(p.cx >= 14 && p.cx <= 18 && p.cy >= 14 && p.cy <= 18)
    assertEqual(game.here(ME).outdoor, true)
}

@test
val theSurfaceIsOpenCountryWithAWayDown = fn() {
    val each = fn(i:num) {
        if (i < 9) {
            val lv = level.generate(5, 10 + i % 3, 10 + int(i / 3), 0, 32)
            assertEqual(lv.map, level.generate(5, 10 + i % 3, 10 + int(i / 3), 0, 32).map)
            assertEqual(lv.map[lv.down.y][lv.down.x], level.STAIRS)
            assertEqual(lv.up, nil)
            assertTrue(reached(reach(lv, lv.start), lv.down.x, lv.down.y))
            val spots = map(lv.items + lv.monsters, fn(t) { lv.map[t.y][t.x] })
            assertEqual(filter(spots, fn(c) { c != level.FLOOR }), [])
            recur(i + 1)
        }
    }
    each(0)
}

@test
val theSurfaceEndsInSeaAtTheWorldsBounds = fn() {
    val corner = level.generate(5, 0, 0, 0, 32)
    assertEqual(corner.map[0], level.WATER * level.WIDTH)
    assertEqual(filter(map(corner.map, fn(row) { row[0] }), fn(c) { c != level.WATER }), [])
    val far = level.generate(5, 31, 31, 0, 32)
    assertEqual(far.map[level.HEIGHT - 1], level.WATER * level.WIDTH)
    assertEqual(filter(map(far.map, fn(row) { row[level.WIDTH - 1] }), fn(c) { c != level.WATER }), [])
}

@test
val dungeonEdgesAtTheWorldsBoundsHaveNoOpening = fn() {
    val lv = level.generate(5, 0, 0, 1, 32)
    assertEqual(openOnColumn(lv, 0), [])
    assertEqual(openOnRow(lv, 0), [])
    assertEqual(len(openOnColumn(lv, level.WIDTH - 1)), 1)
    assertEqual(len(openOnRow(lv, level.HEIGHT - 1)), 1)
}

@test
val anyOpenSquareOfASurfaceEdgeLeadsAcross = fn() {
    game.newGame(4)
    game.join(ME, "me")
    val p = game.playerOf(ME)
    val here = game.here(ME)
    val next = level.generate(4, p.cx + 1, p.cy, 0, 32)
    val clear = fn(lv:map, x:num, y:num):bool {
        passable(lv, x, y) && len(filter(lv.monsters, fn(m) { m.x == x && m.y == y })) == 0
    }
    val rows = filter(openOnColumn(here, level.WIDTH - 1), fn(y) { clear(next, 0, y) })
    assertTrue(len(rows) > 1)
    val row = rows[len(rows) - 1]
    placePlayer(level.WIDTH - 1, row)
    game.command(ME, "l", false)
    val after = game.playerOf(ME)
    assertEqual([after.cx, after.cy, after.depth, after.x, after.y], [p.cx + 1, p.cy, 0, 0, row])
}

@test
val noOneWalksOffTheWorld = fn() {
    game.newGame(4)
    game.join(ME, "me")
    val s = game.snapshot()
    val key = game.chunkKey(0, 16, 0)
    val edge = level.generate(4, 0, 16, 0, 32)
    val moved = s.players[ME] copy {cx: 0, cy: 16, depth: 0, x: 0, y: 10}
    game.load(s copy {levels: s.levels + {[key]: edge}, players: s.players + {[ME]: moved}})
    game.command(ME, "h", false)
    assertEqual([game.playerOf(ME).cx, game.playerOf(ME).x], [0, 0])
}

@test
val outdoorsPlayersSeeFarButNotThroughTrees = fn() {
    game.newGame(4)
    game.join(ME, "me")
    val s = game.snapshot()
    val p = s.players[ME]
    val key = game.chunkKey(p.cx, p.cy, 0)
    val open = map(range(level.HEIGHT), fn(y) {
        if (y == 11) { "." * 45 + level.TREE + "." * 34 } else { "." * level.WIDTH }
    })
    val lv = s.levels[key] + {map: open, items: [], monsters: []}
    game.load(s copy {levels: s.levels + {[key]: lv}, players: s.players + {[ME]: p copy {x: 40, y: 11}}})
    assertTrue(game.visible(ME, 45, 11))
    assertTrue(!game.visible(ME, 50, 11))
    assertTrue(game.visible(ME, 40, 3))
    assertTrue(game.visible(ME, 56, 7))
    assertTrue(!game.visible(ME, 59, 7))
    assertTrue(!game.visible(ME, 40, 1))
}

// Whether `inView` says what `visible` says of every square of the chunk
// the player is in.
val inViewAgrees = fn():bool {
    val sight = game.inView(ME)
    val differ = filter(range(level.WIDTH * level.HEIGHT), fn(c) {
        val x = c % level.WIDTH
        val y = int(c / level.WIDTH)
        (sight[game.viewKey(x, y)] == true) != game.visible(ME, x, y)
    })
    len(differ) == 0
}

@test
val theSquaresInViewAreTheVisibleOnes = fn() {
    game.newGame(4)
    game.join(ME, "me")
    assertTrue(inViewAgrees())
    val down = game.here(ME).down
    placePlayer(down.x, down.y)
    game.command(ME, "enter", false)
    assertEqual(game.playerOf(ME).depth, 1)
    assertTrue(inViewAgrees())
    val room = filter(game.here(ME).rooms, fn(r) { !r.gone })[0]
    placePlayer(room.x + 1, room.y + 1)
    assertTrue(inViewAgrees())
}
