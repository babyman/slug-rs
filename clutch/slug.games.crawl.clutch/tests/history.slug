val game = import("slug.games.crawl")
val empire = import("slug.games.crawl.empire")
val town = import("slug.games.crawl.town")
val level = import("slug.games.crawl.level")
val {assertEqual, assertTrue} = import("slug.test")
val {filter, map, range, reduce, all, any} = import("slug.std")

// The count of squares in `rows` that are `c`.
val count = fn(rows:list, c:str):num {
    reduce(rows, 0, fn(n, row) { n + len(filter(range(len(row)), fn(x) { row[x] == c })) })
}

val inside = fn(walls:map, x:num, y:num):bool {
    x > walls.left && x < walls.right && y > walls.top && y < walls.bottom
}

@test
val aWorldHasNoHistoryUnlessAskedFor = fn() {
    game.newGame(1)
    val e = game.current().world.empire
    assertEqual([e.step, e.chronicle, e.fallen], [0, [], []])
    assertTrue(all(game.current().world.settlements, fn(s) { s.kind != "ruin" }))
}

@test
val historyAgesTheWorldAndSomeSettlementsFall = fn() {
    game.newGame(1, {history: 75})
    val w = game.current().world
    assertEqual(w.empire.step, 300)
    assertEqual(len(w.empire.chronicle), 40)
    val fell = map(w.empire.fallen, fn(f) { f.name })
    assertTrue(len(fell) > 0)
    val ruins = filter(w.settlements, fn(s) { s.kind == "ruin" })
    assertEqual(map(ruins, fn(s) { s.name }), filter(map(w.settlements, fn(s) { s.name }), fn(n) { any(fell, fn(f) { f == n }) }))
    assertTrue(all(ruins, fn(s) { s.was == "town" || s.was == "fort" }))
    // The start town always stands, and new characters start there.
    assertEqual(w.settlements[0].kind, "town")
    game.join("a", "Ann")
    assertEqual([game.playerOf("a").cx, game.playerOf("a").cy], [w.settlements[0].cx, w.settlements[0].cy])
    // The same seed has the same history.
    game.newGame(1, {history: 75})
    assertEqual(game.current().world.empire, w.empire)
}

@test
val aRuinIsEmptyBrokenAndHasAWayDownInside = fn() {
    val s = filter(town.place(1, 32), fn(s) { s.kind == "town" })[1]
    val ground = level.generate(1, s.cx, s.cy, 0, 32)
    val standing = town.build(1, ground, s)
    val ruin = town.build(1, ground, s + {kind: "ruin", was: "town"})
    assertEqual(ruin.place, {kind: "ruin", name: "the ruins of " + s.name})
    assertEqual(ruin.characters, [])
    assertTrue(count(ruin.map, level.HWALL) < count(standing.map, level.HWALL))
    assertEqual(count(ruin.map, level.DOOR), 0)
    assertTrue(inside(ruin.walls, ruin.down.x, ruin.down.y))
    assertEqual(ruin.map[ruin.down.y][ruin.down.x], level.STAIRS)
    assertEqual(count(ruin.map, level.STAIRS), 1)
}

@test
val theDungeonUnderARuinIsRicher = fn() {
    game.newGame(1, {history: 75})
    game.join("a", "Ann")
    val s = filter(game.current().world.settlements, fn(s) { s.kind == "ruin" })[0]
    val key = game.chunkKey(s.cx, s.cy, 0)
    val ruin = town.build(1, level.generate(1, s.cx, s.cy, 0, 32), s)
    val snap = game.snapshot()
    game.load(snap copy {
        levels: snap.levels + {[key]: ruin},
        players: snap.players + {a: snap.players.a copy {cx: s.cx, cy: s.cy, depth: 0, x: ruin.down.x, y: ruin.down.y}},
    })
    game.command("a", "enter", false)
    assertEqual(game.playerOf("a").depth, 1)
    val plain = level.generate(1, s.cx, s.cy, 1, 32)
    assertEqual(len(game.here("a").items), len(plain.items) + 5)
}

// An empire of two factions for telling events.
val told = {
    factions: [{name: "the Redaxe Horde"}, {name: "the Iron Compact of Elmby"}],
    chronicle: [], annals: [],
}

@test
val eventsAreToldInWords = fn() {
    val where = empire.placeName(7, "1,2,1")
    val tell = fn(event:map):str { empire.tell(7, told, {step: 0, at: "1,2,1"} + event) }
    assertEqual(tell({kind: "settled", by: 0}), "The Redaxe Horde settled the land " + where + ".")
    assertEqual(tell({kind: "took", by: 0, against: 1}), "The Redaxe Horde took the land " + where + " from the Iron Compact of Elmby.")
    assertEqual(tell({kind: "repelled", by: 1, against: 0}), "The Iron Compact of Elmby threw back the Redaxe Horde " + where + ".")
    assertEqual(tell({kind: "sacked", by: 0, against: 1, name: "Elmby"}), "The Redaxe Horde sacked Elmby.")
    assertEqual(tell({kind: "held", by: 1, against: 0, name: "Elmby"}), "Elmby held against the Redaxe Horde.")
    assertEqual(tell({kind: "broken", by: 0, against: 1}), "The Redaxe Horde drove the Iron Compact of Elmby from the last of their land, " + where + ".")
    // Sieges, as the annals keep them.
    val siege = {kind: "siege", by: 0, against: 1, name: "Elmby", last: 9}
    assertEqual(tell(siege + {held: 0, fell: true}), "The Redaxe Horde sacked Elmby.")
    assertEqual(tell(siege + {held: 3, fell: true}), "The Redaxe Horde besieged Elmby, which held three times before it fell.")
    assertEqual(tell(siege + {held: 12, fell: false}), "The Redaxe Horde besieged Elmby, which held 12 times.")
    // Events saved as text before they were data are told as they were.
    assertEqual(empire.tell(7, told, {step: 3, text: "the Redaxe Horde sacked Elmby."}), "The Redaxe Horde sacked Elmby.")
    assertEqual(empire.whenOf({step: 125}), "the summer of year 32")
}

@test
val innkeepersTellOfTheGreatEventsOfThePast = fn() {
    val siege = {step: 101, kind: "siege", by: 0, against: 1, at: "1,2,0", name: "Elmby"}
    val news = fn(event:map):str|nil { empire.news(7, told copy {annals: [siege + event]}) }
    assertEqual(news({held: 0, last: 125, fell: true}), "Elmby fell to the Redaxe Horde in the summer of year 32. They say its cellars were never emptied.")
    assertEqual(news({held: 2, last: 125, fell: true}),
        "Elmby fell to the Redaxe Horde in the summer of year 32, after holding out twice since the summer of year 26. They say its cellars were never emptied.")
    assertEqual(news({held: 1, last: 101, fell: false}), "Elmby held against the Redaxe Horde in the summer of year 26. Its walls still bear the marks.")
    assertEqual(news({held: 4, last: 126, fell: false}),
        "Elmby held against the Redaxe Horde four times, from the summer of year 26 to the autumn of year 32. Its walls still bear the marks.")
    val broken = told copy {annals: [{step: 0, kind: "broken", by: 0, against: 1, at: "1,2,1"}]}
    assertEqual(empire.news(7, broken), "In the spring of year 1, the Redaxe Horde drove the Iron Compact of Elmby from the last of their land, "
        + empire.placeName(7, "1,2,1") + ".")
    // Recent news is from the chronicle.
    val recent = told copy {chronicle: [{step: 4, kind: "sacked", by: 0, against: 1, at: "1,2,0", name: "Elmby"}]}
    assertEqual(empire.news(7, recent), "They say the Redaxe Horde sacked Elmby.")
    assertEqual(empire.news(7, told), nil)
}

@test
val theAnnalsKeepTheGreatEventsForGood = fn() {
    game.newGame(1, {history: 75})
    val e = game.current().world.empire
    // The chronicle has only the latest; the annals keep every great event.
    assertTrue(all(e.annals, fn(a) { a.kind == "siege" || a.kind == "broken" }))
    assertTrue(any(e.annals, fn(a) { a.step < e.chronicle[0].step }))
    // Every fall ends a siege; one siege is one entry, however long.
    val fell = filter(e.annals, fn(a) { a.kind == "siege" && a.fell })
    assertTrue(len(fell) > 0)
    assertEqual(map(fell, fn(a) { [a.name, e.factions[a.by].name, a.last] }), map(e.fallen, fn(f) { [f.name, f.by, f.step] }))
    assertTrue(any(e.annals, fn(a) { a.kind == "siege" && a.held > 1 }))
    // A broken faction holds no land.
    assertTrue(all(filter(e.annals, fn(a) { a.kind == "broken" }), fn(a) { !any(keys(e.holds), fn(k) { e.holds[k] == a.against }) }))
}

@test
val seasonsAreStepsFourToAYear = fn() {
    assertEqual([empire.yearOf(0), empire.seasonOf(0)], [1, "spring"])
    assertEqual([empire.yearOf(3), empire.seasonOf(3)], [1, "winter"])
    assertEqual([empire.yearOf(300), empire.seasonOf(300)], [76, "spring"])
    game.newGame(1, {history: 75, empireEvery: 30})
    assertEqual(game.date().text, "Early spring, year 76")
    game.join("a", "Ann")
    val run = fn(n:num) { if (n > 0) { game.tick([], ["a"]); recur(n - 1) } }
    run(10)
    assertEqual(game.date().text, "Spring, year 76")
    run(10)
    assertEqual(game.date().text, "Late spring, year 76")
    run(11)
    assertEqual(game.date().text, "Early summer, year 76")
    assertTrue(any(game.playerOf("a").messages, fn(m) { m == "Summer comes." }))
}
