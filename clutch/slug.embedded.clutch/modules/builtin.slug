/**
 * slug.builtin — the foundation supplied by embedded hosts.
 *
 * cfg, int, and stacktrace are VM builtins. Tasks (`spawn`, `select`, and
 * timers) run on the host's single core, cooperatively; `fork` runs its
 * tasks one at a time there too.
 */

/**
 * Standard error payload shape for idiomatic error handling.
 */
export val Error = struct {
    type:str = "Error",
    msg:str,
    code = nil,
    data = nil,
    cause = nil,
}

/**
 * Writes values to the host's diagnostic output without a trailing newline.
 */
export foreign print = fn(...values):nil

/**
 * Writes values to the host's diagnostic output with a trailing newline.
 */
export foreign println = fn(...values):nil

/**
 * Returns the Unicode scalar, byte, list-element, or map-entry count.
 */
export foreign len = fn(value:str|bytes|list|map):num

/**
 * Returns a map's keys as a new list, in the map's unspecified enumeration
 * order. Each key keeps its value type.
 */
export foreign keys = fn(m:map):list

/**
 * Creates a channel with an optional non-negative buffer capacity.
 *
 * A zero-capacity channel rendezvouses senders and receivers; a positive
 * capacity queues that many values before a sender blocks.
 */
export foreign chan = fn<T>(capacity:num = 0):chan<T>

/**
 * Closes a channel. Closing is idempotent; receivers return `nil` after any
 * values already queued.
 */
export foreign close = fn<T>(channel:chan<T>):nil
