/**
 * slug.time — the board's clock and waiting
 *
 * The embedded `slug.time`. Like the desktop module, it measures time on a
 * clock that never goes back and waits through the scheduler; boards have no
 * wall clock, so there is no `nowMs`.
 */

/**
 * Whole milliseconds since the board started, on the clock that
 * `select { after }` timers wait on. It never goes back.
 */
export foreign monotonicMs = fn():num

/**
 * Waits `milliseconds`, a non-negative whole number, as `select { after }`
 * does: only the calling task waits, and the board's other tasks run.
 */
export val sleepMs = fn(milliseconds:num):nil {
    select { after milliseconds }
    nil
}
