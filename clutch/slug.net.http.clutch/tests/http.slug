val http = import("slug.net.http")
val tcp = import("slug.net.tcp")
val time = import("slug.time")
val {await, send} = import("slug.channel")
val {fromBytes, toBytes} = import("slug.string")
val {assertEqual} = import("slug.test")

val request = fn(method:str, path:str):map {
    {method: method, path: path, query: {}, headers: {}, body: 0x"", params: {}}
}

val routes = http.router([
    ["GET", "/users/me", fn(request) { "me" }],
    ["GET", "/users/:id", fn(request) { "user " + request.params.id }],
    ["DELETE", "/users/:id", fn(request) { "deleted " + request.params.id }],
    ["GET", "/files/*rest", fn(request) { "file " + request.params.rest }],
])

@test
val routesMatchByPatternInOrder = fn() {
    assertEqual(routes(request("GET", "/users/me")), "me")
    assertEqual(routes(request("GET", "/users/7")), "user 7")
    assertEqual(routes(request("HEAD", "/users/7")), "user 7")
    assertEqual(routes(request("DELETE", "/users/7")), "deleted 7")
    assertEqual(routes(request("GET", "/files/a/b")), "file a/b")
    assertEqual(routes(request("GET", "/files/")), "file ")
}

@test
val unmatchedRoutesAre404And405 = fn() {
    assertEqual(routes(request("GET", "/files")), {status: 404})
    assertEqual(routes(request("GET", "/users/")), {status: 404})
    assertEqual(routes(request("PUT", "/users/7")), {status: 405, headers: {Allow: "GET, HEAD, DELETE"}})
}

// Sends `text` to a server for `handler` and returns everything it answers
// before it closes the connection.
val exchange = fn(handler:fn, text:str):str {
    val listener = tcp.listen("127.0.0.1", 0)
    val server = spawn { http.serve(listener, handler, {idleTimeout: 1000}) }
    val client = tcp.connect("127.0.0.1", tcp.localPort(listener))
    tcp.write(client, text)
    val collect = fn(received:bytes):bytes {
        match tcp.read(client, timeout = 5000) {
            nil => received
            data => recur(received + data)
        }
    }
    val answer = fromBytes(collect(0x""))
    tcp.close(client)
    tcp.close(listener)
    await(server)
    answer
}

@test
val servesRequestsOverTcp = fn() {
    val answer = exchange(routes, "GET /users/7 HTTP/1.1\r\nHost: test\r\nConnection: close\r\n\r\n")
    assertEqual(answer, "HTTP/1.1 200 OK\r\nContent-Length: 6\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nuser 7")
}

@test
val rejectsMalformedRequests = fn() {
    val answer = exchange(routes, "GET /users/7 HTTP/1.1\r\n\r\n")
    assertEqual(answer, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
}

@test
val answersAnInvalidResponseWith500 = fn() {
    val answer = exchange(fn(request) { {status: "abc"} }, "GET / HTTP/1.0\r\n\r\n")
    assertEqual(answer, "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
}

@test
val readsFormBodies = fn() {
    val post = fn(type:str, body:bytes):map {
        request("POST", "/") + {headers: {"content-type": type}, body: body}
    }
    assertEqual(http.form(post("application/x-www-form-urlencoded", toBytes("key=a+b&shift=true&&x"))), {key: "a b", shift: "true", x: ""})
    assertEqual(http.form(post("Application/X-WWW-Form-Urlencoded; charset=utf-8", toBytes("q=%C3%A9"))), {q: "é"})
    assertEqual(http.form(post("text/plain", toBytes("key=a"))), {})
    assertEqual(http.form(request("POST", "/")), {})
}

@test
val answersABadFormWith400 = fn() {
    val handler = fn(request) { http.form(request).key ?? "none" }
    val answer = exchange(handler, "POST / HTTP/1.0\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: 6\r\n\r\nkey=%Z")
    assertEqual(answer, "HTTP/1.1 400 Bad Request\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
}

@test
val mediaTypesComeFromExtensions = fn() {
    assertEqual(http.mediaType("htmx.js"), "text/javascript; charset=utf-8")
    assertEqual(http.mediaType("images/Foo.PNG"), "image/png")
    assertEqual(http.mediaType("archive.tar.gz"), "application/octet-stream")
    assertEqual(http.mediaType("README"), "application/octet-stream")
    assertEqual(http.mediaType(".css"), "application/octet-stream")
    assertEqual(http.mediaType("dir.d/file"), "application/octet-stream")
}

@test
val streamsAChannelBodyUntilItCloses = fn() {
    val handler = fn(request) {
        val body = chan(4)
        spawn {
            send(body, "data: one\n\n")
            send(body, toBytes("data: two\n\n"))
            close(body)
        }
        {status: 200, headers: {"Content-Type": "text/event-stream"}, body: body}
    }
    val answer = exchange(handler, "GET /events HTTP/1.1\r\nHost: test\r\n\r\n")
    assertEqual(answer, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nConnection: close\r\n\r\ndata: one\n\ndata: two\n\n")
}

@test
val closesAStreamWhoseClientLeaves = fn() {
    val body = chan(1)
    // Should the server not close the channel, closing it and the listener
    // here ends the stream and the server, so a failure cannot leave the
    // server waiting.
    defer close(body)
    val listener = tcp.listen("127.0.0.1", 0)
    defer tcp.close(listener)
    val server = spawn { http.serve(listener, fn(request) { {status: 200, body: body} }, {idleTimeout: 1000}) }
    val client = tcp.connect("127.0.0.1", tcp.localPort(listener))
    tcp.write(client, "GET / HTTP/1.1\r\nHost: test\r\n\r\n")
    tcp.read(client, timeout = 5000)
    tcp.close(client)
    // Writes to a closed socket fail once the peer's reset arrives, which
    // a loaded machine can delay; keep sending until the server closes the
    // channel, for up to five seconds.
    val deadline = time.monotonicMs() + 5000
    val pump = fn():bool {
        if (time.monotonicMs() > deadline) { return false }
        val sent = fn():bool {
            defer onerror(_) { return false }
            send(body, "tick\n")
            true
        }
        if (sent()) { recur() } else { true }
    }
    assertEqual(pump(), true)
    tcp.close(listener)
    await(server)
}

@test
val answersAHeaderThatWouldSplitTheResponseWith500 = fn() {
    val injected = fn(request) { {status: 200, headers: {Location: "/a\r\nSet-Cookie: stolen=1"}, body: "x"} }
    val answer = exchange(injected, "GET / HTTP/1.0\r\n\r\n")
    assertEqual(answer, "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    val badName = fn(request) { {status: 200, headers: {"X-A: b\r\nX-C": "d"}, body: "x"} }
    assertEqual(exchange(badName, "GET / HTTP/1.0\r\n\r\n"), answer)
}

@test
val servesAtMostMaxConnectionsAtOnce = fn() {
    val listener = tcp.listen("127.0.0.1", 0)
    val server = spawn { http.serve(listener, fn(request) { "ok" }, {idleTimeout: 2000, maxConnections: 1}) }
    val request = "GET / HTTP/1.1\r\nHost: test\r\n\r\n"
    val first = tcp.connect("127.0.0.1", tcp.localPort(listener))
    tcp.write(first, request)
    assertEqual(tcp.read(first, timeout = 5000) == nil, false)
    // The first connection stays open, so the second waits to be accepted.
    val second = tcp.connect("127.0.0.1", tcp.localPort(listener))
    tcp.write(second, request)
    val answeredWithin = fn(connection, ms:num):bool {
        defer onerror(_) { return false }
        tcp.read(connection, timeout = ms) != nil
    }
    assertEqual(answeredWithin(second, 300), false)
    tcp.close(first)
    assertEqual(tcp.read(second, timeout = 5000) == nil, false)
    tcp.close(second)
    tcp.close(listener)
    await(server)
}

@test
val framesABufferedResponseItself = fn() {
    val handler = fn(request) { {status: 200, headers: {"Transfer-Encoding": "chunked", Connection: "keep-alive", "Content-Length": "99"}, body: "x"} }
    val answer = exchange(handler, "GET / HTTP/1.0\r\n\r\n")
    assertEqual(answer, "HTTP/1.1 200 OK\r\nContent-Length: 1\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nx")
}

// --- Request bodies ------------------------------------------------------------

@test
val readsABodyOnlyWhenTheHandlerAsks = fn() {
    val echo = fn(request) { "got " + fromBytes(http.body(request)) }
    val sized = exchange(echo, "POST / HTTP/1.1\r\nHost: t\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello")
    assertEqual(sized, "HTTP/1.1 200 OK\r\nContent-Length: 9\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\ngot hello")
    val chunked = exchange(echo, "POST / HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3\r\nhel\r\n2;x=y\r\nlo\r\n0\r\nTrailer: z\r\n\r\n")
    assertEqual(chunked, "HTTP/1.1 200 OK\r\nContent-Length: 9\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\ngot hello")
}

@test
val refusesADeclaredLengthOverTheLimitBeforeItIsSent = fn() {
    val echo = fn(request) { fromBytes(http.body(request, 4)) }
    // No `100 Continue`: the client never has to send the body.
    val answer = exchange(echo, "POST / HTTP/1.1\r\nHost: t\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\n")
    assertEqual(answer, "HTTP/1.1 413 Content Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
    val streamed = fn(request) {
        val drain = fn(total:num):num {
            match http.read(request, 4) {
                nil => total
                piece => recur(total + len(piece))
            }
        }
        "read ${drain(0)}"
    }
    val chunked = exchange(streamed, "POST / HTTP/1.1\r\nHost: t\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n")
    assertEqual(chunked, "HTTP/1.1 413 Content Too Large\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
}

@test
val continuesOnlyWhenTheHandlerReads = fn() {
    val echo = fn(request) { fromBytes(http.body(request)) }
    val listener = tcp.listen("127.0.0.1", 0)
    val server = spawn { http.serve(listener, echo, {idleTimeout: 1000}) }
    val client = tcp.connect("127.0.0.1", tcp.localPort(listener))
    tcp.write(client, "POST / HTTP/1.1\r\nHost: t\r\nContent-Length: 2\r\nExpect: 100-continue\r\nConnection: close\r\n\r\n")
    assertEqual(fromBytes(tcp.read(client, timeout = 5000) ?? 0x""), "HTTP/1.1 100 Continue\r\n\r\n")
    tcp.write(client, "ok")
    val collect = fn(received:bytes):bytes {
        match tcp.read(client, timeout = 5000) {
            nil => received
            data => recur(received + data)
        }
    }
    assertEqual(fromBytes(collect(0x"")), "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nok")
    tcp.close(client)
    tcp.close(listener)
    await(server)
}

@test
val anUnreadBodyClosesTheConnection = fn() {
    // Two pipelined requests: the first handler ignores its body, so the
    // second is never read and the connection closes after the first.
    val ignore = fn(request) { "ignored" }
    val answer = exchange(ignore, "POST / HTTP/1.1\r\nHost: t\r\nContent-Length: 3\r\n\r\nabcGET / HTTP/1.1\r\nHost: t\r\n\r\n")
    assertEqual(answer, "HTTP/1.1 200 OK\r\nContent-Length: 7\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nignored")
    // Read to its end, it leaves the connection open for the next request.
    val read = fn(request) { "read " + fromBytes(http.body(request)) }
    val both = exchange(read, "POST / HTTP/1.1\r\nHost: t\r\nContent-Length: 3\r\n\r\nabcGET / HTTP/1.1\r\nHost: t\r\nConnection: close\r\n\r\n")
    assertEqual(both, "HTTP/1.1 200 OK\r\nContent-Length: 8\r\nContent-Type: text/plain; charset=utf-8\r\n\r\nread abcHTTP/1.1 200 OK\r\nContent-Length: 5\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\n\r\nread ")
}

@test
val aHandMadeRequestGivesItsBodyField = fn() {
    assertEqual(http.body(request("POST", "/") + {body: toBytes("x=1")}), toBytes("x=1"))
    assertEqual(http.body(request("GET", "/")), 0x"")
}

// --- Multipart forms -------------------------------------------------------------

// A request whose body arrives one byte at a time, so every delimiter is
// split across pieces.
val trickled = fn(type:str, text:str):map {
    val data = toBytes(text)
    var at = 0
    val source = {
        next: fn(maxBytes:num):bytes|nil {
            if (at >= len(data)) { return nil }
            at = at + 1
            data[at - 1:at]
        },
        ended: fn():bool { at >= len(data) },
        maxBodyBytes: 1048576,
    }
    request("POST", "/") + {headers: {"content-type": type}, bodySource: source}
}

val FORM = "preamble\r\n--XyZ\r\nContent-Disposition: form-data; name=\"title\"\r\n\r\nMy \"notes\"\r\n--XyZ\r\nContent-Disposition: form-data; name=\"file\"; filename=\"a;b.txt\"\r\nContent-Type: text/plain\r\n\r\nline one\r\n--Xy not yet\r\n--XyZ--\r\nepilogue"

@test
val readsMultipartFieldsAndFiles = fn() {
    val upload = http.multipart(trickled("multipart/form-data; boundary=XyZ", FORM), 10000)
    val title = upload.next() ?? {}
    assertEqual([title.name, title.filename, title.contentType], ["title", nil, "text/plain"])
    assertEqual(title.text(100), "My \"notes\"")
    val file = upload.next() ?? {}
    assertEqual([file.name, file.filename], ["file", "a;b.txt"])
    val collect = fn(out:bytes):bytes {
        match file.read() {
            nil => out
            piece => recur(out + piece)
        }
    }
    assertEqual(fromBytes(collect(0x"")), "line one\r\n--Xy not yet")
    assertEqual(upload.next(), nil)
    assertEqual(upload.next(), nil)
}

@test
val skipsWhatIsLeftOfAPart = fn() {
    val upload = http.multipart(request("POST", "/") + {headers: {"content-type": "multipart/form-data; boundary=\"XyZ\""}, body: toBytes(FORM)}, 10000)
    val title = upload.next() ?? {}
    val file = upload.next() ?? {}
    assertEqual(file.filename, "a;b.txt")
    // The first part's reader ends once the next part has begun.
    assertEqual(title.read(), nil)
    assertEqual(upload.next(), nil)
}

@test
val refusesWhatIsNotAMultipartForm = fn() {
    val status = fn(work:fn) {
        defer onerror(err) { return err.data.status }
        work()
        nil
    }
    assertEqual(status(fn() { http.multipart(request("POST", "/") + {headers: {"content-type": "text/plain"}}, 100) }), 415)
    assertEqual(status(fn() { http.multipart(request("POST", "/") + {headers: {"content-type": "multipart/form-data"}}, 100) }), 400)
    val truncated = http.multipart(trickled("multipart/form-data; boundary=XyZ", "--XyZ\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nno end"), 1000)
    assertEqual(status(fn() { (truncated.next() ?? {}).text(100) }), 400)
}
