/**
 * slug.net.http — an HTTP/1.1 server
 *
 * `serve(listener, handler, options)` serves HTTP on a `slug.net.tcp`
 * listener, each connection in its own task, calling `handler` with each
 * request for its response. `router(routes)` builds a handler that
 * dispatches by method and path.
 *
 * ```slug
 * val tcp = import("slug.net.tcp")
 * val http = import("slug.net.http")
 *
 * val listener = tcp.listen("127.0.0.1", 8080)
 * http.serve(listener, http.router([
 *     ["GET", "/hello/:name", fn(request) { "hello " + request.params.name }],
 * ]))
 * ```
 *
 * A request is a map of `method`, `path` (percent-decoded), `query` (a map
 * of decoded parameters), `headers` (a map from lowercased name to value,
 * repeated headers joined with ", "), `body` (bytes), and `params` (what
 * `router` matched); `form(request)` decodes a form body's fields, and
 * `mediaType(name)` gives a file name's media type from its extension. A
 * response is a string, sent as a `200` text body, or a map of `status`, and
 * optionally `headers` and `body` (a string or bytes). The server adds
 * `Content-Length`, a default `Content-Type`, and `Connection: close` when it
 * closes the connection.
 *
 * A body can also be a channel of strings or bytes, for a response that
 * arrives over time, such as server-sent events: the server writes each
 * value as it is received, and ends the response and closes the connection
 * when the channel is closed. When the client goes away, the server closes
 * the channel, so the next send to it fails. A handler that throws, or returns something that is
 * not a response, is answered with `500`, except that an `http.reject` error,
 * such as `form`'s for a body that does not decode, is answered with its
 * status.
 *
 * The server reads requests as RFC 9112 describes: it decodes chunked
 * bodies, answers `Expect: 100-continue`, keeps HTTP/1.1 connections open
 * and answers pipelined requests in order, and rejects malformed requests
 * with `400`, `408`, `413`, `414`, `431`, `501`, or `505`, then closes the
 * connection.
 */

val tcp = import("slug.net.tcp")
val {split, trim, lower, join, chars, ord, toInt, toBytes, fromBytes} = import("slug.string")
val {send, recv} = import("slug.channel")

// --- Protocol errors ---------------------------------------------------------

// Ends the request with a `status` response, after which the connection
// closes.
val reject = fn(status:num) {
    throw Error {type: "http.reject", msg: "the request is rejected", data: {status: status}}
}

// Ends the connection without a response: the client went away, or stayed
// idle too long.
val gone = fn() {
    throw Error {type: "http.closed", msg: "the connection is closed"}
}

// --- Text ----------------------------------------------------------------------

val tokenCharacters = chars("!#$%&'*+-.^_`|~")

// Whether `text` is a token: a method or header name.
val isToken = fn(text:str):bool {
    val ok = fn(c:str):bool {
        (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || (c >= "0" && c <= "9")
            || contains(tokenCharacters, c)
    }
    val go = fn(i:num):bool { if (i == len(text)) { true } else if (ok(text[i])) { recur(i + 1) } else { false } }
    len(text) > 0 && go(0)
}

val contains = fn(values:list, value):bool {
    val go = fn(i:num):bool { if (i == len(values)) { false } else if (values[i] == value) { true } else { recur(i + 1) } }
    go(0)
}

val isDigits = fn(text:str):bool {
    val go = fn(i:num):bool { if (i == len(text)) { true } else if (text[i] >= "0" && text[i] <= "9") { recur(i + 1) } else { false } }
    len(text) > 0 && go(0)
}

// The value of a hexadecimal digit, or -1.
val hexDigit = fn(c:str):num {
    val code = ord(lower(c))
    if (code >= 48 && code <= 57) { code - 48 } else if (code >= 97 && code <= 102) { code - 87 } else { -1 }
}

// `text` percent-decoded, with `+` as a space when `plus` is true, as UTF-8.
val decode = fn(text:str, plus:bool = false):str {
    val data = toBytes(text)
    val go = fn(i:num, out:bytes):bytes {
        if (i == len(data)) { return out }
        if (data[i] == 37) {
            if (i + 2 >= len(data)) { reject(400) }
            val high = hexDigit(fromBytes(data[i + 1:i + 2]))
            val low = hexDigit(fromBytes(data[i + 2:i + 3]))
            if (high < 0 || low < 0) { reject(400) }
            recur(i + 3, out :+ (high * 16 + low))
        } else {
            recur(i + 1, out :+ (if (plus && data[i] == 43) { 32 } else { data[i] }))
        }
    }
    utf8(go(0, 0x""))
}

// `data` as text; bytes that are not UTF-8 are a bad request.
val utf8 = fn(data:bytes):str {
    defer onerror(_) { reject(400) }
    fromBytes(data)
}

// --- Reading -----------------------------------------------------------------

// Reads a connection's bytes as lines and body bytes. While a request's header
// section is being read, its deadline applies: `startHead` starts it and
// `endHead` cancels it. Reading the next request waits at most `idleTimeout`
// for its first bytes, and a body waits as long for each piece.
val reader = fn(connection:tcp.Connection, options:map):map {
    val idleTimeout = options.idleTimeout ?? 5000
    val headerTimeout = options.headerTimeout ?? 5000
    var buffer = 0x""
    var expired:chan<num>|nil = nil
    var cancelled:chan<num>|nil = nil
    // Bytes taken as lines since the request began, line endings included.
    var lineBytes = 0

    // Appends the next bytes the client sends, or ends the request when it
    // goes away or a deadline passes.
    val fill = fn() {
        val deadline = expired
        val chunk = if (deadline != nil) {
            select {
                recv tcp.chunks(connection) /> fn(value) { value }
                recv deadline /> fn(_) { reject(408) }
            }
        } else {
            select {
                recv tcp.chunks(connection) /> fn(value) { value }
                after idleTimeout /> fn(_) { gone() }
            }
        }
        match chunk {
            data:bytes => { buffer = buffer + data }
            _ => gone()
        }
    }

    // Takes the next line, without its line ending, failing with `status`
    // when it is longer than `limit`. A bare CR is a bad request.
    val line = fn(limit:num, status:num):str {
        val find = fn(i:num):num {
            if (i >= len(buffer)) { return -1 }
            if (buffer[i] == 10) { return i }
            if (buffer[i] == 13 && i + 1 < len(buffer) && buffer[i + 1] != 10) { reject(400) }
            recur(i + 1)
        }
        val end = find(0)
        if (end < 0) {
            if (len(buffer) > limit) { reject(status) }
            fill()
            return recur(limit, status)
        }
        if (end + 1 > limit) { reject(status) }
        val text = if (end > 0 && buffer[end - 1] == 13) { buffer[0:end - 1] } else { buffer[0:end] }
        buffer = buffer[end + 1:]
        lineBytes = lineBytes + end + 1
        utf8(text)
    }

    // The bytes taken as lines since the request began, or since `restart`.
    val taken = fn():num { lineBytes }
    val restart = fn() { lineBytes = 0 }

    // Takes the next `count` bytes.
    val take = fn(count:num):bytes {
        if (len(buffer) < count) {
            fill()
            return recur(count)
        }
        val data = buffer[0:count]
        buffer = buffer[count:]
        data
    }

    // Waits for the first bytes of the next request, which a pipelining
    // client may already have sent.
    val awaitRequest = fn() {
        if (len(buffer) == 0) { fill() }
    }

    val startHead = fn() {
        lineBytes = 0
        val fired:chan<num> = chan(1)
        val cancel:chan<num> = chan(1)
        expired = fired
        cancelled = cancel
        spawn {
            select {
                recv cancel /> fn(_) { nil }
                after headerTimeout /> fn(_) { send(fired, 1) }
            }
        }
    }

    val endHead = fn() {
        val cancel = cancelled
        if (cancel != nil) { close(cancel) }
        expired = nil
        cancelled = nil
    }

    {
        line: line,
        take: take,
        taken: taken,
        restart: restart,
        awaitRequest: awaitRequest,
        startHead: startHead,
        endHead: endHead,
    }
}

// Splits a header line into its lowercased name and trimmed value.
val headerField = fn(line:str):[str, str] {
    val parts = split(line, ":")
    val name = parts[0]
    if (len(parts) < 2 || !isToken(name)) { reject(400) }
    [lower(name), trim(join(parts[1:], ":"))]
}

// Reads the request line and header section, which together may take at
// most `maxHeaderBytes`: the request's method, target, version, and headers.
val readHead = fn(input:map, maxHeaderBytes:num):map {
    // Empty lines before the request line are ignored, and not counted.
    val requestLine = fn():str {
        val text = input.line(maxHeaderBytes, 414)
        if (text == "") {
            input.restart()
            recur()
        } else {
            text
        }
    }
    val first = requestLine()
    val parts = split(first, " ")
    if (len(parts) != 3 || !isToken(parts[0])) { reject(400) }
    val target = parts[1]
    val version = parts[2]
    if (len(target) == 0 || target[0] != "/") { reject(400) }
    if (version != "HTTP/1.1" && version != "HTTP/1.0") {
        val shaped = len(version) == 8 && version[0:5] == "HTTP/" && isDigits(version[5])
            && version[6] == "." && isDigits(version[7])
        reject(if (shaped) { 505 } else { 400 })
    }
    val readFields = fn(headers:map):map {
        val text = input.line(maxHeaderBytes - input.taken(), 431)
        if (text == "") { return headers }
        // A line continuing the one before is obsolete folding.
        if (text[0] == " " || text[0] == "\t") { reject(400) }
        val field = headerField(text)
        val name = field[0]
        val value = match headers[name] {
            nil => field[1]
            earlier => earlier + ", " + field[1]
        }
        recur(headers + {[name]: value})
    }
    val headers = readFields({})
    if (version == "HTTP/1.1" && headers.host == nil) { reject(400) }
    {method: parts[0], target: target, version: version, headers: headers}
}

// The body's length from `Content-Length`, which may repeat when every
// value is equal; 0 without one.
val contentLength = fn(value:str|nil, maxBodyBytes:num):num {
    if (value == nil) { return 0 }
    val lengths = split(value ?? "", ",")
    val first = trim(lengths[0])
    val check = fn(i:num) {
        if (i < len(lengths)) {
            if (trim(lengths[i]) != first) { reject(400) }
            recur(i + 1)
        }
    }
    check(1)
    if (!isDigits(first)) { reject(400) }
    // Too many digits for an integer is too large a body.
    toInt(first) ?? (maxBodyBytes + 1)
}

// Reads a chunked body, discarding any trailer fields.
val readChunked = fn(input:map, maxHeaderBytes:num, maxBodyBytes:num):bytes {
    val readChunks = fn(body:bytes):bytes {
        val sizeText = trim(split(input.line(maxHeaderBytes, 400), ";")[0])
        if (sizeText == "" || len(sizeText) > 15) { reject(400) }
        val parse = fn(i:num, size:num):num {
            if (i == len(sizeText)) { return size }
            val digit = hexDigit(sizeText[i])
            if (digit < 0) { reject(400) }
            recur(i + 1, size * 16 + digit)
        }
        val size = parse(0, 0)
        if (size == 0) {
            val trailers = fn() {
                val text = input.line(maxHeaderBytes, 400)
                if (text != "") {
                    headerField(text)
                    recur()
                }
            }
            trailers()
            return body
        }
        if (len(body) + size > maxBodyBytes) { reject(413) }
        val data = input.take(size)
        // The chunk's data ends with its own line ending.
        if (input.line(2, 400) != "") { reject(400) }
        recur(body + data)
    }
    readChunks(0x"")
}

// The decoded parameters of `text`, a query string or form body: `+` is a
// space, a parameter without `=` is "", empty parameters are skipped, and
// when a name repeats the last value wins.
val parseParameters = fn(text:str):map {
    val parameters = split(text, "&")
    val readParameters = fn(i:num, out:map):map {
        if (i == len(parameters)) { return out }
        if (parameters[i] == "") { return recur(i + 1, out) }
        val pair = split(parameters[i], "=")
        val value = if (len(pair) > 1) { join(pair[1:], "=") } else { "" }
        recur(i + 1, out + {[decode(pair[0], true)]: decode(value, true)})
    }
    readParameters(0, {})
}

// The target's decoded path and its query parameters.
val parseTarget = fn(target:str):[str, map] {
    val parts = split(target, "?")
    val query = if (len(parts) > 1) { join(parts[1:], "?") } else { "" }
    [decode(parts[0]), parseParameters(query)]
}

// Reads one request: the request map and whether the connection closes after
// its response.
val readRequest = fn(connection:tcp.Connection, input:map, options:map):[map, bool] {
    val maxHeaderBytes = options.maxHeaderBytes ?? 8192
    val maxBodyBytes = options.maxBodyBytes ?? 1048576
    input.startHead()
    val head = readHead(input, maxHeaderBytes)
    input.endHead()
    val headers = head.headers
    val coding = headers["transfer-encoding"]
    if (coding != nil && headers["content-length"] != nil) { reject(400) }
    val length = contentLength(headers["content-length"], maxBodyBytes)
    if (length > maxBodyBytes) { reject(413) }
    if (coding != nil && lower(trim(coding ?? "")) != "chunked") { reject(501) }
    if (lower(headers.expect ?? "") == "100-continue" && (length > 0 || coding != nil)) {
        tcp.write(connection, "HTTP/1.1 100 Continue\r\n\r\n")
    }
    val body = if (coding != nil) {
        readChunked(input, maxHeaderBytes, maxBodyBytes)
    } else {
        input.take(length)
    }
    val [path, query] = parseTarget(head.target)
    val tokens = split(lower(headers.connection ?? ""), ",")
    val closing = head.version == "HTTP/1.0" || contains(mapList(tokens, trim), "close")
    val request = {method: head.method, path: path, query: query, headers: headers, body: body, params: {}}
    [request, closing]
}

val mapList = fn(values:list, f:fn):list {
    val go = fn(i:num, out:list):list { if (i == len(values)) { out } else { recur(i + 1, out :+ f(values[i])) } }
    go(0, [])
}

// --- Writing -----------------------------------------------------------------

val reason = fn(status:num):str {
    match status {
        200 => "OK"
        201 => "Created"
        204 => "No Content"
        301 => "Moved Permanently"
        302 => "Found"
        304 => "Not Modified"
        400 => "Bad Request"
        404 => "Not Found"
        405 => "Method Not Allowed"
        408 => "Request Timeout"
        413 => "Content Too Large"
        414 => "URI Too Long"
        431 => "Request Header Fields Too Large"
        500 => "Internal Server Error"
        501 => "Not Implemented"
        505 => "HTTP Version Not Supported"
        _ => "Unknown"
    }
}

// A handler's result as a response map, or a `500` when it is not a valid
// response.
val normalize = fn(response):map {
    val valid = match response {
        _:str => true
        {status: status} => match status {
            code:num => int(code) == code && code >= 200 && code <= 599
            _ => false
        }
        _ => false
    }
    if (!valid) { return {status: 500} }
    val result = match response {
        text:str => {status: 200, body: text}
        given:map => given
        _ => {status: 500}
    }
    match result.body {
        nil => result
        _:str => result
        _:bytes => result
        _:chan => result
        _ => {status: 500}
    }
}

// Writes each value received from `channel` until it is closed, then
// returns; when a write fails because the client went away, closes the
// channel first.
val stream = fn(connection:tcp.Connection, channel:chan) {
    defer onerror(_) {
        close(channel)
        return nil
    }
    val next = fn() {
        match recv(channel) {
            nil => nil
            text:str => { tcp.write(connection, text); recur() }
            data:bytes => { tcp.write(connection, data); recur() }
            _ => recur()
        }
    }
    next()
}

// Writes `response`; `head` sends no body, as for `HEAD`. Returns whether
// the connection must close: when `closing`, or after a streamed body.
val respond = fn(connection:tcp.Connection, response, head:bool, closing:bool):bool {
    val result = normalize(response)
    match result.body {
        channel:chan => {
            streamed(connection, result, channel, head)
            return true
        }
        _ => nil
    }
    val status = result.status
    val body = result.body ?? ""
    val data = match body {
        text:str => toBytes(text)
        bytes:bytes => bytes
        _ => 0x""
    }
    val bodiless = status == 204 || status == 304
    val headers = result.headers ?? {}
    val keysGiven = keys(headers)
    val writeHeaders = fn(i:num, out:str, seen:list):[str, list] {
        if (i == len(keysGiven)) { return [out, seen] }
        val given = keysGiven[i]
        val name = "$given"
        val key = lower(name)
        if (key == "content-length" || (bodiless && key == "content-type")) {
            return recur(i + 1, out, seen)
        }
        val value = headers[given]
        recur(i + 1, out + name + ": " + "$value" + "\r\n", seen :+ key)
    }
    val [written, seen] = writeHeaders(0, "HTTP/1.1 $status " + reason(status) + "\r\n", [])
    var text = written
    if (!bodiless) {
        val length = len(data)
        text = text + "Content-Length: $length\r\n"
        if (length > 0 && !contains(seen, "content-type")) {
            val kind = match body {
                _:str => "text/plain; charset=utf-8"
                _ => "application/octet-stream"
            }
            text = text + "Content-Type: " + kind + "\r\n"
        }
    }
    if (closing && !contains(seen, "connection")) { text = text + "Connection: close\r\n" }
    tcp.write(connection, text + "\r\n")
    if (!head && !bodiless && len(data) > 0) { tcp.write(connection, data) }
    closing
}

// Writes a response whose body is `channel`: its head, with no length, so
// the body runs until the connection closes, then the stream.
val streamed = fn(connection:tcp.Connection, result:map, channel:chan, head:bool) {
    val headers = result.headers ?? {}
    val keysGiven = keys(headers)
    val writeHeaders = fn(i:num, out:str):str {
        if (i == len(keysGiven)) { return out }
        val given = keysGiven[i]
        val name = "$given"
        val key = lower(name)
        if (key == "content-length" || key == "connection" || key == "transfer-encoding") { return recur(i + 1, out) }
        val value = headers[given]
        recur(i + 1, out + name + ": " + "$value" + "\r\n")
    }
    val status = result.status
    val top = writeHeaders(0, "HTTP/1.1 $status " + reason(status) + "\r\n")
    tcp.write(connection, top + "Connection: close\r\n\r\n")
    if (head) { close(channel) } else { stream(connection, channel) }
}

// Calls `handler`; an `http.reject` throw is answered with its status, and
// any other throw with `500`.
val invoke = fn(handler:fn, request:map) {
    defer onerror(error) {
        return match error {
            {type: "http.reject", data: data} => {status: data.status}
            _ => {status: 500}
        }
    }
    handler(request)
}

// --- Serving -----------------------------------------------------------------

// Serves one connection's requests, in order, until it closes.
val serveConnection = fn(connection:tcp.Connection, handler:fn, options:map) {
    defer tcp.close(connection)
    defer onerror(_) { return nil }
    val input = reader(connection, options)
    val next = fn() {
        val outcome = handleNext(connection, input, handler, options)
        if (outcome == "open") { recur() }
    }
    next()
}

// Reads and answers the next request: "open" to read another, or "closed".
val handleNext = fn(connection:tcp.Connection, input:map, handler:fn, options:map):str {
    defer onerror(error) {
        match error {
            {type: "http.reject", data: data} => respond(connection, {status: data.status}, false, true)
            _ => nil
        }
        return "closed"
    }
    input.awaitRequest()
    val [request, closing] = readRequest(connection, input, options)
    val closed = respond(connection, invoke(handler, request), request.method == "HEAD", closing)
    if (closed) { "closed" } else { "open" }
}

/**
 * Serves HTTP on `listener`, a listening `slug.net.tcp` listener, until it is
 * closed, each connection in its own task, calling `handler` with each
 * request for its response. `options` may set:
 *
 * - `idleTimeout`, 5000: milliseconds a connection may wait for its next
 *   request, or for each piece of a body, before the server closes it;
 * - `headerTimeout`, 5000: milliseconds from a request's first byte until its
 *   header section is complete, before the server answers `408`;
 * - `maxHeaderBytes`, 8192: the largest request line and header section;
 * - `maxBodyBytes`, 1048576: the largest body, after chunked decoding.
 */
export val serve = fn(listener:tcp.Listener, handler:fn, options:map = {}) {
    val accept = fn() {
        match tcp.accept(listener) {
            nil => nil
            connection => {
                spawn { serveConnection(connection, handler, options) }
                recur()
            }
        }
    }
    accept()
}

// --- Forms -------------------------------------------------------------------

/**
 * The fields of `request`'s form body, decoded as its `query` is, when its
 * `Content-Type` is `application/x-www-form-urlencoded`; `{}` otherwise. A
 * body that does not decode is answered with `400`.
 */
export val form = fn(request:map):map {
    val type = lower(request.headers["content-type"] ?? "")
    if (trim(split(type, ";")[0]) != "application/x-www-form-urlencoded") { return {} }
    parseParameters(utf8(request.body))
}

// --- Media types -------------------------------------------------------------

val TEXT = "; charset=utf-8"

val MEDIA_TYPES = {
    html: "text/html" + TEXT, htm: "text/html" + TEXT, css: "text/css" + TEXT,
    js: "text/javascript" + TEXT, mjs: "text/javascript" + TEXT, txt: "text/plain" + TEXT,
    csv: "text/csv" + TEXT, md: "text/markdown" + TEXT, xml: "application/xml",
    json: "application/json", wasm: "application/wasm", pdf: "application/pdf",
    svg: "image/svg+xml", png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg",
    gif: "image/gif", webp: "image/webp", avif: "image/avif", ico: "image/x-icon",
    woff: "font/woff", woff2: "font/woff2", ttf: "font/ttf", otf: "font/otf",
    mp3: "audio/mpeg", ogg: "audio/ogg", wav: "audio/wav", mp4: "video/mp4", webm: "video/webm",
}

/**
 * The media type for a file named `name`, such as an asset's name, from its
 * extension, case ignored: `"htmx.js"` is `text/javascript; charset=utf-8`
 * and `"images/foo.png"` is `image/png`. A name with no extension, or one
 * not in the table, is `application/octet-stream`.
 */
export val mediaType = fn(name:str):str {
    val file = split(name, "/")
    val parts = split(file[len(file) - 1], ".")
    if (len(parts) < 2 || (parts[0] == "" && len(parts) == 2)) { return "application/octet-stream" }
    MEDIA_TYPES[lower(parts[len(parts) - 1])] ?? "application/octet-stream"
}

// --- Routing -----------------------------------------------------------------

// The params `pattern` matches `path` with, or nil. Segments are what lies
// between `/`s: `:name` matches one non-empty segment, and a final `*name`
// the remaining segments, one or more, joined with `/`.
val matchPath = fn(pattern:list<str>, path:list<str>):map|nil {
    val go = fn(i:num, params:map):map|nil {
        if (i == len(pattern)) {
            return if (i == len(path)) { params } else { nil }
        }
        if (i >= len(path)) { return nil }
        val segment = pattern[i]
        if (len(segment) > 1 && segment[0] == "*" && i == len(pattern) - 1) {
            return params + {[segment[1:]]: join(path[i:], "/")}
        }
        if (len(segment) > 1 && segment[0] == ":") {
            return if (path[i] == "") { nil } else { recur(i + 1, params + {[segment[1:]]: path[i]}) }
        }
        if (segment == path[i]) { recur(i + 1, params) } else { nil }
    }
    go(0, {})
}

/**
 * A handler that dispatches by method and path to `routes`, a list of
 * `[method, pattern, handler]` entries, setting the request's `params` from
 * the pattern: `/users/:id` matches `/users/7` with `{id: "7"}`, and
 * `/files/*rest` matches `/files/a/b` with `{rest: "a/b"}`.
 *
 * The first route whose pattern and method match handles the request, and a
 * `GET` route also handles `HEAD`. When a pattern matches but no method does,
 * the response is `405` with an `Allow` header; when no pattern matches, it
 * is `404`.
 */
export val router = fn(routes:list):fn {
    val compiled = mapList(routes, fn(route) { [route[0], split(route[1], "/"), route[2]] })
    fn(request:map) {
        val path = split(request.path, "/")
        val find = fn(i:num, allowed:list<str>) {
            if (i == len(compiled)) {
                if (len(allowed) == 0) { return {status: 404} }
                return {status: 405, headers: {Allow: join(allowed, ", ")}}
            }
            val [method, pattern, handler] = compiled[i]
            match matchPath(pattern, path) {
                nil => recur(i + 1, allowed)
                params => {
                    if (method == request.method || (method == "GET" && request.method == "HEAD")) {
                        return handler(request + {params: params})
                    }
                    val add = fn(names:list<str>, name:str):list<str> {
                        if (contains(names, name)) { names } else { names :+ name }
                    }
                    val withMethod = add(allowed, method)
                    recur(i + 1, if (method == "GET") { add(withMethod, "HEAD") } else { withMethod })
                }
            }
        }
        find(0, [])
    }
}
